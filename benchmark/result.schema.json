{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yui paper-scale comparison record",
  "type": "object",
  "required": ["version", "case_id", "arm", "repetition", "model", "inputs", "configuration", "outcome", "execution_health", "wall_seconds", "phases", "usage", "evidence"],
  "properties": {
    "version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "arm": {"enum": ["direct", "yui-sequential", "yui-parallel"]},
    "repetition": {"type": "integer", "minimum": 1},
    "model": {
      "type": "object",
      "required": ["requested", "actual", "reasoning_effort", "speed_requested", "service_tier_observed"],
      "properties": {
        "requested": {"const": "gpt-6-luna"},
        "actual": {"type": ["string", "null"]},
        "reasoning_effort": {"const": "high"},
        "speed_requested": {"const": "standard"},
        "service_tier_observed": {"type": ["string", "null"]}
      }
    },
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/binding"}, "minItems": 1},
    "configuration": {
      "type": "object",
      "required": ["harness_commit", "carrier_version", "toolchain", "prompts", "stage_budget_seconds", "case_budget_seconds", "concurrency_requested", "concurrency_resolved", "concurrency_observed", "initial_reuse_state", "comparison_scope"],
      "properties": {
        "harness_commit": {"type": "string"},
        "carrier_version": {"type": "string"},
        "toolchain": {"type": "object"},
        "prompts": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "stage_budget_seconds": {"type": "number", "exclusiveMinimum": 0},
        "case_budget_seconds": {"type": ["number", "null"]},
        "concurrency_requested": {"type": ["string", "integer"]},
        "concurrency_resolved": {"type": "integer", "minimum": 1},
        "concurrency_observed": {"type": "integer", "minimum": 0},
        "initial_reuse_state": {"type": "object"},
        "comparison_scope": {"enum": ["original-proof-end-to-end", "fixed-NL0-translation-only"]}
      }
    },
    "outcome": {"enum": ["NOT_RUN", "PASSED", "MATHEMATICAL_REJECTION", "MODEL_BUDGET_EXHAUSTED", "UNFINISHED_WITH_EXECUTION_FAULT", "EXTERNAL_EARLY_STOP", "UNVERIFIED"]},
    "execution_health": {"enum": ["NO_RECORDED_FAULT", "FAULT", "UNVERIFIED", "NOT_RUN"]},
    "wall_seconds": {"type": ["number", "null"], "minimum": 0},
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "wall_seconds", "model_work_seconds", "queue_seconds", "tool_seconds", "usage"],
        "properties": {
          "name": {"type": "string"},
          "wall_seconds": {"type": ["number", "null"]},
          "model_work_seconds": {"type": ["number", "null"]},
          "queue_seconds": {"type": ["number", "null"]},
          "tool_seconds": {"type": ["number", "null"]},
          "usage": {"$ref": "#/$defs/usage"}
        }
      }
    },
    "usage": {"$ref": "#/$defs/usage"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "acceptance": {"type": "object"},
    "qualifications": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "binding": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "usage": {
      "type": "object",
      "required": ["status", "coverage", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens"],
      "properties": {
        "status": {"enum": ["COMPLETE", "PARTIAL", "NOT_RECORDED"]},
        "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
