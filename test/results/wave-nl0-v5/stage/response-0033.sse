SmELF9uNpx9eeVV8Mtnuwea2VD8sgulwEFLO65xPap3MeGI_y_5PtQq6TXkEpkIJ6xk3W_lMxB6zI7m7AtquZh0eeTGN-9I-urVFr4tI-qgGNsKW-TpII1KIF9BlZnik_v5xQGg_dbivF7O_0cmE63q_EtCGcMr96R9gi4Xd-TXflzOM2f6i-a9SCm3C51rvXq6pXWvtD8ZDe2woZt28FEXnOX4XCeIeLTRLBD_eJyXIcuN2AZiLFykYru2snWptNN2TJrWPvg_JQZrRqD__5oM_bIG6jTqVvvHaFK4HiynnxtRznVEhWZzgLGTLNmUMijLSKZoh7Iosr7dfWKVo4IqeJ6fbXHLc8inAQGQKz0RWCMxvZk7X49nDcHyN6HXdx6reK7dKq7-wXQ9n19ww2C5DL0-IxVay_4mTrV2Ng3AA6pSBkgw0vxvuhBSmpQ66mR9m3SJ1LpJDNC3qJBcBj1j7U1_OiVflmbmXJGyfxlZ69u7CA7rQ7_OMgqjwqi1J6mXP9QjAFnfHqLrVJIRF6SBS6AlxoWTo_iAymXz_MnapM4qn7ZP4EkcVFZvXkMdDQSLCuEzheHbcluNXLokY8Rq76zB51ovmBHx_ToOw8-YvNqxkBHR04DxQoTMu8QJptj0Cxfnr2Q-e7oc6qZQT_zszsGlur-WHRCQTheiU7We_DDlD8b_KsmOgvf7REX3v_IzPKBwOEqOT6018Mdk3v2q0_knw4JU6_unFW8a3knCJ_ToxBpDBx1qWjh0T91SRu6zckWxTkJ2uqrHQ8y-aflOP5mcklyhOapYnCk5sxrA-7-oEsqfeDL8TEasPd38NgUdcvTFLm9UFuqTPWkvxt0N8YDCdDk9s6s_aqsxhY6DA1YF2EMgAK0Fm_1AOqOS45j4z1vgpKG6DTR2Kwl_dD2PRiNwNeHcZ_Zr8="},{"type":"function_call","id":"fc_0747305348427987016adb24192b008191913bf631b6f79fc9","call_id":"call_36b725c6c9e648a9baaa14ff771eae87","name":"submit_artifact","arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"full_target\\\":\\\"Let n,m be positive integers; u:R^n×(0,∞)→R^m jointly smooth and q∈R^m have Euclidean norm one. Assume |u(x,r)|=1; for each (x,r) there is a∈R such that u_tt−Δ_xu=a u; and on each compact interval J⊂(0,∞), u(x,r)=q outside a compact C_J uniformly for r∈J. Define e(x,r)=|u_t|²+Σ_{j=1}^n|∂_{x_j}u|² and E(r)=∫_{R^n}e(x,r)dx, Lebesgue measure, Euclidean norms. Prove e(·,r) is Lebesgue integrable for each r>0, E is differentiable for each r>0, and E'(r)=0.\\\",\\\"conclusion\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"m\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"jointly smooth map R^n×(0,∞)→R^m\\\"},{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"unit vector in R^m\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"origin\\\":\\\"frozen-target.md:7-10\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt(x,r)-Δ_xu(x,r)=a u(x,r), with componentwise Δ_x.\\\",\\\"origin\\\":\\\"frozen-target.md:11-13\\\"},{\\\"id\\\":\\\"H003\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), there is compact C_J⊂R^n such that u(x,r)=q for x∉C_J and r∈J.\\\",\\\"origin\\\":\\\"frozen-target.md:14-16\\\"}],\\\"definitions\\\":[{\\\"id\\\":\\\"D001\\\",\\\"symbol\\\":\\\"e\\\",\\\"type\\\":\\\"R^n×(0,∞)→R\\\",\\\"definition\\\":\\\"e(x,r)=|u_t(x,r)|²+Σ_{j=1}^n|∂_{x_j}u(x,r)|²\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"R^n\\\"},{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]},{\\\"id\\\":\\\"D002\\\",\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"(0,∞)→R\\\",\\\"definition\\\":\\\"E(r)=Lebesgue integral over R^n of e(x,r)\\\",\\\"depends_on\\\":[\\\"D001\\\"],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"e\\\"]},{\\\"id\\\":\\\"D003\\\",\\\"symbol\\\":\\\"Δ_x\\\",\\\"type\\\":\\\"operator on smooth R^m-valued maps\\\",\\\"definition\\\":\\\"Δ_xu=Σ_{j=1}^n∂²_{x_j}u, componentwise\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]}],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\",\\\"contradiction_classical\\\"],\\\"calculations\\\":[\\\"Finite-dimensional inner-product, product-rule and finite-sum differentiation identities only; analytic integration and compactness results are used only through the explicitly registered Mathlib propositions.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"real numbers\\\",\\\"meaning\\\":\\\"Real field, topology and Lebesgue measure.\\\"},{\\\"symbol\\\":\\\"R^k\\\",\\\"type\\\":\\\"Euclidean space\\\",\\\"meaning\\\":\\\"Euclidean space with inner product and Lebesgue measure.\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt(x,r)-Δ_xu(x,r)=a u(x,r), with componentwise Δ_x.\\\",\\\"definitions\\\":[\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"Δ_x\\\"]},{\\\"id\\\":\\\"H003\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), there is compact C_J⊂R^n such that u(x,r)=q for x∉C_J and r∈J.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"q\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For any measurable space X with topology such that open sets are measurable, normed additive commutative group E, measure μ finite on compact sets, and continuous f:X→E with compact support, f is integrable with respect to μ.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"X\\\",\\\"E\\\",\\\"μ\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"Continuous.integrable_of_hasCompactSupport\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Function.LocallyIntegrable\\\",\\\"statement\\\":\\\"If X is a measurable topological space with opens measurable, E a normed additive commutative group, μ a measure finite on compact sets, and f:X→E is continuous and has compact support, then f is integrable with respect to μ.\\\",\\\"hypotheses\\\":[\\\"X has measurable space and topological space; opens are measurable.\\\",\\\"E is a normed additive commutative group.\\\",\\\"μ is finite on compact sets.\\\",\\\"f:X→E is continuous.\\\",\\\"f has compact support.\\\"],\\\"evidence\\\":[]}},{\\\"id\\\":\\\"M002\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For a real interval with endpoints a,b and a complete real normed vector space E, if f has derivative f′ at every point of the closed interval between a and b and f′ is interval-integrable between a and b, then the interval integral of f′ equals f(b)−f(a).\\\", \\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"a\\\",\\\"b\\\",\\\"E\\\",\\\"f\\\",\\\"f′\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"intervalIntegral.integral_eq_sub_of_hasDerivAt\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus\\\",\\\"statement\\\":\\\"For a complete real normed vector space E, real a,b, and functions f,f′:ℝ→E, if for every x in uIcc a b, f has derivative f′ x at x and f′ is interval-integrable on [a,b], then ∫ x in a..b, f′ x = f b - f a.\\\",\\\"hypotheses\\\":[\\\"E is a complete real normed vector space.\\\",\\\"For all x∈uIcc(a,b), HasDerivAt f (f′ x) x.\\\",\\\"f′ is interval-integrable on the interval from a to b.\\\"],\\\"evidence\\\":[]}},{\\\"id\\\":\\\"M003\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For measurable spaces α,β with S-finite measures μ,ν and a real normed space E, if f:α×β→E is integrable for the product measure μ×ν, then its product integral equals the iterated integral, integrating first in β and then in α.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"α\\\",\\\"β\\\",\\\"μ\\\",\\\"ν\\\",\\\"E\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"MeasureTheory.integral_prod\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.Prod\\\",\\\"statement\\\":\\\"If μ and ν are S-finite measures on measurable spaces α and β and E is a real normed space, then for integrable f:α×β→E, ∫ f d(μ×ν)=∫ x, ∫ y, f(x,y) dν dμ.\\\",\\\"hypotheses\\\":[\\\"α and β are measurable spaces; μ,ν are measures.\\\",\\\"ν and μ are S-finite.\\\",\\\"E is a real normed additive commutative normed space.\\\",\\\"f is integrable with respect to μ.prod ν.\\\"],\\\"evidence\\\":[]}},{\\\"id\\\":\\\"M004\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"If s is compact in a uniform space α, β is a uniform space, and f:α→β is continuous on s, then f is uniformly continuous on s.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"s\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"IsCompact.uniformContinuousOn_of_continuous\\\",\\\"module\\\":\\\"Mathlib.Topology.UniformSpace.HeineCantor\\\",\\\"statement\\\":\\\"For uniform spaces α,β, a set s⊆α, and f:α→β, IsCompact s and ContinuousOn f s imply UniformContinuousOn f s.\\\",\\\"hypotheses\\\":[\\\"α,β are uniform spaces.\\\",\\\"s is compact.\\\",\\\"f is continuous on s.\\\"],\\\"evidence\\\":[]}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"statement\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E′(r)=0.\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"e\\\",\\\"E\\\",\\\"u\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\",\\\"M004\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"locals\\\":[{\\\"symbol\\\":\\\"r0\\\",\\\"type\\\":\\\"positive real number\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix arbitrary r0>0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]},{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"compact interval in (0,∞) with r0 in its interior\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose J from F001.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[\\\"F001\\\"],\\\"objects\\\":[\\\"r0\\\"]},{\\\"symbol\\\":\\\"C_J\\\",\\\"type\\\":\\\"compact subset of R^n\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose the compact spatial set supplied by H003 for J.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"J\\\"]}],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Fix arbitrary r0>0. Choose 0<δ<r0; [r0−δ,r0+δ] is a compact interval J⊂(0,∞) with r0 in its interior. Thus F001, existence of such J, is established.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\"],\\\"produces\\\":[{\\\"id\\\":\\\"F001\\\",\\\"statement\\\":\\\"There exists a compact interval J⊂(0,∞) with r0 in its interior.\\\",\\\"binders\\\":[],\\\"objects\\\":[\\\"r0\\\"],\\\"assumptions\\\":[]}],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"Choose J by F001 and apply H003 to obtain C_J. For x outside C_J, u(x,t)=q for all t∈J, so its time derivative is zero on the interior of J; the spatial derivatives vanish on the open complement of C_J, and continuity gives their vanishing on its boundary. Therefore e(·,t) is continuous and zero outside C_J for t∈J, hence has compact support. Apply M001 with X=R^n, E=R, μ=Lebesgue measure and f=e(·,r0); its hypotheses hold (Lebesgue measure is finite on compact sets; continuity and support were just proved). This establishes integrability. For differentiability, take a compact box B containing C_J and use E(t)=∫_B e(x,t)dx for t∈J. The derivative e_t is continuous on compact B×J, so M004, applied to (x,t)↦e_t(x,t), proves uniform continuity there. For h small with r0+h∈J, M002 applied to t↦e(x,t) on the interval with endpoints r0 and r0+h gives the difference quotient as the average of e_t along that segment; e_t is continuous and therefore interval-integrable. Uniform continuity implies these quotients converge uniformly in x∈B to e_t(x,r0). B has finite Lebesgue measure, so the difference of their integrals is bounded by measure(B) times the uniform error and tends to zero. Hence E is differentiable at r0 and E′(r0)=∫_B e_t(x,r0)dx.\\\",\\\"uses\\\":[\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M004\\\"],\\\"uses_local\\\":[\\\"F001\\\"],\\\"objects\\\":[\\\"J\\\",\\\"C_J\\\",\\\"u\\\",\\\"q\\\",\\\"e\\\",\\\"E\\\",\\\"r0\\\",\\\"B\\\",\\\"h\\\",\\\"δ\\\",\\\"e_t\\\"] ,\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S003\\\",\\\"text\\\":\\\"Differentiate the finite sum defining e: e_t=2u_t·u_tt+2Σ_j u_j·∂_j u_t. For each j, g_j(x)=u_t(x,r0)·u_j(x,r0) is smooth and compactly supported in C_J, and ∂_j g_j=(∂_j u_t)·u_j+u_t·u_jj. This derivative is continuous and compactly supported, hence integrable by M001. Apply M003 to its integrable extension on R×R^(n−1), with the product Lebesgue measures, to integrate first in x_j and then in the other coordinates; the product integrability hypothesis holds because the derivative has compact support and is continuous. The inner one-dimensional integral is zero by M002 applied on a finite interval containing the support: the endpoint values of g_j are zero. Thus ∫(∂_j u_t)·u_j=−∫u_t·u_jj. Summing yields E′(r0)=2∫u_t·(u_tt−Δ_xu). Differentiating |u|²=1 in time gives u·u_t=0. By H002 the acceleration is a scalar multiple of u at each point, so u_t·(u_tt−Δ_xu)=0 pointwise. The integrand is integrable (continuous with compact support); consequently E′(r0)=0.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"H002\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"E\\\",\\\"n\\\",\\\"Δ_x\\\",\\\"u_j\\\",\\\"u_jj\\\",\\\"g_j\\\",\\\"r0\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S004\\\",\\\"text\\\":\\\"Since r0>0 was arbitrary, the integrability and differentiability established in S002 and E′(r0)=0 established in S003 hold at every positive time. This makes no assertion at r=0.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\",\\\"e\\\",\\\"E\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{\\\"X\\\":\\\"R^n\\\",\\\"E\\\":\\\"R\\\",\\\"μ\\\":\\\"Lebesgue measure\\\",\\\"f\\\":\\\"x↦e(x,r0)\\\"},\\\"hypothesis_checks\\\":[\\\"R^n is a measurable topological space and its open sets are Lebesgue measurable.\\\",\\\"R is a normed additive commutative group.\\\",\\\"Lebesgue measure on R^n is finite on compact sets.\\\",\\\"e(·,r0) is continuous by smoothness of u.\\\",\\\"The support of e(·,r0) is contained in compact C_J, so it has compact support.\\\"]},{\\\"input\\\":\\\"M004\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{\\\"α\\\":\\\"B×J\\\",\\\"β\\\":\\\"R\\\",\\\"s\\\":\\\"B×J\\\",\\\"f\\\":\\\"(x,t)↦e_t(x,t)\\\"},\\\"hypothesis_checks\\\":[\\\"B×J is compact as a product of compact sets.\\\",\\\"R is a uniform space.\\\",\\\"e_t is continuous because u is jointly smooth.\\\"]},{\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{\\\"E\\\":\\\"R\\\",\\\"a\\\":\\\"r0\\\",\\\"b\\\":\\\"r0+h\\\",\\\"f\\\":\\\"t↦e(x,t)\\\",\\\"f′\\\":\\\"t↦e_t(x,t)\\\"},\\\"hypothesis_checks\\\":[\\\"R is a complete real normed vector space.\\\",\\\"The classical derivative of t↦e(x,t) is e_t(x,t), by smoothness.\\\",\\\"A continuous function on the compact interval between r0 and r0+h is interval-integrable.\\\"]},{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{\\\"X\\\":\\\"R^n\\\",\\\"E\\\":\\\"R\\\",\\\"μ\\\":\\\"Lebesgue measure\\\",\\\"f\\\":\\\"x↦∂_j g_j(x)\\\"},\\\"hypothesis_checks\\\":[\\\"The Euclidean space R^n has its Lebesgue measurable topology.\\\",\\\"R is a normed additive commutative group.\\\",\\\"Lebesgue measure is finite on compact sets.\\\",\\\"∂_j g_j is continuous by smoothness.\\\",\\\"Its support is contained in C_J, hence compact.\\\"]},{\\\"input\\\":\\\"M003\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{\\\"α\\\":\\\"R^(n−1)\\\",\\\"β\\\":\\\"R\\\",\\\"μ\\\":\\\"Lebesgue measure\\\",\\\"ν\\\":\\\"Lebesgue measure\\\",\\\"E\\\":\\\"R\\\",\\\"f\\\":\\\"the coordinate permutation of (x↦∂_j g_j(x))\\\"},\\\"hypothesis_checks\\\":[\\\"Euclidean Lebesgue spaces are measurable spaces.\\\",\\\"Lebesgue measures on finite-dimensional Euclidean spaces are S-finite.\\\",\\\"R is a real normed space.\\\",\\\"The function is integrable by M001 and invariance under the coordinate identification/permutation, since it is continuous and compactly supported.\\\"]},{\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{\\\"E\\\":\\\"R\\\",\\\"a\\\":\\\"−L\\\",\\\"b\\\":\\\"L\\\",\\\"f\\\":\\\"s↦g_j(x_1,…,s,…,x_n)\\\",\\\"f′\\\":\\\"s↦∂_j g_j(x_1,…,s,…,x_n)\\\"},\\\"hypothesis_checks\\\":[\\\"R is complete.\\\",\\\"The derivative is ∂_j g_j by smoothness.\\\",\\\"The derivative is continuous with compact support on the interval, hence interval-integrable; choose L so the support lies in the interior of [−L,L].\\\"]}]}]}}\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","paramete