data: {"type":"response.output_item.done","sequence_number":1193,"output_index":1,"item":{"type":"function_call","id":"fc_0747305348427987016adb23ed775481919c92857b5d7c0a74","call_id":"call_55b2c0085b59417c93d527d95f489505","name":"check_artifact","arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"full_target\\\":\\\"Let n,m be positive integers; u:R^n×(0,∞)→R^m jointly smooth and q∈R^m have Euclidean norm one. Assume |u(x,r)|=1; for each (x,r) there is a∈R such that u_tt−Δ_xu=a u; and on each compact interval J⊂(0,∞), u(x,r)=q outside a compact C_J uniformly for r∈J. Define e(x,r)=|u_t|²+Σ_{j=1}^n|∂_{x_j}u|² and E(r)=∫_{R^n}e(x,r)dx, Lebesgue measure, Euclidean norms. Prove e(·,r) is Lebesgue integrable for each r>0, E is differentiable for each r>0, and E'(r)=0.\\\",\\\"conclusion\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"m\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"jointly smooth map R^n×(0,∞)→R^m\\\"},{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"unit vector in R^m\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"origin\\\":\\\"frozen-target.md:7-10\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt(x,r)-Δ_xu(x,r)=a u(x,r), with componentwise Δ_x.\\\",\\\"origin\\\":\\\"frozen-target.md:11-13\\\"},{\\\"id\\\":\\\"H003\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), there is compact C_J⊂R^n such that u(x,r)=q for x∉C_J and r∈J.\\\",\\\"origin\\\":\\\"frozen-target.md:14-16\\\"}],\\\"definitions\\\":[{\\\"id\\\":\\\"D001\\\",\\\"symbol\\\":\\\"e\\\",\\\"type\\\":\\\"R^n×(0,∞)→R\\\",\\\"definition\\\":\\\"e(x,r)=|u_t(x,r)|²+Σ_{j=1}^n|∂_{x_j}u(x,r)|²\\\",\\\"depends_on\\\":[]