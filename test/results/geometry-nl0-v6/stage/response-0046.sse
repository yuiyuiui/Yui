D.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"D\\\"]},{\\\"symbol\\\":\\\"δ\\\",\\\"type\\\":\\\"positive scale\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix 0<δ≤1.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]},{\\\"symbol\\\":\\\"r_j\\\",\\\"type\\\":\\\"positive real sequence\\\",\\\"scope\\\":\\\"R001/S001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S001\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose positive cover diameters r_j≤δ with arbitrarily small q-cost; replace zero-diameter sets by small balls if n>0.\\\",\\\"from_inputs\\\":[\\\"H002\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"δ\\\",\\\"q\\\"]},{\\\"symbol\\\":\\\"s\\\",\\\"type\\\":\\\"positive real exponent\\\",\\\"scope\\\":\\\"R001/S002\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"If D>0 fix 0<s<D.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"D\\\"]},{\\\"symbol\\\":\\\"ε\\\",\\\"type\\\":\\\"positive real\\\",\\\"scope\\\":\\\"R001/S002\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix ε>0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]},{\\\"symbol\\\":\\\"V_i\\\",\\\"type\\\":\\\"sequence of subsets of F\\\",\\\"scope\\\":\\\"R001/S002\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix an arbitrary countable δ-cover of F.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"F\\\",\\\"δ\\\"]},{\\\"symbol\\\":\\\"ρ_i\\\",\\\"type\\\":\\\"ENNReal sequence ediam(V_i)\\\",\\\"scope\\\":\\\"R001/S002\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Put ρ_i=ediam(V_i).\\\",\\\"from_inputs\\\":[],\\\"from_local\\