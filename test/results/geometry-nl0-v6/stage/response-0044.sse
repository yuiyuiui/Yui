 indicator of J_i∩[0,1].\\\"},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"D\\\",\\\"type\\\":\\\"ENNReal, dim_H(E)\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S003\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define D=dim_H(E).\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"dim_H\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"F\\\",\\\"type\\\":\\\"subset ℝ^(n+1), E×[0,1]\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S003\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define F=E×[0,1].\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"n\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"real exponent\\\",\\\"scope\\\":\\\"R001/S001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S001\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix arbitrary q>D.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"D\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"δ\\\",\\\"type\\\":\\\"positive scale\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix a positive scale δ≤1.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"r_j\\\",\\\"type\\\":\\\"positive real sequence\\\",\\\"scope\\\":\\\"R001/S001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S001\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose positive cover diameters r_j≤δ with arbitrarily small q-cost; for n>0 replace zero-diameter members