tifact","arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"full_target\\\":\\\"Let n,m be positive integers; u:R^n×(0,∞)→R^m jointly smooth and q∈R^m have Euclidean norm one. Assume |u(x,r)|=1; for each (x,r) there is a∈R with u_tt−Δ_xu=a u; and on each compact interval J⊂(0,∞), u=q outside a compact C_J uniformly for r∈J. Define e(x,r)=|u_t|²+Σ_{j=1}^n|∂_{x_j}u|² and E(r)=∫_{R^n}e(x,r)dx, Lebesgue measure, Euclidean norms. Prove e(·,r) is Lebesgue integrable for each r>0, E is differentiable for each r>0, and E'(r)=0.\\\",\\\"conclusion\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"m\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"jointly smooth map R^n×(0,∞)→R^m\\\"},{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"unit vector in R^m\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"origin\\\":\\\"frozen-target.md:7-10\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt(x,r)-Δ_xu(x,r)=a u(x,r), with componentwise Δ_x.\\\",\\\"origin\\\":\\\"frozen-target.md:11-13\\\"},{\\\"id\\\":\\\"H003\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), there is compact C_J⊂R^n such that u(x,r)=q for x∉C_J and r∈J.\\\",\\\"origin\\\":\\\"frozen-target.md:14-16\\\"}],\\\"definitions\\\":[{\\\"id\\\":\\\"D001\\\",\\\"symbol\\\":\\\"e\\\",\\\"type\\\":\\\"R^n×(0,∞)→R\\\",\\\"definition\\\":\\\"e(x,r)=|u_t(x,r)|²+Σ_{j=1}^n|∂_{x_j}u(x,r)|²\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"R^n\\\"},{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]},{\\\"id\\\":\\\"D002\\\",\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"(0,∞)→R\\\",\\\"definition\\\":\\\"E(r)=Lebesgue integral over R^n of e(x,r)\\\",\\\"depends_on\\\":[\\\"D001\\\"],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"e\\\"]},{\\\"id\\\":\\\"D003\\\",\\\"symbol\\\":\\\"Δ_x\\\",\\\"type\\\":\\\"operator on smooth R^m-valued maps\\\",\\\"definition\\\":\\\"Δ_xu=Σ_{j=1}^n∂²_{x_j}u, componentwise\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]}],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"direct\\\",\\\"modus_ponens\\\",\\\"forall_introduction\\\",\\\"implication_introduction\\\",\\\"exists_elimination\\\",\\\"contradiction_classical\\\"],\\\"calculations\\\":[\\\"Finite Euclidean inner-product and finite-sum identities and differentiation of smooth functions. FTC, compactness, uniform continuity and iterated integration are justified in the inference, not treated as trusted primitives.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"real numbers\\\",\\\"meaning\\\":\\\"Real field, topology, order, and Lebesgue measure.\\\"},{\\\"symbol\\\":\\\"R^k\\\",\\\"type\\\":\\\"Euclidean space\\\",\\\"meaning\\\":\\\"Euclidean space with inner product and Lebesgue measure.\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[{\\\"path\\\":\\\"frozen-target.md\\\",\\\"sha256\\\":\\\"placeholder\\\"},{\\\"path\\\":\\\"problem.md\\\",\\\"sha256\\\":\\\"placeholder\\\"},{\\\"path\\\":\\\"proof-draft.json\\\",\\\"sha256\\\":\\\"placeholder\\\"},{\\\"path\\\":\\\"source-context.md\\\",\\\"sha256\\\":\\\"placeholder\\\"}]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt(x,r)-Δ_xu(x,r)=a u(x,r), with componentwise Δ_x.\\\",\\\"definitions\\\":[\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"Δ_x\\\"]},{\\\"id\\\":\\\"H003\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), there is compact C_J⊂R^n such that u(x,r)=q for x∉C_J and r∈J.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"q\\\"]},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"statement\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"e\\\",\\\"E\\\",\\\"u\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"H003\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\"],\\\"locals\\\":[{\\\"symbol\\\":\\\"r0\\\",\\\"type\\\":\\\"positive real number\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S006\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix arbitrary r0>0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]},{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"compact interval in (0,∞) with r0 in its interior\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S006\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose J after the existence fact F001.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[\\\"F001\\\"],\\\"objects\\\":[\\\"r0\\\"]},{\\\"symbol\\\":\\\"C_J\\\",\\\"type\\\":\\\"compact subset of R^n\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S006\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose the compact set supplied by H003 for J.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[\\\"J\\\"],\\\"objects\\\":[\\\"J\\\"]},{\\\"symbol\\\":\\\"B\\\",\\\"type\\\":\\\"closed coordinate box containing C_J\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S006\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose B after the existence fact F002.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[\\\"F002\\\"],\\\"objects\\\":[\\\"C_J\\\"]}],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Fix arbitrary r0>0. Choose δ with 0<δ<r0 and set J=[r0−δ,r0+δ]; thus there exists a compact interval in (0,∞) with r0 in its interior, recorded as F001.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\"],\\\"produces\\\":[{\\\"id\\\":\\\"F001\\\",\\\"statement\\\":\\\"There exists a compact interval J⊂(0,∞) with r0 in its interior.\\\",\\\"binders\\\":[],\\\"objects\\\":[\\\"r0\\\"],\\\"assumptions\\\":[]}],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"Choose J using F001. H003 applied to this compact interval supplies compact C_J and the stated uniform equality. Compactness of C_J implies boundedness, so a closed coordinate box B containing it exists; record this as F002. On the open complement of C_J, u=q for all times in J, so its spatial and time first derivatives vanish there. By continuity they vanish also at boundary points of C_J. Hence e(·,s) is continuous, zero off C_J and bounded on C_J, and therefore Lebesgue integrable for every s∈J.\\\",\\\"uses\\\":[\\\"H003\\\"],\\\"uses_local\\\":[\\\"F001\\\"],\\\"objects\\\":[\\\"J\\\",\\\"C_J\\\",\\\"B\\\",\\\"q\\\",\\\"u\\\",\\\"e\\\"],\\\"produces\\\":[{\\\"id\\\":\\\"F002\\\",\\\"statement\\\":\\\"There exists a closed coordinate box B⊂R^n containing C_J.\\\",\\\"binders\\\":[],\\\"objects\\\":[\\\"C_J\\\",\\\"n\\\"],\\\"assumptions\\\":[]}],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S003\\\",\\\"text\\\":\\\"Choose B by F002. For s∈J, E(s)=∫_B e(x,s)dx since e vanishes outside C_J⊂B. On B×J, e_s is continuous and uniformly continuous. For sufficiently small nonzero h with r0+h∈J, the one-variable fundamental theorem of calculus gives (e(x,r0+h)−e(x,r0))/h=∫_0^1 e_s(x,r0+θh)dθ. Uniform continuity implies these quotients converge uniformly in x∈B to e_s(x,r0). B has finite measure, so the difference between their integrals and ∫_B e_s(x,r0)dx is at most measure(B) times the uniform error, tending to zero. Thus E is differentiable at r0 and E'(r0)=∫_B e_s(x,r0)dx. Differentiating the finite sum gives e_s=2u_t·u_tt+2Σ_j u_j·∂_j u_t, where u_j=∂_j u.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[\\\"F002\\\"],\\\"objects\\\":[\\\"B\\\",\\\"J\\\",\\\"E\\\",\\\"e\\\",\\\"u\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S004\\\",\\\"text\\\":\\\"For each coordinate j, f_j(x)=u_t(x,r0)·u_j(x,r0) is smooth and supported in C_J. Its derivative ∂_j f_j=(∂_j u_t)·u_j+u_t·u_jj is continuous and compactly supported, hence absolutely integrable. Choose a coordinate interval containing C_J in its interior. For each fixed choice of the other coordinates, the one-variable fundamental theorem of calculus gives integral in coordinate j of ∂_j f_j equal to the endpoint difference of f_j, which is zero. Fubini is applicable because ∂_j f_j is absolutely integrable; iterating the integral gives ∫_{R^n}∂_j f_j=0. Therefore ∫(∂_j u_t)·u_j=−∫u_t·u_jj. Summing the finite set of identities yields E'(r0)=2∫_{R^n}u_t·(u_tt−Δ_xu)dx.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"u_t\\\",\\\"u_j\\\",\\\"u_jj\\\",\\\"n\\\",\\\"Δ_x\\\",\\\"E\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S005\\\",\\\"text\\\":\\\"Differentiating |u(x,r)|²=1 in time gives u·u_t=0. By H002, at each x there is a real a with u_tt−Δ_xu=a u. Consequently u_t·(u_tt−Δ_xu)=a(u_t·u)=0 pointwise, so the integral expression for E'(r0) is zero.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"H002\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"u_t\\\",\\\"u_tt\\\",\\\"Δ_x\\\",\\\"a\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S006\\\",\\\"text\\\":\\\"Since r0 was arbitrary, the integrability, differentiability, and vanishing derivative established at r0 hold for every positive time. No assertion at the endpoint zero is used.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\",\\\"e\\\",\\\"E\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[]}]}}\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read an explicitly frozen task document by ID; no other local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["id","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Stop this stage honestly on a substantive or suspected proof gap, unavailable source, or input conflict. JSON fields: status, location, explanation, basis, partial_progress. Status must be SUBSTANTIVE_GAP, SUSPECTED_GAP, SOURCE_UNAVAILABLE or INPUT_CONFLICT. Difficulty alone is not a mathematical error.","parameters":{"type":"object","properties":{"obstacle_json":{"type":"string"}},"required":["obstacle_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"probe_library","description":"Query a proved Mathlib theorem and its exact signature/axioms in the offline sandbox. Returns located evidence for an M source; the mathematical statement and applicability still require review.","parameters":{"type":"object","properties":{"id":{"type":"string"},"declaration":{"type":"string"},"module":{"type":"string"}},"required":["id","declaration","module"],"additionalProperties":false},"output_schema":null,"strict":false}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"c12128ae-252b-4568-9c2e-3243e704e76d","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature"