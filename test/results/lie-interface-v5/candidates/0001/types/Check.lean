import Mathlib
open scoped TensorProduct
noncomputable def dividedPower (V : Type*) [AddCommGroup V] [Module ℂ V] (f : V →ₗ[ℂ] V) (r : ℕ) : V →ₗ[ℂ] V := ((Nat.factorial r : ℂ)⁻¹) • (f ^ r)
def InvariantUnder (K : Type*) [Field K] (E : Type*) [AddCommGroup E] [Module K E] (f : E →ₗ[K] E) (W : Submodule K E) : Prop := ∀ z ∈ W, f z ∈ W
def LieIrreducible (K : Type*) [Field K] (E : Type*) [AddCommGroup E] [Module K E] (x y h : E →ₗ[K] E) : Prop := Nontrivial E ∧ ∀ W : Submodule K E, InvariantUnder K E x W → InvariantUnder K E y W → InvariantUnder K E h W → W = ⊥ ∨ W = ⊤
structure HighestWeightLattice (p lam : ℤ) (M : Type*) [AddCommGroup M] [Module ℤ M] where
  V : Type*
  [vAdd : AddCommGroup V]
  [vMod : Module ℂ V]
  basisV : Module.Basis (Fin (lam.toNat + 1)) ℂ V
  basisM : Module.Basis (Fin (lam.toNat + 1)) ℤ M
  embed : M →ₗ[ℤ] V
  x : V →ₗ[ℂ] V
  y : V →ₗ[ℂ] V
  h : V →ₗ[ℂ] V
  xM : M →ₗ[ℤ] M
  yM : M →ₗ[ℤ] M
  hM : M →ₗ[ℤ] M
  v : V
  basis_compatible : ∀ i, basisV i = embed (basisM i)
  embed_injective : Function.Injective embed
  bracket_hx : ∀ w, h (x w) - x (h w) = (2:ℂ) • x w
  bracket_hy : ∀ w, h (y w) - y (h w) = (-2:ℂ) • y w
  bracket_xy : ∀ w, x (y w) - y (x w) = h w
  v_nonzero : v ≠ 0
  highest_x : x v = 0
  highest_h : h v = (lam:ℂ) • v
  complex_irreducible : LieIrreducible ℂ V x y h
  x_compatible : ∀ m, embed (xM m) = x (embed m)
  y_compatible : ∀ m, embed (yM m) = y (embed m)
  h_compatible : ∀ m, embed (hM m) = h (embed m)
  divided_x_preserves : ∀ r m, ∃ m', embed m' = dividedPower V x r (embed m)
  divided_y_preserves : ∀ r m, ∃ m', embed m' = dividedPower V y r (embed m)

