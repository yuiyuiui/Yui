="},{"type":"function_call","id":"fc_05ead64b871aca2a016adb610bc0ac8191b156e1d0923e3bbf","call_id":"call_c1c6130903d843abbd60d0e2e41bdf7d","name":"check_draft","arguments":"{\"artifact\":{\"header\":\"import Mathlib\\nopen scoped TensorProduct\\nnoncomputable def dividedPower (V : Type*) [AddCommGroup V] [Module ℂ V] (f : V →ₗ[ℂ] V) (r : ℕ) : V →ₗ[ℂ] V := ((Nat.factorial r : ℂ)⁻¹) • (f ^ r)\\ndef LieIrreducible (K : Type*) [Field K] (E : Type*) [AddCommGroup E] [Module K E] (x y h : E →ₗ[K] E) : Prop := Nontrivial E ∧ ∀ W : Submodule K E, (∀ z ∈ W, x z ∈ W) → (∀ z ∈ W, y z ∈ W) → (∀ z ∈ W, h z ∈ W) → W = ⊥ ∨ W = ⊤\\nstructure LatticeInput (lam : ℤ) (M : Type*) [AddCommGroup M] [Module ℤ M] where\\n  V : Type*\\n  [vAdd : AddCommGroup V]\\n  [vMod : Module ℂ V]\\n  basisV : Module.Basis (Fin (lam.toNat + 1)) ℂ V\\n  basisM : Module.Basis (Fin (lam.toNat + 1)) ℤ M\\n  embed : M →ₗ[ℤ] V\\n  x : V →ₗ[ℂ] V\\n  y : V →ₗ[ℂ] V\\n  h : V →ₗ[ℂ] V\\n  xM : M →ₗ[ℤ] M\\n  yM : M →ₗ[ℤ] M\\n  hM : M →ₗ[ℤ] M\\n  v : V\\n  basis_compatible : ∀ i, basisV i = embed (basisM i)\\n  embed_injective : Function.Injective embed\\n  complex_irreducible : LieIrreducible ℂ V x y h\\n  x_compatible : ∀ m, embed (xM m) = x (embed m)\\n  y_compatible : ∀ m, embed (yM m) = y (embed m)\\n  h_compatible : ∀ m, embed (hM m) = h (embed m)\\n  divided_x_preserves : ∀ r m, ∃ m', embed m' = dividedPower V x r (embed m)\\n  divided_y_preserves : ∀ r m, ∃ m', embed m' = dividedPower V y r (embed m)\\ndef LatticeInput.H004 {lam : ℤ} {M : Type*} [AddCommGroup M] [Module ℤ M] (D : LatticeInput lam M) : Prop := by\\n  letI := D.vAdd\\n  letI := D.vMod\\n  exact (∀ w, D.h (D.x w) - D.x (D.h w) = (2:ℂ) • D.x w) ∧ (∀ w, D.h (D.y w) - D.y (D.h w) = (-2:ℂ) • D.y w) ∧ (∀ w, D.x (D.y w) - D.y (D.x w) = D.h w) ∧ D.v ≠ 0 ∧ D.x D.v = 0 ∧ D.h D.v = (lam:ℂ) • D.v ∧ (∀ i, D.basisV i = D.embed (D.basisM i)) ∧ Function.Injective D.embed ∧ LieIrreducible ℂ D.V D.x D.y D.h ∧ (∀ m, D.embed (D.xM m) = D.x (D.embed m)) ∧ (∀ m, D.embed (D.yM m) = D.y (D.embed m)) ∧ (∀ m, D.embed (D.hM m) = D.h (D.embed m)) ∧ (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.x r (D.embed m)) ∧ (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.y r (D.embed m))\\nnoncomputable def tensorAction {K : Type*} [Field K] {M : Type*} [AddCommGroup M] [Module ℤ M] [Module K (M ⊗[ℤ] K)] (f : M →ₗ[ℤ] M) : M ⊗[ℤ] K →ₗ[K] M ⊗[ℤ] K := TensorProduct.AlgebraTensorModule.lTensor K K f\\n\"},\"parameters\":[{\"name\":\"K\",\"type\":\"Type*\"},{\"name\":\"instK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"p\",\"type\":\"ℕ\"},{\"name\":\"instChar\",\"type\":\"CharP K p\",\"binder_kind\":\"instance\"},{\"name\":\"hp\",\"type\":\"Nat.Prime p\"},{\"name\":\"lam\",\"type\":\"ℤ\"},{\"name\":\"hLam\",\"type\":\"(0:ℤ) ≤ lam ∧ lam < (p:ℤ)\"},{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"instM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"instModM\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"},{\"name\":\"instTensorK\",\"type\":\"Module K (M ⊗[ℤ] K)\",\"binder_kind\":\"instance\"},{\"name\":\"D\",\"type\":\"LatticeInput lam M\"},{\"name\":\"hD\",\"type\":\"LatticeInput.H004 D\"}],\"premise_types\":{\"H001\":\"Nat.Prime p\",\"H002\":\"CharP K p\",\"H003\":\"(0:ℤ) ≤ lam ∧ lam < (p:ℤ)\",\"H004\":\"LatticeInput.H004 D\"},\"conclusion_type\":\"LieIrreducible K (M ⊗[ℤ] K) (tensorAction D.xM) (tensorAction D.yM) (tensorAction D.hM)\",\"representation\":\"V is a complex vector space of dimension lambda+1; M is an arbitrary free abelian lattice with a Z-basis whose image under the injective embedding is a C-basis of V. The operators x,y,h satisfy the stated sl2 relations and highest-weight conditions and restrict to integral operators on M; every divided power preserves M. Characteristic-zero irreducibility is included because accepted H004 explicitly states it. The target carrier is precisely M tensor_Z K in the source order, with K action and induced operators. The Module K typeclass binder supplies the scalar-extension module structure needed by this Lean tensor presentation; it is a representation prerequisite, not a theorem about irreducibility. The interface keeps p=2 and lambda=0 and makes no claim that reduced h-weights are distinct. This encoding remains subject to a separate source-fidelity review, especially the canonical status of the tensor action instance and the exact relationship of the bundled basis data to the source lattice.\",\"objects\":[],\"steps\":[{\"id\":\"T001\",\"statement\":\"LieIrreducible K (M ⊗[ℤ] K) (tensorAction D.xM) (tensorAction D.yM) (tensorAction D.hM)\",\"inputs\":[\"H001\",\"H002\",\"H003\",\"H004\"],\"source_steps\":[\"S001\",\"S002\",\"S003\",\"S004\",\"S005\",\"S006\",\"S007\",\"S008\"],\"explanation\":\"One closed implementation obligation for the whole accepted route, deliberately retaining the actual source-order target and all four root inputs. A later proof must establish the characteristic-zero divided-power basis and endpoint formulas; form the divided-power matrix units and prove their coefficients are units in Z_(p), including lambda=0 and p=2; analyze the coordinate modules for the arbitrary localized lattice, compute fraction-field dimension before proving the rank-one generator; reduce that lattice basis and the operator matrices to M tensor_Z K; then apply the matrix units to an arbitrary nonzero invariant subspace and discharge the zero/nonzero cases. The witness choices remain local to the nonzero branch. This port is the substantive source theorem itself, not a True placeholder; proof workers may refine it only by adding genuine consequences as locally checked T ports without changing the target or allowed assumptions.\"}],\"terminal\":\"T001\",\"source_outputs\":{\"P\":\"T001\"}}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":