ℤ) (M : Type*) [AddCommGroup M] [Module ℤ M] where\\n  V : Type*\\n  [vAdd : AddCommGroup V]\\n  [vMod : Module ℂ V]\\n  basisV : Module.Basis (Fin (lam.toNat + 1)) ℂ V\\n  basisM : Module.Basis (Fin (lam.toNat + 1)) ℤ M\\n  embed : M →ₗ[ℤ] V\\n  x : V →ₗ[ℂ] V\\n  y : V →ₗ[ℂ] V\\n  h : V →ₗ[ℂ] V\\n  xM : M →ₗ[ℤ] M\\n  yM : M →ₗ[ℤ] M\\n  hM : M →ₗ[ℤ] M\\n  v : V\\n  basis_compatible : ∀ i, basisV i = embed (basisM i)\\n  embed_injective : Function.Injective embed\\n  complex_irreducible : LieIrreducible ℂ V x y h\\n  x_compatible : ∀ m, embed (xM m) = x (embed m)\\n  y_compatible : ∀ m, embed (yM m) = y (embed m)\\n  h_compatible : ∀ m, embed (hM m) = h (embed m)\\n  divided_x_preserves : ∀ r m, ∃ m', embed m' = dividedPower V x r (embed m)\\n  divided_y_preserves : ∀ r m, ∃ m', embed m' = dividedPower V y r (embed m)\\n\\ndef DData.H004 {lam : ℤ} {M : Type*} [AddCommGroup M] [Module ℤ M] (D : DData lam M) : Prop := by\\n  letI := D.vAdd\\n  letI := D.vMod\\n  exact (∀ w, D.h (D.x w) - D.x (D.h w) = (2:ℂ) • D.x w) ∧ (∀ w, D.h (D.y w) - D.y (D.h w) = (-2:ℂ) • D.y w) ∧ (∀ w, D.x (D.y w) - D.y (D.x w) = D.h w) ∧ D.v ≠ 0 ∧ D.x D.v = 0 ∧ D.h D.v = (lam:ℂ) • D.v ∧ (∀ i, D.basis_compatible i) ∧ (Function.Injective D.embed) ∧ (LieIrreducible ℂ D.V D.x D.y D.h) ∧ (∀ m, D.embed (D.xM m) = D.x (D.embed m)) ∧ (∀ m, D.embed (D.yM m) = D.y (D.embed m)) ∧ (∀ m, D.embed (D.hM m) = D.h (D.embed m)) ∧ (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.x r (D.embed m)) ∧ (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.y r (D.embed m))\\n\",\"parameters\":[{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"instM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"instMod\",\"type\":\"Module ℤ M\"}],\"types\":[\"∀ (D : DData 0 M), DData.H004 D\"]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read an explicitly frozen task document by ID; no other local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["id","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Report exact status, location, explanation, basis, partial_progress. SUBSTANTIVE_GAP or SUSPECTED_GAP stops for an actual unsupported mathematical implica