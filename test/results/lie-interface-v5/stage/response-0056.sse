data: {"type":"response.function_call_arguments.done","sequence_number":292,"item_id":"fc_05ead64b871aca2a016adb61e009708191842d2f89778a9321","output_index":1,"arguments":"{\"header\":\"import Mathlib\\nopen scoped TensorProduct\\nnoncomputable def tensorAction {K : Type*} [Field K] {M : Type*} [AddCommGroup M] [Module ℤ M] [Module K (M ⊗[ℤ] K)] (f : M →ₗ[ℤ] M) : M ⊗[ℤ] K →ₗ[K] M ⊗[ℤ] K :=\\n  { TensorProduct.map f (LinearMap.id : K →ₗ[ℤ] K) with\\n    map_smul' := by\\n      intro c z\\n      induction z using TensorProduct.induction_on with\\n      | zero => simp\\n      | tmul m k => simp [TensorProduct.map_tmul]\\n      | add z₁ z₂ ih₁ ih₂ => simp [ih₁, ih₂] }\\n\",\"parameters\":[{\"name\":\"K\",\"type\":\"Type*\"},{\"name\":\"instK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"instM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"instMod\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"},{\"name\":\"instTensor\",\"type\":\"Module K (M ⊗[ℤ] K)\",\"binder_kind\":\"instance\"}],\"types\":[\"tensorAction (0 : M →ₗ[ℤ] M)\"]}"}

