data: {"type":"response.function_call_arguments.done","sequence_number":368,"item_id":"fc_05ead64b871aca2a016adb62bf7bdc8191949cc383ef29c85d","output_index":2,"arguments":"{\"header\":\"import Mathlib\\nopen scoped TensorProduct\\nnoncomputable def srcComm {K : Type*} [Field K] (M : Type*) [AddCommGroup M] [Module ℤ M] : (M ⊗[ℤ] K) ≃+ (K ⊗[ℤ] M) := (TensorProduct.comm ℤ M K).toAddEquiv\\nnoncomputable def sourceTensorModule (K : Type*) [Field K] (M : Type*) [AddCommGroup M] [Module ℤ M] : Module K (M ⊗[ℤ] K) := (srcComm K M).module K\\nnoncomputable def sourceTensorAction {K : Type*} [Field K] {M : Type*} [AddCommGroup M] [Module ℤ M] (f : M →ₗ[ℤ] M) : M ⊗[ℤ] K →ₗ[K] M ⊗[ℤ] K := by\\n  letI := sourceTensorModule K M\\n  let e : M ⊗[ℤ] K ≃ₗ[K] K ⊗[ℤ] M := (srcComm K M).linearEquiv K\\n  exact e.symm.toLinearMap.comp ((TensorProduct.AlgebraTensorModule.lTensor K K f).comp e.toLinearMap)\\n\",\"parameters\":[{\"name\":\"K\",\"type\":\"Type*\"},{\"name\":\"instK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"instM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"instMod\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"}],\"types\":[\"sourceTensorModule K M\",\"sourceTensorAction (0 : M →ₗ[ℤ] M)\"]}"}

