) = D.y (D.embed m)) ∧ (∀ m, D.embed (D.hM m) = D.h (D.embed m)) ∧ (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.x r (D.embed m)) ∧ (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.y r (D.embed m))\\n\",\"parameters\":[{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"instM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"instMod\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"}],\"types\":[\"∀ (D : DData 0 M), DData.H004 D\",\"Module.Free ℤ M\"]}","status":"completed"}}

