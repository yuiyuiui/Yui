ype\":\"ℤ\"},{\"name\":\"hLam\",\"type\":\"(0:ℤ) ≤ lam ∧ lam < (p:ℤ)\"},{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"instM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"instModM\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"},{\"name\":\"instTensorK\",\"type\":\"Module K (M ⊗[ℤ] K)\",\"binder_kind\":\"instance\"},{\"name\":\"D\",\"type\":\"Nat\"},{\"name\":\"hD\",\"type\":\"True\"}],\"premise_types\":{\"H001\":\"Nat.Prime p\",\"H002\":\"CharP K p\",\"H003\":\"(0:ℤ) ≤ lam ∧ lam < (p:ℤ)\",\"H004\":\"True\"},\"conclusion_type\":\"True\",\"representation\":\"test\",\"objects\":[],\"steps\":[{\"id\":\"T001\",\"statement\":\"True\",\"inputs\":[\"H001\",\"H002\",\"H003\",\"H004\"],\"source_steps\":[\"S001\",\"S002\",\"S003\",\"S004\",\"S005\",\"S006\",\"S007\",\"S008\"],\"explanation\":\"x\"}],\"terminal\":\"T001\",\"source_outputs\":{\"P\":\"T001\"}}}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read an explicitly frozen task document by ID; no other local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["id","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared