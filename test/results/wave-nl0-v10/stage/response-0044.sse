atement\\\":\\\"For every t>0, e(·,t) is Lebesgue integrable; on every compact interval J⊂(0,∞) with compact C as in H003, the fields u_t(·,t), u_{x_j}(·,t), e(·,t), and e_t(·,t) are continuous and vanish outside C for t∈J.\\\",\\\"definitions\\\":[\\\"D001\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"e\\\",\\\"u\\\",\\\"n\\\",\\\"m\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/propositions/-\\\",\\\"value\\\":{\\\"id\\\":\\\"N002\\\",\\\"kind\\\":\\\"internal\\\",\\\"statement\\\":\\\"For every r>0, E is differentiable at r and E′(r)=∫_{ℝⁿ}e_t(x,r)dx.\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"e\\\",\\\"u\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/propositions/-\\\",\\\"value\\\":{\\\"id\\\":\\\"N003\\\",\\\"kind\\\":\\\"internal\\\",\\\"statement\\\":\\\"For every r>0, E′(r)=2∫_{ℝⁿ}u_t(x,r)·(u_{tt}(x,r)−Δ_xu(x,r))dx.\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"u\\\",\\\"Δ_x\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/propositions/-\\\",\\\"value\\\":{\\\"id\\\":\\\"N004\\\",\\\"kind\\\":\\\"internal\\\",\\\"statement\\\":\\\"For every (x,r)∈ℝⁿ×(0,∞), u_t(x,r)·(u_{tt}(x,r)−Δ_xu(x,r))=0.\\\",\\\"definitions\\\":[\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"Δ_x\\\"]}}]}\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read an explicitly frozen task document by ID; no other local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["id","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Report exact status, location, explanation, basis, partial_progress. SUBSTANTIVE_GAP or SUSPECTED_GAP stops for an actual unsupported mathematical implication; give its premises, conclusion and mathematical grounds. SOURCE_UNAVAILABLE or INPUT_CONFLICT stops for a real source-access/original-input obstacle. Ordinary unfinished drafting, source registration or format work must use TASK_INCOMPLETE: this records progress without ending the stage; continue the actual work. Difficulty or artifact incompletion alone is not a mathematical gap.","par