data: {"type":"response.function_call_arguments.done","sequence_number":737,"item_id":"fc_0bfe6e1fa8f24ccf016adb3b95ee5c8191adfefa8b386cab50","output_index":2,"arguments":"{\"artifact_json\":\"{\\\"base_candidate\\\":2,\\\"patches\\\":[{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/propositions/-\\\",\\\"value\\\":{\\\"id\\\":\\\"M006\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For a measurable space with measure, real scalar parameter and real-valued F, if the parameter neighborhood s contains x₀, F(τ) is a.e. strongly measurable near x₀, F(x₀) is integrable, F′(x₀) is a.e. strongly measurable, an integrable bound dominates |F′(τ,a)| for almost every a and every τ∈s, F′(τ,a) is the derivative of F(τ,a) for almost every a and every τ∈s, then the integral map has derivative ∫F′(x₀,a), and that derivative function is integrable.\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"α\\\",\\\"type\\\":\\\"measurable space\\\"},{\\\"symbol\\\":\\\"μ\\\",\\\"type\\\":\\\"measure on α\\\"},{\\\"symbol\\\":\\\"F\\\",\\\"type\\\":\\\"ℝ→α→ℝ\\\"},{\\\"symbol\\\":\\\"F′\\\",\\\"type\\\":\\\"ℝ→α→ℝ\\\"},{\\\"symbol\\\":\\\"bound\\\",\\\"type\\\":\\\"α→ℝ\\\"},{\\\"symbol\\\":\\\"x₀\\\",\\\"type\\\":\\\"ℝ\\\"},{\\\"symbol\\\":\\\"s\\\",\\\"type\\\":\\\"set of reals\\\"}],\\\"objects\\\":[\\\"α\\\",\\\"μ\\\",\\\"F\\\",\\\"F′\\\",\\\"bound\\\",\\\"x₀\\\",\\\"s\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"hasDerivAt_integral_of_dominated_loc_of_deriv_le\\\",\\\"module\\\":\\\"Mathlib.Analysis.Calculus.ParametricIntegral\\\",\\\"hypotheses\\\":[\\\"s is a neighborhood of x₀.\\\",\\\"F(τ) is a.e. strongly measurable eventually near x₀.\\\",\\\"F(x₀) is integrable.\\\",\\\"F′(x₀) is a.e. strongly measurable.\\\",\\\"An integrable bound dominates the norm of F′(τ,a) for almost every a and all τ∈s.\\\",\\\"For almost every a, τ↦F(τ,a) has derivative F′(τ,a) for every τ∈s.\\\",\\\"Real scalar and normed-space structures as in the signature.\\\"]}}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/propositions/-\\\",\\\"value\\\":{\\\"id\\\":\\\"M007\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For continuous u,v on uIcc(a,b), differentiable on the open interval with derivatives u′,v′, and interval-integrable derivatives, the interval integral of u′v+uv′ equals u(b)v(b)−u(a)v(a).\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"a\\\",\\\"type\\\":\\\"ℝ\\\"},{\\\"symbol\\\":\\\"b\\\",\\\"type\\\":\\\"ℝ\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"ℝ→ℝ\\\"},{\\\"symbol\\\":\\\"v\\\",\\\"type\\\":\\\"ℝ→ℝ\\\"},{\\\"symbol\\\":\\\"u′\\\",\\\"type\\\":\\\"ℝ→ℝ\\\"},{\\\"symbol\\\":\\\"v′\\\",\\\"type\\\":\\\"ℝ→ℝ\\\"}],\\\"objects\\\":[\\\"a\\\",\\\"b\\\",\\\"u\\\",\\\"v\\\",\\\"u′\\\",\\\"v′\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"intervalIntegral.integral_deriv_mul_eq_sub_of_hasDerivAt\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.IntervalIntegral.IntegrationByParts\\\",\\\"hypotheses\\\":[\\\"u,v continuous on uIcc(a,b).\\\",\\\"u,v have derivatives u′,v′ on the open interval.\\\",\\\"u′ and v′ interval-integrable.\\\",\\\"ℝ has the complete normed algebra structure required by the theorem.\\\"]}}}]}\"}"}

