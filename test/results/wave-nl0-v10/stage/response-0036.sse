"measure on α\\\"},{\\\"symbol\\\":\\\"F\\\",\\\"type\\\":\\\"ℝ→α→ℝ\\\"},{\\\"symbol\\\":\\\"F′\\\",\\\"type\\\":\\\"ℝ→α→ℝ\\\"},{\\\"symbol\\\":\\\"bound\\\",\\\"type\\\":\\\"α→ℝ\\\"},{\\\"symbol\\\":\\\"x₀\\\",\\\"type\\\":\\\"ℝ\\\"},{\\\"symbol\\\":\\\"s\\\",\\\"type\\\":\\\"set of reals\\\"}],\\\"objects\\\":[\\\"α\\\",\\\"μ\\\",\\\"F\\\",\\\"F′\\\",\\\"bound\\\",\\\"x₀\\\",\\\"s\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"hasDerivAt_integral_of_dominated_loc_of_deriv_le\\\",\\\"module\\\":\\\"Mathlib.Analysis.Calculus.ParametricIntegral\\\",\\\"hypotheses\\\":[\\\"s is a neighborhood of x₀.\\\",\\\"F(τ) is a.e. strongly measurable eventually near x₀.\\\",\\\"F(x₀) is integrable.\\\",\\\"F′(x₀) is a.e. strongly measurable.\\\",\\\"An integrable bound dominates the norm of F′(τ,a) for almost every a and all τ∈s.\\\",\\\"For almost every a, τ↦F(τ,a) has derivative F′(τ,a) for every τ∈s.\\\",\\\"Real scalar and normed-space structures as in the signature.\\\"]}}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/propositions/-\\\",\\\"value\\\":{\\\"id\\\":\\\"M007\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For continuous u,v on uIcc(a,b), differentiable on the open interval with derivatives u′,v′, and interval-integrable derivatives, the interval integral of u′v+uv′ equals u(b)v(b)−u(a)v(a).\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"a\\\",\\\"type\\\":\\\"ℝ\\\"},{\\\"symbol\\\":\\\"b\\\",\\\"type\\\":\\\"ℝ\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"ℝ→ℝ\\\"},{\\\"symbol\\\":\\\"v\\\",\\\"type\\\":\\\"ℝ→ℝ\\\"},{\\\"symbol\\\":\\\"u′\\\",\\\"type\\\":\\\"ℝ→ℝ\\\"},{\\\"symbol\\\":\\\"v′\\\",\\\"type\\\":\\\"ℝ→ℝ\\\"}],\\\"objects\\\":[\\\"a\\\",\\\"b\\\",\\\"u\\\",\\\"v\\\",\\\"u′\\\",\\\"v′\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"intervalIntegral.integral_deriv_mul_eq_sub_of_hasDerivAt\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.IntervalIntegral.IntegrationByParts\\\",\\\"hypotheses\\\":[\\\"u,v continuous on uIcc(a,b).\\\",\\\"u,v have derivatives u′,v′ on the open interval.\\\",\\\"u′ and v′ interval-integrable.\\\",\\\"ℝ has the complete normed algebra structure required by the theorem.\\\"]}}}]}\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read an explicitly frozen task document by ID; no other local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["id","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Report exact status, location, explanation, basis, partial_progress. SUBSTANTIVE_GAP or SUSPECTED_GAP stops for an actual unsupported mathematical implication; give its premises, conclusion and mathematical grounds. SOURCE_UNAVAILABLE or INPUT_CONFLICT stops for a real source-access/original-input obstacle. Ordinary unfinished drafting, source registration or format work must use TASK_INCOMPLETE: this records progress without ending the stage; continue the actual work. Difficulty or artifact incompletion alone is not a mathematical gap.","parameters":{"type":"object","properties":{"obstacle_json":{"type":"string"}},"required":["obstacle_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"probe_library","description":"Query a proved Mathlib theorem and its exact signature/axioms in the offline sandbox. Returns located evidence for an M source; the mathematical statement and applicability still require review.","parameters":{"type":"object","properties":{"id":{"type":"string"},"declaration":{"type":"string"},"module":{"type":"string"}},"required":["id","declaration","module"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_draft","description":"Read a JSON pointer in your own same-stage candidate after an actual structural check. No other file/stage is accessible; choose a narrow pointer for large objects.","parameters":{"type":"object","properties":{"candidate":{"type":"integer"},"pointer":{"type":"string"}},"required":["candidate","pointer"],"additionalProperties":false},"output_schema":null,"strict":false}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"e88aeaf6-24f8-4b06-b433-dd6