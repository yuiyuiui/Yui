event: response.function_call_arguments.done
data: {"type":"response.function_call_arguments.done","sequence_number":2728,"item_id":"fc_0796b7791cbc62cc016adb275fbcc08191b9cf1099bc8c723a","output_index":1,"arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"full_target\\\":\\\"Let n,m be positive integers; u:R^n×(0,∞)→R^m jointly smooth, q unit. Assume |u|=1, u_tt−Δ_xu=a u, and u=q outside a compact set uniformly on every compact interval. Define e=|u_t|²+Σ|∂_xj u|² and E=∫e dx. Prove e integrable, E differentiable and E'=0 for all r>0.\\\",\\\"conclusion\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"m\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"jointly smooth map R^n×(0,∞)→R^m\\\"},{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"unit vector in R^m\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"For all x,r>0, |u(x,r)|=1.\\\",\\\"origin\\\":\\\"frozen-target.md\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"For all x,r>0 there exists a∈R with u_tt−Δ_xu=a u.\\\",\\\"origin\\\":\\\"frozen-target.md\\\"},{\\\"id\\\":\\\"H003\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), a compact C_J exists with u=q outside C_J throughout J.\\\",\\\"origin\\\":\\\"frozen-target.md\\\"}],\\\"definitions\\\":[{\\\"id\\\":\\\"D001\\\",\\\"symbol\\\":\\\"e\\\",\\\"type\\\":\\\"R^n×(0,∞)→R\\\",\\\"definition\\\":\\\"e=|u_t|²+Σ|∂_xj u|²\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"R^n\\\"},{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"positive real\\\"}],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]},{\\\"id\\\":\\\"D002\\\",\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"positive reals→R\\\",\\\"definition\\\":\\\"E(r)=Lebesgue integral of e(·,r)\\\",\\\"depends_on\\\":[\\\"D001\\\"],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"positive real\\\"}],\\\"objects\\\":[\\\"e\\\"]},{\\\"id\\\":\\\"D003\\\",\\\"symbol\\\":\\\"Δ_x\\\",\\\"type\\\":\\\"operator\\\",\\\"definition\\\":\\\"componentwise sum of second spatial derivatives\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]}],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"calculations\\\":[\\\"Finite-dimensional differentiation and inner-product identities.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"real numbers\\\",\\\"meaning\\\":\\\"Real field and Lebesgue measure.\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"Δ_x\\\"]},{\\\"id\\\":\\\"H003\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"q\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"If X has measurable topology and measurable opens, V normed additive commutative, μ finite on compact sets, and f continuous compactly supported, then f is integrable.\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"X\\\",\\\"type\\\":\\\"measurable topological space\\\"},{\\\"symbol\\\":\\\"V\\\",\\\"type\\\":\\\"normed additive commutative group\\\"},{\\\"symbol\\\":\\\"μ\\\",\\\"type\\\":\\\"measure on X\\\"},{\\\"symbol\\\":\\\"f\\\",\\\"type\\\":\\\"X→V\\\"}],\\\"objects\\\":[\\\"X\\\",\\\"V\\\",\\\"μ\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"Continuous.integrable_of_hasCompactSupport\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Function.LocallyIntegrable\\\",\\\"hypotheses\\\":[\\\"X measurable topological.\\\",\\\"Opens measurable.\\\",\\\"V normed additive commutative.\\\",\\\"μ finite on compact sets.\\\",\\\"f continuous and compactly supported.\\\"]}},{\\\"id\\\":\\\"M002\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For complete real normed V, derivative on uIcc(a,b) and interval-integrable derivative imply interval integral equals f(b)−f(a).\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"V\\\",\\\"type\\\":\\\"complete real normed space\\\"},{\\\"symbol\\\":\\\"a\\\",\\\"type\\\":\\\"real\\\"},{\\\"symbol\\\":\\\"b\\\",\\\"type\\\":\\\"real\\\"},{\\\"symbol\\\":\\\"f\\\",\\\"type\\\":\\\"R→V\\\"},{\\\"symbol\\\":\\\"f′\\\",\\\"type\\\":\\\"R→V\\\"}],\\\"objects\\\":[\\\"V\\\",\\\"a\\\",\\\"b\\\",\\\"f\\\",\\\"f′\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"intervalIntegral.integral_eq_sub_of_hasDerivAt\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus\\\",\\\"hypotheses\\\":[\\\"V complete.\\\",\\\"Derivative on uIcc.\\\",\\\"f′ interval-integrable.\\\"]}},{\\\"id\\\":\\\"M003\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For S-finite measures on measurable α,β, product integrability implies product integral equals iterated integral.\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"α\\\",\\\"type\\\":\\\"measurable space\\\"},{\\\"symbol\\\":\\\"β\\\",\\\"type\\\":\\\"measurable space\\\"},{\\\"symbol\\\":\\\"V\\\",\\\"type\\\":\\\"real normed space\\\"},{\\\"symbol\\\":\\\"μ\\\",\\\"type\\\":\\\"measure\\\"},{\\\"symbol\\\":\\\"ν\\\",\\\"type\\\":\\\"measure\\\"},{\\\"symbol\\\":\\\"f\\\",\\\"type\\\":\\\"α×β→V\\\"}],\\\"objects\\\":[\\\"α\\\",\\\"β\\\",\\\"V\\\",\\\"μ\\\",\\\"ν\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"MeasureTheory.integral_prod\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.Prod\\\",\\\"hypotheses\\\":[\\\"S-finite measures.\\\",\\\"V real normed.\\\",\\\"f product-integrable.\\\"]}},{\\\"id\\\":\\\"M004\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"Continuous functions on compact sets in uniform spaces are uniformly continuous there.\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"α\\\",\\\"type\\\":\\\"uniform space\\\"},{\\\"symbol\\\":\\\"β\\\",\\\"type\\\":\\\"uniform space\\\"},{\\\"symbol\\\":\\\"s\\\",\\\"type\\\":\\\"set\\\"},{\\\"symbol\\\":\\\"f\\\",\\\"type\\\":\\\"function\\\"}],\\\"objects\\\":[\\\"α\\\",\\\"β\\\",\\\"s\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"IsCompact.uniformContinuousOn_of_continuous\\\",\\\"module\\\":\\\"Mathlib.Topology.UniformSpace.HeineCantor\\\",\\\"hypotheses\\\":[\\\"Uniform spaces.\\\",\\\"Compact set.\\\",\\\"Continuous function.\\\"]}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"e\\\",\\\"E\\\",\\\"u\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\",\\\"M004\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\"],\\\"locals\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"positive real\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix r>0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]},{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"compact interval\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Set J=[r/2,3r/2].\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"r\\\"]},{\\\"symbol\\\":\\\"C_J\\\",\\\"type\\\":\\\"compact subset R^n\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose C_J from H003.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"J\\\"]},{\\\"symbol\\\":\\\"B\\\",\\\"type\\\":\\\"closed box containing C_J\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose a closed box containing C_J, which exists since H003 supplies compact C_J.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"C_J\\\"]}],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Fix r>0 and set J=[r/2,3r/2]. H003 supplies compact C_J. Smoothness and constancy imply derivatives vanish off C_J and at its boundary; e is continuous compactly supported, so M001 proves integrability. Choose closed box B containing C_J. M004 gives uniform continuity of e_t on B×J. By M002 each time difference quotient is the interval average of e_t. Uniform convergence and finite measure prove E differentiable and E'(r)=∫_B e_t.\\\",\\\"uses\\\":[\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M004\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r\\\",\\\"J\\\",\\\"C_J\\\",\\\"B\\\",\\\"u\\\",\\\"e\\\",\\\"E\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"Differentiate e. For g_j=u_t·u_j, ∂_j g_j=(∂_j u_t)·u_j+u_t·u_jj, continuous compactly supported and integrable by M001. Coordinate permutation and M003 give Fubini; M002 on an interval containing support gives ∫∂_j g_j=0. Thus E'=2∫u_t·(u_tt−Δu). H001 differentiated gives u·u_t=0; H002 makes acceleration a multiple of u, so integrand vanishes. Therefore E'=0; r arbitrary.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"H002\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"E\\\",\\\"n\\\",\\\"Δ_x\\\",\\\"u_j\\\",\\\"u_jj\\\",\\\"g_j\\\",\\\"r\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[{\\\"id\\\":\\\"A001\\\",\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":\\\"X=R^n; V=R; μ=Lebesgue; f=e(·,r).\\\",\\\"hypothesis_checks\\\":[\\\"X measurable topological.\\\",\\\"Opens measurable.\\\",\\\"V normed additive commutative.\\\",\\\"μ finite on compact sets.\\\",\\\"e continuous compactly supported.\\\"]},{\\\"id\\\":\\\"A002\\\",\\\"input\\\":\\\"M004\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":\\\"α=B×J; β=R; s=B×J; f=e_t.\\\",\\\"hypothesis_checks\\\":[\\\"B×J compact.\\\",\\\"Uniform spaces.\\\",\\\"e_t continuous.\\\"]},{\\\"id\\\":\\\"A003\\\",\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":\\\"V=R; a=r; b=r+h; f=e(x,t); f′=e_t.\\\",\\\"hypothesis_checks\\\":[\\\"R complete.\\\",\\\"Derivative by smoothness.\\\",\\\"Derivative interval-integrable.\\\"]},{\\\"id\\\":\\\"A004\\\",\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"X=R^n; V=R; μ=Lebesgue; f=∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"X measurable topological.\\\",\\\"Opens measurable.\\\",\\\"V normed additive commutative.\\\",\\\"μ finite on compacts.\\\",\\\"Derivative continuous compactly supported.\\\"]},{\\\"id\\\":\\\"A005\\\",\\\"input\\\":\\\"M003\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"α=R^(n−1); β=R; μ,ν Lebesgue; V=R; f=permuted derivative.\\\",\\\"hypothesis_checks\\\":[\\\"Factors measurable and S-finite.\\\",\\\"V real normed.\\\",\\\"Function product-integrable by M001.\\\"]},{\\\"id\\\":\\\"A006\\\",\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"V=R; a=−L; b=L; f=g_j; f′=∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"R complete.\\\",\\\"Derivative holds.\\\",\\\"Derivative interval-integrable.\\\"]}] }]}}\"}"}

