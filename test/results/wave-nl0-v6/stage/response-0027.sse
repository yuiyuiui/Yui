data: {"type":"response.output_item.done","sequence_number":2985,"output_index":2,"item":{"type":"function_call","id":"fc_0796b7791cbc62cc016adb2629a0e88191b8788598acc634f1","call_id":"call_76ec2aa42cf747adb4b95bbc40cc7b9f","name":"submit_artifact","arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"full_target\\\":\\\"Let n,m be positive integers, u:R^n×(0,∞)→R^m jointly smooth, and q a unit vector. Assume |u(x,r)|=1; u_tt−Δ_xu=a u pointwise for some real a; and on every compact time interval u=q outside a compact spatial set uniformly in time. Define e=|u_t|²+Σ|u_xj|² and E=∫R^n e dx. Prove e(·,r) integrable, E differentiable, and E'(r)=0 for every r>0; no endpoint assertion at zero.\\\",\\\"conclusion\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"m\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"jointly smooth map R^n×(0,∞)→R^m\\\"},{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"unit vector in R^m\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"origin\\\":\\\"frozen-target.md:7-10\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt(x,r)-Δ_xu(x,r)=a u(x,r), with componentwise Δ_x.\\\",\\\"origin\\\":\\\"frozen-target.md:11-13\\\"},{\\\"id\\\":\\\"H003\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), there is compact C_J⊂R^n such that u(x,r)=q for x∉C_J and r∈J.\\\",\\\"origin\\\":\\\"frozen-target.md:14-16\\\"}],\\\"definitions\\\":[{\\\"id\\\":\\\"D001\\\",\\\"symbol\\\":\\\"e\\\",\\\"type\\\":\\\"R^n×(0,∞)→R\\\",\\\"definition\\\":\\\"e(x,r)=|u_t(x,r)|²+Σ_{j=1}^n|∂_{x_j}u(x,r)|²\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"R^n\\\"},{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]},{\\\"id\\\":\\\"D002\\\",\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"(0,∞)→R\\\",\\\"definition\\\":\\\"E(r)=Lebesgue integral over R^n of e(x,r)\\\",\\\"depends_on\\\":[\\\"D001\\\"],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"e\\\"]},{\\\"id\\\":\\\"D003\\\",\\\"symbol\\\":\\\"Δ_x\\\",\\\"type\\\":\\\"operator on smooth R^m-valued maps\\\",\\\"definition\\\":\\\"Δ_xu=Σ_{j=1}^n∂²_{x_j}u, componentwise\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]}],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"calculations\\\":[\\\"Finite-dimensional product rule, inner-product identities, finite sums and elementary estimates only; analytic facts are the registered Mathlib inputs.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"real numbers\\\",\\\"meaning\\\":\\\"Real field, topology and Lebesgue measure.\\\"},{\\\"symbol\\\":\\\"R^k\\\",\\\"type\\\":\\\"Euclidean space\\\",\\\"meaning\\\":\\\"Euclidean space with inner product and Lebesgue measure.\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"Δ_x\\\"]},{\\\"id\\\":\\\"H003\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"q\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For any measurable topological space X with measurable opens, normed additive commutative group E, measure μ finite on compact sets, and continuous compactly supported f:X→E, f is integrable.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"X\\\",\\\"E\\\",\\\"μ\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"Continuous.integrable_of_hasCompactSupport\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Function.LocallyIntegrable\\\",\\\"hypotheses\\\":[\\\"X measurable and topological with measurable opens.\\\",\\\"E is a normed additive commutative group.\\\",\\\"μ is finite on compact sets.\\\",\\\"f is continuous.\\\",\\\"f has compact support.\\\"]}},{\\\"id\\\":\\\"M002\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For a complete real normed vector space E and functions f,f′:ℝ→E, if f has derivative f′ on uIcc(a,b) and f′ is interval-integrable between a,b, then its interval integral equals f(b)−f(a).\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"a\\\",\\\"b\\\",\\\"E\\\",\\\"f\\\",\\\"f′\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"intervalIntegral.integral_eq_sub_of_hasDerivAt\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus\\\",\\\"hypotheses\\\":[\\\"E is complete real normed vector space.\\\",\\\"f has derivative f′ at every point of uIcc(a,b).\\\",\\\"f′ is interval-integrable.\\\"]}},{\\\"id\\\":\\\"M003\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For S-finite measures μ,ν on measurable spaces α,β and real normed space E, an integrable function on α×β has product integral equal to its iterated integral, first β then α.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"α\\\",\\\"β\\\",\\\"μ\\\",\\\"ν\\\",\\\"E\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"MeasureTheory.integral_prod\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.Prod\\\",\\\"hypotheses\\\":[\\\"α,β measurable spaces and μ,ν measures.\\\",\\\"μ,ν are S-finite.\\\",\\\"E is a real normed additive commutative group.\\\",\\\"f is integrable for μ.prod ν.\\\"]}},{\\\"id\\\":\\\"M004\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"A continuous function on a compact set in uniform spaces is uniformly continuous on that set.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"s\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"IsCompact.uniformContinuousOn_of_continuous\\\",\\\"module\\\":\\\"Mathlib.Topology.UniformSpace.HeineCantor\\\",\\\"hypotheses\\\":[\\\"α,β uniform spaces.\\\",\\\"s compact.\\\",\\\"f continuous on s.\\\"]}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"e\\\",\\\"E\\\",\\\"u\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\",\\\"M004\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"locals\\\":[{\\\"symbol\\\":\\\"r0\\\",\\\"type\\\":\\\"positive real\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix arbitrary r0>0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]}],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Fix r0>0 and choose a compact interval J about it inside (0,∞). H003 gives compact C_J outside which u=q throughout J. Smoothness implies u_t and each spatial derivative vanish outside C_J and on its boundary by continuity. Thus e(·,r0) is continuous and compactly supported. M001 applies, since Euclidean Lebesgue measure is finite on compact sets and its opens are measurable, proving integrability.\\\",\\\"uses\\\":[\\\"H003\\\",\\\"M001\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\",\\\"J\\\",\\\"C_J\\\",\\\"u\\\",\\\"q\\\",\\\"e\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"Choose a closed box B containing C_J. On B×J, e_t is continuous. This product is compact, so M004 gives uniform continuity of e_t there. For each x∈B, M002 applied to t↦e(x,t) expresses its time difference quotient as the average of e_t on the intervening interval. Uniform continuity makes those quotients converge uniformly in x to e_t(x,r0). The box has finite measure, so the integrals converge as well. Since E(t)=∫_B e(x,t)dt on J, E is differentiable at r0 with derivative ∫_B e_t(x,r0)dx.\\\",\\\"uses\\\":[\\\"M002\\\",\\\"M004\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"B\\\",\\\"J\\\",\\\"e\\\",\\\"E\\\",\\\"r0\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S003\\\",\\\"text\\\":\\\"Differentiation gives e_t=2u_t·u_tt+2Σ_j u_j·∂_j u_t. For each j let g_j=u_t·u_j at time r0; it is smooth and compactly supported. Its derivative is (∂_j u_t)·u_j+u_t·u_jj and is integrable by M001. Identify R^n with R×R^(n−1) by coordinate permutation; Lebesgue measures are S-finite and the coordinate map preserves integrability, so M003 gives Fubini. For fixed remaining coordinates apply M002 to g_j on [−L,L] containing its support; the integral of ∂_j g_j is the zero endpoint difference. Thus ∫(∂_j u_t)·u_j=−∫u_t·u_jj. Summing yields E'(r0)=2∫u_t·(u_tt−Δ_xu). Differentiating H001 gives u·u_t=0; H002 says acceleration is a scalar multiple of u, so the integrand vanishes pointwise. Consequently E'(r0)=0.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"H002\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"E\\\",\\\"n\\\",\\\"Δ_x\\\",\\\"u_j\\\",\\\"u_jj\\\",\\\"g_j\\\",\\\"r0\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S004\\\",\\\"text\\\":\\\"Since r0>0 was arbitrary, all three claims hold for every positive time; no assertion is made at zero.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\",\\\"e\\\",\\\"E\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":\\\"X=R^n; E=R; μ=Lebesgue measure; f(x)=e(x,r0).\\\",\\\"hypothesis_checks\\\":[\\\"R^n is measurable topological and opens are measurable.\\\",\\\"R is a normed additive commutative group.\\\",\\\"Lebesgue measure is finite on compact sets.\\\",\\\"e is continuous by smoothness.\\\",\\\"e is supported in C_J.\\\"]},{\\\"input\\\":\\\"M004\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"α=B×J; β=R; s=B×J; f(x,t)=e_t(x,t).\\\",\\\"hypothesis_checks\\\":[\\\"B×J is compact.\\\",\\\"Both spaces are uniform spaces.\\\",\\\"e_t is continuous.\\\"]},{\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"E=R; a=r0; b=r0+h; f(t)=e(x,t); f′(t)=e_t(x,t).\\\",\\\"hypothesis_checks\\\":[\\\"R is complete.\\\",\\\"Derivative is e_t by smoothness.\\\",\\\"Continuous derivative is interval-integrable on compact interval.\\\"]},{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":\\\"X=R^n; E=R; μ=Lebesgue measure; f=∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"R^n has measurable opens.\\\",\\\"R is normed additive commutative.\\\",\\\"Lebesgue measure finite on compact sets.\\\",\\\"Derivative continuous.\\\",\\\"Derivative compactly supported.\\\"]},{\\\"input\\\":\\\"M003\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":\\\"α=R^(n−1); β=R; μ,ν Lebesgue; E=R; f=coordinate permutation of ∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"Euclidean factors measurable.\\\",\\\"Lebesgue measures are S-finite.\\\",\\\"R is a real normed space.\\\",\\\"Integrability follows from M001 and coordinate identification.\\\"]},{\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":\\\"E=R; a=−L; b=L; f(s)=g_j with x_j=s; f′=∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"R is complete.\\\",\\\"Derivative follows from smoothness.\\\",\\\"Continuous compactly supported derivative is interval-integrable.\\\"]}]}]}}\"}","status":"completed"}}

