data: {"type":"response.function_call_arguments.done","sequence_number":2907,"item_id":"fc_0796b7791cbc62cc016adb26c20f1c81919ce71b2d30d8195f","output_index":1,"arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"full_target\\\":\\\"Let n,m be positive integers; u:R^n×(0,∞)→R^m jointly smooth, q unit. Assume |u|=1, u_tt−Δ_xu=a u pointwise and u=q outside a compact set uniformly on every compact time interval. Set e=|u_t|²+Σ|∂_xj u|², E=∫R^n e dx. Prove e(·,r) integrable, E differentiable, E'(r)=0 for r>0.\\\",\\\"conclusion\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"m\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"jointly smooth map R^n×(0,∞)→R^m\\\"},{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"unit vector in R^m\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"origin\\\":\\\"frozen-target.md:7-10\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt−Δ_xu=a u, componentwise.\\\",\\\"origin\\\":\\\"frozen-target.md:11-13\\\"},{\\\"id\\\":\\\"H003\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), compact C_J⊂R^n exists with u(x,r)=q whenever x∉C_J and r∈J.\\\",\\\"origin\\\":\\\"frozen-target.md:14-16\\\"}],\\\"definitions\\\":[{\\\"id\\\":\\\"D001\\\",\\\"symbol\\\":\\\"e\\\",\\\"type\\\":\\\"R^n×(0,∞)→R\\\",\\\"definition\\\":\\\"e(x,r)=|u_t|²+Σ|∂_xj u|²\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"R^n\\\"},{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]},{\\\"id\\\":\\\"D002\\\",\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"(0,∞)→R\\\",\\\"definition\\\":\\\"E(r)=Lebesgue integral over R^n of e(x,r)\\\",\\\"depends_on\\\":[\\\"D001\\\"],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"e\\\"]},{\\\"id\\\":\\\"D003\\\",\\\"symbol\\\":\\\"Δ_x\\\",\\\"type\\\":\\\"operator\\\",\\\"definition\\\":\\\"Δ_xu=Σ∂²_xj u componentwise\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]}],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"calculations\\\":[\\\"Finite-dimensional product rule and inner-product identities; registered sources supply analytic facts.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"real numbers\\\",\\\"meaning\\\":\\\"Real field with topology and Lebesgue measure.\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"Δ_x\\\"]},{\\\"id\\\":\\\"H003\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"q\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For measurable topological X with measurable opens, normed additive commutative V, measure μ finite on compact sets, continuous compactly supported f:X→V is integrable.\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"X\\\",\\\"type\\\":\\\"measurable topological space\\\"},{\\\"symbol\\\":\\\"V\\\",\\\"type\\\":\\\"normed additive commutative group\\\"},{\\\"symbol\\\":\\\"μ\\\",\\\"type\\\":\\\"measure on X\\\"},{\\\"symbol\\\":\\\"f\\\",\\\"type\\\":\\\"X→V\\\"}],\\\"objects\\\":[\\\"X\\\",\\\"V\\\",\\\"μ\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"Continuous.integrable_of_hasCompactSupport\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Function.LocallyIntegrable\\\",\\\"hypotheses\\\":[\\\"Measurable topological X, measurable opens.\\\",\\\"V normed additive commutative.\\\",\\\"μ finite on compacts.\\\",\\\"f continuous and compactly supported.\\\"]}},{\\\"id\\\":\\\"M002\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For complete real normed V, derivative f′ on uIcc(a,b) and interval-integrable f′ imply interval integral f′=f(b)−f(a).\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"V\\\",\\\"type\\\":\\\"complete real normed space\\\"},{\\\"symbol\\\":\\\"a\\\",\\\"type\\\":\\\"real\\\"},{\\\"symbol\\\":\\\"b\\\",\\\"type\\\":\\\"real\\\"},{\\\"symbol\\\":\\\"f\\\",\\\"type\\\":\\\"R→V\\\"},{\\\"symbol\\\":\\\"f′\\\",\\\"type\\\":\\\"R→V\\\"}],\\\"objects\\\":[\\\"V\\\",\\\"a\\\",\\\"b\\\",\\\"f\\\",\\\"f′\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"intervalIntegral.integral_eq_sub_of_hasDerivAt\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus\\\",\\\"hypotheses\\\":[\\\"V complete.\\\",\\\"f has derivative f′ on uIcc(a,b).\\\",\\\"f′ interval-integrable.\\\"]}},{\\\"id\\\":\\\"M003\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For S-finite measures on measurable α,β and real normed V, integrability on α×β implies product integral equals iterated integral.\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"α\\\",\\\"type\\\":\\\"measurable space\\\"},{\\\"symbol\\\":\\\"β\\\",\\\"type\\\":\\\"measurable space\\\"},{\\\"symbol\\\":\\\"V\\\",\\\"type\\\":\\\"real normed space\\\"},{\\\"symbol\\\":\\\"μ\\\",\\\"type\\\":\\\"measure on α\\\"},{\\\"symbol\\\":\\\"ν\\\",\\\"type\\\":\\\"measure on β\\\"},{\\\"symbol\\\":\\\"f\\\",\\\"type\\\":\\\"α×β→V\\\"}],\\\"objects\\\":[\\\"α\\\",\\\"β\\\",\\\"V\\\",\\\"μ\\\",\\\"ν\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"MeasureTheory.integral_prod\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.Prod\\\",\\\"hypotheses\\\":[\\\"Measurable spaces and S-finite measures.\\\",\\\"V real normed.\\\",\\\"f product-integrable.\\\"]}},{\\\"id\\\":\\\"M004\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"A continuous function on a compact set in uniform spaces is uniformly continuous there.\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"α\\\",\\\"type\\\":\\\"uniform space\\\"},{\\\"symbol\\\":\\\"β\\\",\\\"type\\\":\\\"uniform space\\\"},{\\\"symbol\\\":\\\"s\\\",\\\"type\\\":\\\"set of α\\\"},{\\\"symbol\\\":\\\"f\\\",\\\"type\\\":\\\"α→β\\\"}],\\\"objects\\\":[\\\"α\\\",\\\"β\\\",\\\"s\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"IsCompact.uniformContinuousOn_of_continuous\\\",\\\"module\\\":\\\"Mathlib.Topology.UniformSpace.HeineCantor\\\",\\\"hypotheses\\\":[\\\"Uniform spaces α,β.\\\",\\\"s compact.\\\",\\\"f continuous on s.\\\"]}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"e\\\",\\\"E\\\",\\\"u\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\",\\\"M004\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"locals\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"positive real\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix arbitrary r>0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]},{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"compact interval around r contained in (0,∞)\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose such an interval around r.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"r\\\"]},{\\\"symbol\\\":\\\"C_J\\\",\\\"type\\\":\\\"compact subset of R^n\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose C_J from H003.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"J\\\"]},{\\\"symbol\\\":\\\"B\\\",\\\"type\\\":\\\"closed box containing C_J\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose a closed box containing C_J.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"C_J\\\",\\\"n\\\"]}],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Fix r>0, choose compact interval J around it and C_J by H003. Smoothness and constancy imply all derivatives vanish outside C_J and at its boundary, so e is continuous compactly supported. M001 yields integrability. Choose box B containing C_J. e_t is continuous on compact B×J; M004 gives uniform continuity. M002 gives the time difference quotient as the interval average of e_t. The averages converge uniformly on B; finite measure gives convergence of integrals, proving E differentiable and E'(r)=∫_B e_t.\\\",\\\"uses\\\":[\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M004\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r\\\",\\\"J\\\",\\\"C_J\\\",\\\"B\\\",\\\"u\\\",\\\"q\\\",\\\"e\\\",\\\"E\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"Differentiate e to obtain 2u_t·u_tt+2Σu_j·∂_j u_t. For g_j=u_t·u_j, smooth compact support gives ∂_j g_j=(∂_j u_t)·u_j+u_t·u_jj, integrable by M001. Coordinate permutation and M003 give Fubini; M002 on an interval containing support gives ∫∂_j g_j=0. Hence E'(r)=2∫u_t·(u_tt−Δ_xu). H001 differentiated yields u·u_t=0; H002 gives acceleration=a u, so integrand is zero. Thus E'(r)=0. Since r arbitrary the theorem follows.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"H002\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"E\\\",\\\"n\\\",\\\"Δ_x\\\",\\\"u_j\\\",\\\"u_jj\\\",\\\"g_j\\\",\\\"r\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[{\\\"id\\\":\\\"A001\\\",\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":\\\"X=R^n; V=R; μ=Lebesgue; f=e(·,r).\\\",\\\"hypothesis_checks\\\":[\\\"Measurable Euclidean space with measurable opens.\\\",\\\"R normed additive commutative.\\\",\\\"Lebesgue finite on compact sets.\\\",\\\"e continuous.\\\",\\\"e compactly supported.\\\"]},{\\\"id\\\":\\\"A002\\\",\\\"input\\\":\\\"M004\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":\\\"α=B×J; β=R; s=B×J; f=e_t.\\\",\\\"hypothesis_checks\\\":[\\\"B×J compact.\\\",\\\"Uniform spaces.\\\",\\\"e_t continuous.\\\"]},{\\\"id\\\":\\\"A003\\\",\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":\\\"V=R; a=r; b=r+h; f(t)=e(x,t); f′=e_t.\\\",\\\"hypothesis_checks\\\":[\\\"R complete.\\\",\\\"Derivative by smoothness.\\\",\\\"Continuous derivative interval-integrable.\\\"]},{\\\"id\\\":\\\"A004\\\",\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"X=R^n; V=R; μ=Lebesgue; f=∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"Measurable Euclidean space.\\\",\\\"R normed additive commutative.\\\",\\\"Lebesgue finite on compact sets.\\\",\\\"Derivative continuous and compactly supported.\\\",\\\"Support compact.\\\"]},{\\\"id\\\":\\\"A005\\\",\\\"input\\\":\\\"M003\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"α=R^(n−1); β=R; μ,ν Lebesgue; V=R; f=coordinate permutation of ∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"Euclidean factors measurable.\\\",\\\"Lebesgue measures S-finite.\\\",\\\"R real normed.\\\",\\\"Function integrable by M001 and coordinate identification.\\\"]},{\\\"id\\\":\\\"A006\\\",\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"V=R; a=−L; b=L; f(s)=g_j; f′=∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"R complete.\\\",\\\"Derivative by smoothness.\\\",\\\"Derivative continuous compactly supported and interval-integrable.\\\"]}] }]}}\"}"}

