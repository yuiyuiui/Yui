data: {"type":"response.output_item.done","sequence_number":3111,"output_index":2,"item":{"type":"function_call","id":"fc_0796b7791cbc62cc016adb26531e008191a7d37bcb5fa5d770","call_id":"call_7a521728c26648d3b7dcaf3104053265","name":"check_artifact","arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"full_target\\\":\\\"Let n,m be positive integers; u:R^n×(0,∞)→R^m jointly smooth and q∈R^m unit. Assume |u|=1, u_tt−Δ_xu=a u pointwise for some real a, and for every compact time interval J, u=q outside a compact C_J uniformly on J. Define e=|u_t|²+Σ|∂_xj u|² and E=∫R^n e dx. Prove e(·,r) is Lebesgue integrable, E differentiable, and E'(r)=0 for each r>0; no endpoint assertion at 0.\\\",\\\"conclusion\\\":\\\"For every r>0, e(·,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"m\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"jointly smooth map R^n×(0,∞)→R^m\\\"},{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"unit vector in R^m\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"origin\\\":\\\"frozen-target.md:7-10\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt(x,r)-Δ_xu(x,r)=a u(x,r), with componentwise Δ_x.\\\",\\\"origin\\\":\\\"frozen-target.md:11-13\\\"},{\\\"id\\\":\\\"H003\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), there is compact C_J⊂R^n such that u(x,r)=q for x∉C_J and r∈J.\\\",\\\"origin\\\":\\\"frozen-target.md:14-16\\\"}],\\\"definitions\\\":[{\\\"id\\\":\\\"D001\\\",\\\"symbol\\\":\\\"e\\\",\\\"type\\\":\\\"R^n×(0,∞)→R\\\",\\\"definition\\\":\\\"e(x,r)=|u_t(x,r)|²+Σ_{j=1}^n|∂_{x_j}u(x,r)|²\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"R^n\\\"},{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]},{\\\"id\\\":\\\"D002\\\",\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"(0,∞)→R\\\",\\\"definition\\\":\\\"E(r)=Lebesgue integral over R^n of e(x,r)\\\",\\\"depends_on\\\":[\\\"D001\\\"],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"e\\\"]},{\\\"id\\\":\\\"D003\\\",\\\"symbol\\\":\\\"Δ_x\\\",\\\"type\\\":\\\"operator on smooth R^m-valued maps\\\",\\\"definition\\\":\\\"Δ_xu=Σ_{j=1}^n∂²_{x_j}u, componentwise\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]}],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"calculations\\\":[\\\"Finite-dimensional product-rule and inner-product identities and finite sums; analytic facts are registered Mathlib propositions.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"real numbers\\\",\\\"meaning\\\":\\\"Real field, topology and Lebesgue measure.\\\"},{\\\"symbol\\\":\\\"R^k\\\",\\\"type\\\":\\\"Euclidean space\\\",\\\"meaning\\\":\\\"Euclidean space with inner product and Lebesgue measure.\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"Δ_x\\\"]},{\\\"id\\\":\\\"H003\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"q\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For any measurable topological space X with measurable opens, normed additive commutative group E, measure μ finite on compact sets, continuous compactly supported f:X→E is integrable.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"X\\\",\\\"E\\\",\\\"μ\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"Continuous.integrable_of_hasCompactSupport\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Function.LocallyIntegrable\\\",\\\"hypotheses\\\":[\\\"X measurable topological with measurable opens.\\\",\\\"E normed additive commutative group.\\\",\\\"μ finite on compact sets.\\\",\\\"f continuous.\\\",\\\"f compactly supported.\\\"]}},{\\\"id\\\":\\\"M002\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For complete real normed E, if f has derivative f′ on uIcc(a,b) and f′ is interval-integrable between a,b, then ∫ f′=f(b)−f(a).\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"a\\\",\\\"b\\\",\\\"E\\\",\\\"f\\\",\\\"f′\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"intervalIntegral.integral_eq_sub_of_hasDerivAt\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus\\\",\\\"hypotheses\\\":[\\\"E complete real normed vector space.\\\",\\\"f has derivative f′ on uIcc(a,b).\\\",\\\"f′ interval-integrable.\\\"]}},{\\\"id\\\":\\\"M003\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For S-finite measures μ,ν on measurable α,β and real normed E, an integrable f on α×β has product integral equal to iterated integral, first β then α.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"α\\\",\\\"β\\\",\\\"μ\\\",\\\"ν\\\",\\\"E\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"MeasureTheory.integral_prod\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.Prod\\\",\\\"hypotheses\\\":[\\\"α,β measurable; μ,ν measures.\\\",\\\"μ,ν S-finite.\\\",\\\"E real normed space.\\\",\\\"f integrable for product measure.\\\"]}},{\\\"id\\\":\\\"M004\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"A continuous function on a compact set in uniform spaces is uniformly continuous on that set.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"s\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"IsCompact.uniformContinuousOn_of_continuous\\\",\\\"module\\\":\\\"Mathlib.Topology.UniformSpace.HeineCantor\\\",\\\"hypotheses\\\":[\\\"α,β uniform spaces.\\\",\\\"s compact.\\\",\\\"f continuous on s.\\\"]}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"e\\\",\\\"E\\\",\\\"u\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\",\\\"M004\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"locals\\\":[{\\\"symbol\\\":\\\"r0\\\",\\\"type\\\":\\\"positive real\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix arbitrary r0>0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]},{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"compact interval around r0 in (0,∞)\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose a compact interval around r0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"r0\\\"]},{\\\"symbol\\\":\\\"C_J\\\",\\\"type\\\":\\\"compact subset R^n\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose the compact set from H003.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"J\\\"]},{\\\"symbol\\\":\\\"B\\\",\\\"type\\\":\\\"closed box containing C_J\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose a closed box containing C_J.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"C_J\\\",\\\"n\\\"]}],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Fix arbitrary r0>0 and choose a compact interval J with r0 interior and J⊂(0,∞). H003 supplies C_J. Smoothness and constancy off C_J show u_t and spatial derivatives vanish outside C_J; continuity gives boundary vanishing. Thus e(·,r0) is continuous and compactly supported. Apply M001 to establish its integrability. The same argument and M001 give integrability of every continuous compactly supported scalar function used below.\\\",\\\"uses\\\":[\\\"H003\\\",\\\"M001\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\",\\\"J\\\",\\\"C_J\\\",\\\"u\\\",\\\"q\\\",\\\"e\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"Take a closed box B containing C_J. e_t is continuous on compact B×J. M004 gives its uniform continuity there. For each x∈B, M002 applied to t↦e(x,t) expresses its difference quotient as the interval average of e_t; derivative and interval integrability follow from smoothness. Uniform continuity gives uniform convergence of these quotients in x to e_t(x,r0). Since B has finite measure, their integrals converge. E(t)=∫_B e(x,t)dt on J, so E is differentiable at r0 and E'(r0)=∫_B e_t(x,r0)dx.\\\",\\\"uses\\\":[\\\"M002\\\",\\\"M004\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"B\\\",\\\"J\\\",\\\"e\\\",\\\"E\\\",\\\"r0\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S003\\\",\\\"text\\\":\\\"Differentiate e to obtain e_t=2u_t·u_tt+2Σ_j u_j·∂_j u_t. For each j, g_j=u_t·u_j is smooth compactly supported, with ∂_j g_j=(∂_j u_t)·u_j+u_t·u_jj. Its derivative is integrable by the compact-support result above. Identify R^n=R^(n−1)×R by coordinate permutation; Lebesgue product measures are S-finite and the coordinate identification preserves integrability. M003 therefore yields Fubini. For each fixed remaining coordinate, M002 on [−L,L] containing the support gives integral ∂_j g_j=0 by the zero endpoint values. Therefore ∫(∂_j u_t)·u_j=−∫u_t·u_jj. Summing gives E'(r0)=2∫u_t·(u_tt−Δ_xu). Differentiating H001 gives u·u_t=0, and H002 makes acceleration a scalar multiple of u. Thus the integrand vanishes pointwise and E'(r0)=0.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"H002\\\",\\\"M002\\\",\\\"M003\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"E\\\",\\\"n\\\",\\\"Δ_x\\\",\\\"u_j\\\",\\\"u_jj\\\",\\\"g_j\\\",\\\"r0\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S004\\\",\\\"text\\\":\\\"r0 was arbitrary positive; hence all conclusions hold for every r>0, with no assertion at zero.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\",\\\"e\\\",\\\"E\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[{\\\"id\\\":\\\"A001\\\",\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":\\\"X=R^n; E=R; μ=Lebesgue measure; f=e(·,r0), and arbitrary continuous compactly supported scalar functions in the local consequence.\\\",\\\"hypothesis_checks\\\":[\\\"R^n is measurable topological with measurable opens.\\\",\\\"R is normed additive commutative.\\\",\\\"Lebesgue measure is finite on compact sets.\\\",\\\"e and the later scalar test functions are continuous.\\\",\\\"They have compact support.\\\"]},{\\\"id\\\":\\\"A002\\\",\\\"input\\\":\\\"M004\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"α=B×J; β=R; s=B×J; f=e_t.\\\",\\\"hypothesis_checks\\\":[\\\"B×J is compact.\\\",\\\"B×J and R are uniform spaces.\\\",\\\"e_t is continuous.\\\"]},{\\\"id\\\":\\\"A003\\\",\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":\\\"E=R; a=r0; b=r0+h; f(t)=e(x,t); f′(t)=e_t(x,t).\\\",\\\"hypothesis_checks\\\":[\\\"R is complete real normed.\\\",\\\"Derivative is e_t by smoothness.\\\",\\\"Continuous derivative is interval-integrable on the compact interval.\\\"]},{\\\"id\\\":\\\"A004\\\",\\\"input\\\":\\\"M003\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":\\\"α=R^(n−1); β=R; μ,ν Lebesgue; E=R; f=coordinate-permuted ∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"Euclidean factors are measurable.\\\",\\\"Lebesgue measures are S-finite.\\\",\\\"R is real normed.\\\",\\\"Integrability follows from compact support and M001; coordinate permutation preserves it.\\\"]},{\\\"id\\\":\\\"A005\\\",\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":\\\"E=R; a=−L; b=L; f(s)=g_j with x_j=s; f′=∂_j g_j.\\\",\\\"hypothesis_checks\\\":[\\\"R is complete.\\\",\\\"Derivative follows from smoothness.\\\",\\\"Continuous compactly supported derivative is interval-integrable.\\\"]}] }]}}\"}","status":"completed"}}

