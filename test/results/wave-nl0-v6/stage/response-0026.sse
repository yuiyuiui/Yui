json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"full_target\\\":\\\"Let n,m be positive integers. Let u:R^n times (0,infinity) -> R^m be jointly smooth, and let q in R^m have Euclidean norm one. Assume: for every x and t>0, |u(x,t)|=1; at each (x,t), u_tt-Delta_x u=a(x,t)u for some real a; and on every compact interval J contained in (0,infinity), u(x,t)=q outside a compact C_J, uniformly for t in J. Define e(x,t)=|u_t|^2+sum_j|partial_(x_j)u|^2 and E(t)=integral_R^n e(x,t) dx with Lebesgue measure. Prove e(.,t) integrable for each t>0, E differentiable at every t>0, and E'(t)=0. No endpoint assertion at 0.\\\",\\\"conclusion\\\":\\\"For every r>0, e(.,r) is Lebesgue integrable, E is differentiable at r, and E'(r)=0.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"m\\\",\\\"type\\\":\\\"positive integer\\\"},{\\\"symbol\\\":\\\"u\\\",\\\"type\\\":\\\"jointly smooth map R^n×(0,∞)→R^m\\\"},{\\\"symbol\\\":\\\"q\\\",\\\"type\\\":\\\"unit vector in R^m\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"For all x∈R^n and r>0, |u(x,r)|=1.\\\",\\\"origin\\\":\\\"frozen-target.md:7-10\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"For all x∈R^n,r>0 there exists a∈R such that u_tt(x,r)-Δ_xu(x,r)=a u(x,r), with componentwise Δ_x.\\\",\\\"origin\\\":\\\"frozen-target.md:11-13\\\"},{\\\"id\\\":\\\"H003\\\",\\\"statement\\\":\\\"For each compact interval J⊂(0,∞), there is compact C_J⊂R^n such that u(x,r)=q for x∉C_J and r∈J.\\\",\\\"origin\\\":\\\"frozen-target.md:14-16\\\"}],\\\"definitions\\\":[{\\\"id\\\":\\\"D001\\\",\\\"symbol\\\":\\\"e\\\",\\\"type\\\":\\\"R^n×(0,∞)→R\\\",\\\"definition\\\":\\\"e(x,r)=|u_t(x,r)|²+Σ_{j=1}^n|∂_{x_j}u(x,r)|²\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"R^n\\\"},{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]},{\\\"id\\\":\\\"D002\\\",\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"(0,∞)→R\\\",\\\"definition\\\":\\\"E(r)=Lebesgue integral over R^n of e(x,r)\\\",\\\"depends_on\\\":[\\\"D001\\\"],\\\"requires\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"r\\\",\\\"type\\\":\\\"(0,∞)\\\"}],\\\"objects\\\":[\\\"e\\\"]},{\\\"id\\\":\\\"D003\\\",\\\"symbol\\\":\\\"Δ_x\\\",\\\"type\\\":\\\"operator on smooth R^m-valued maps\\\",\\\"definition\\\":\\\"Δ_xu=Σ_{j=1}^n∂²_{x_j}u, componentwise\\\",\\\"depends_on\\\":[],\\\"requires\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"n\\\"]}],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"calculations\\\":[\\\"Finite-dimensional inner-product, product-rule and finite-sum differentiation identities; elementary interval estimates. Compact-support integrability, FTC, compact uniform continuity and product Fubini are used only through the explicitly registered Mathlib propositions.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"real numbers\\\",\\\"meaning\\\":\\\"Real field, topology and Lebesgue measure.\\\"},{\\\"symbol\\\":\\\"R^k\\\",\\\"type\\\":\\\"Euclidean space\\\",\\\"meaning\\\":\\\"Euclidean space with inner product and Lebesgue measure.\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"wave-map-energy\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"Δ_x\\\"]},{\\\"id\\\":\\\"H003\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"q\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For any measurable space X with topology whose open sets are measurable, normed additive commutative group E, measure μ finite on compact sets, and continuous f:X→E with compact support, f is integrable with respect to μ.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"X\\\",\\\"E\\\",\\\"μ\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"Continuous.integrable_of_hasCompactSupport\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Function.LocallyIntegrable\\\",\\\"hypotheses\\\":[\\\"X has measurable space and topological space; opens are measurable.\\\",\\\"E is a normed additive commutative group.\\\",\\\"μ is finite on compact sets.\\\",\\\"f:X→E is continuous.\\\",\\\"f has compact support.\\\"]}},{\\\"id\\\":\\\"M002\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"For a complete real normed vector space E, real a,b and functions f,f′:ℝ→E, if for every x in uIcc(a,b), f has derivative f′(x) at x and f′ is interval-integrable between a and b, then ∫ x in a..b f′(x)=f(b)-f(a).\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"a\\\",\\\"b\\\",\\\"E\\\",\\\"f\\\",\\\"f′\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"intervalIntegral.integral_eq_sub_of_hasDerivAt\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus\\\",\\\"hypotheses\\\":[\\\"E is a complete real normed vector space.\\\",\\\"For all x∈uIcc(a,b), HasDerivAt f (f′ x) x.\\\",\\\"f′ is interval-integrable on the interval from a to b.\\\"]}},{\\\"id\\\":\\\"M003\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"If α,β are measurable spaces with S-finite measures μ,ν and E is a real normed space, then for integrable f:α×β→E, its product integral equals the iterated integral, integrating first in β and then in α.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"α\\\",\\\"β\\\",\\\"μ\\\",\\\"ν\\\",\\\"E\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"MeasureTheory.integral_prod\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.Prod\\\",\\\"hypotheses\\\":[\\\"α and β are measurable spaces; μ,ν are measures.\\\",\\\"μ and ν are S-finite.\\\",\\\"E is a real normed additive commutative normed space.\\\",\\\"f is integrable with respect to μ.prod ν.\\\"]}},{\\\"id\\\":\\\"M004\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"If s is compact in a uniform space α, β is a uniform space, and f:α→β is continuous on s, then f is uniformly continuous on s.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"s\\\",\\\"f\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"IsCompact.uniformContinuousOn_of_continuous\\\",\\\"module\\\":\\\"Mathlib.Topology.UniformSpace.HeineCantor\\\",\\\"hypotheses\\\":[\\\"α,β are uniform spaces.\\\",\\\"s is compact.\\\",\\\"f is continuous on s.\\\"]}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"binders\\\":[],\\\"objects\\\":[\\\"e\\\",\\\"E\\\",\\\"u\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\",\\\"M004\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[\\\"D001\\\",\\\"D002\\\",\\\"D003\\\"],\\\"rules\\\":[\\\"direct\\\",\\\"forall_introduction\\\",\\\"exists_elimination\\\"],\\\"locals\\\":[{\\\"symbol\\\":\\\"r0\\\",\\\"type\\\":\\\"positive real number\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Fix arbitrary r0>0.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[]},{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"compact interval in (0,∞) with r0 in its interior\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose J from F001.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[\\\"F001\\\"],\\\"objects\\\":[\\\"r0\\\"]},{\\\"symbol\\\":\\\"C_J\\\",\\\"type\\\":\\\"compact subset of R^n\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose compact support set from H003.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"J\\\"]},{\\\"symbol\\\":\\\"B\\\",\\\"type\\\":\\\"closed box in R^n containing C_J\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S004\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose a sufficiently large closed box containing the compact set C_J.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"C_J\\\",\\\"n\\\"]},{\\\"symbol\\\":\\\"h\\\",\\\"type\\\":\\\"nonzero real increment sufficiently small that r0+h∈J\\\",\\\"scope\\\":\\\"R001/argument\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S002\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Take h tending to zero with r0+h∈J.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"r0\\\",\\\"J\\\"]}],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Fix arbitrary r0>0. Choose δ with 0<δ<r0 and set J=[r0−δ,r0+δ]. This is a compact interval contained in (0,∞) with r0 interior; record this as F001.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\"],\\\"produces\\\":[{\\\"id\\\":\\\"F001\\\",\\\"statement\\\":\\\"There exists a compact interval J⊂(0,∞) with r0 in its interior.\\\",\\\"binders\\\":[],\\\"objects\\\":[\\\"r0\\\"],\\\"assumptions\\\":[]}],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"Choose J by F001, and apply H003 to obtain C_J. On the exterior of C_J the function u is constant q on J, so its time derivative is zero in the interior of J; its spatial derivatives vanish on the open exterior and, by continuity, on the boundary. Thus e(·,t) is continuous and supported in C_J for t∈J. Apply M001 to e(·,r0): Euclidean Lebesgue space has measurable opens and measure finite on compact sets; R is a normed additive commutative group. This proves integrability. Choose a closed box B containing C_J. On B×J, e_t is continuous. The product is compact, so M004 applied to e_t gives uniform continuity there. For fixed x∈B, M002 applied to t↦e(x,t), with derivative e_t(x,t), gives the difference quotient as the oriented interval average of e_t. Continuity gives interval integrability and differentiability. Uniform continuity implies these quotients converge uniformly in x to e_t(x,r0). Since B has finite Lebesgue measure, their integrals converge to ∫_B e_t(x,r0)dx, proving E differentiable at r0 and E'(r0)=∫_B e_t(x,r0)dx.\\\",\\\"uses\\\":[\\\"H003\\\",\\\"M001\\\",\\\"M002\\\",\\\"M004\\\"],\\\"uses_local\\\":[\\\"F001\\\"],\\\"objects\\\":[\\\"J\\\",\\\"C_J\\\",\\\"B\\\",\\\"u\\\",\\\"q\\\",\\\"e\\\",\\\"E\\\",\\\"r0\\\",\\\"h\\\",\\\"e_t\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S003\\\",\\\"text\\\":\\\"Differentiate the finite sum defining e to get e_t=2u_t·u_tt+2Σ_j u_j·∂_j u_t. For each j put g_j(x)=u_t(x,r0)·u_j(x,r0). It is smooth with compact support in C_J and ∂_j g_j=(∂_j u_t)·u_j+u_t·u_jj. The derivative is continuous and compactly supported, hence integrable by M001. Identify R^n with R×R^(n−1) by the coordinate permutation; the product Lebesgue measures are S-finite, and the coordinate identification preserves Lebesgue integration, so M003 applies to this integrable function. Fubini reduces its integral to integrating first along x_j. For each fixed remaining coordinate, M002 on a finite interval containing the support of g_j says the integral of ∂_j g_j is the endpoint difference, zero. Therefore ∫(∂_j u_t)·u_j=−∫u_t·u_jj. Summing gives E'(r0)=2∫u_t·(u_tt−Δ_xu). Differentiating H001 in time yields u·u_t=0. H002 says the acceleration is a scalar multiple of u, so pointwise u_t·(u_tt−Δ_xu)=0. The integrand is continuous and supported in C_J; its integral is zero. Hence E'(r0)=0.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"H002\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"u\\\",\\\"E\\\",\\\"n\\\",\\\"Δ_x\\\",\\\"u_j\\\",\\\"u_jj\\\",\\\"g_j\\\",\\\"r0\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S004\\\",\\\"text\\\":\\\"Because r0>0 was arbitrary, the integrability, differentiability and zero derivative established above hold at every positive time. No assertion at r=0 is made.\\\",\\\"uses\\\":[],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"r0\\\",\\\"e\\\",\\\"E\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{\\\"X\\\":\\\"R^n\\\",\\\"E\\\":\\\"R\\\",\\\"μ\\\":\\\"Lebesgue measure\\\",\\\"f\\\":\\\"x↦e(x,r0)\\\"},\\\"hypothesis_checks\\\":[\\\"R^n has its Lebesgue measurable space and opens are measurable.\\\",\\\"R is a normed additive commutative group.\\\",\\\"Lebesgue measure is finite on compact sets.\\\",\\\"e(·,r0) is continuous by smoothness.\\\",\\\"Its support lies in compact C_J.\\\"]},{\\\"input\\\":\\\"M004\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{\\\"α\\\":\\\"B×J\\\",\\\"β\\\":\\\"R\\\",\\\"s\\\":\\\"B×J\\\",\\\"f\\\":\\\"(x,t)↦e_t(x,t)\\\"},\\\"hypothesis_checks\\\":[\\\"B×J is compact as a product of compact sets.\\\",\\\"B×J and R carry their usual uniform structures.\\\",\\\"e_t is continuous by smoothness.\\\"]},{\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{\\\"E\\\":\\\"R\\\",\\\"a\\\":\\\"r0\\\",\\\"b\\\":\\\"r0+h\\\",\\\"f\\\":\\\"t↦e(x,t)\\\",\\\"f′\\\":\\\"t↦e_t(x,t)\\\"},\\\"hypothesis_checks\\\":[\\\"R is a complete real normed vector space.\\\",\\\"The derivative is e_t by smoothness.\\\",\\\"Continuous e_t is interval-integrable on the compact interval between the endpoints.\\\"]},{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{\\\"X\\\":\\\"R^n\\\",\\\"E\\\":\\\"R\\\",\\\"μ\\\":\\\"Lebesgue measure\\\",\\\"f\\\":\\\"x↦∂_j g_j(x)\\\"},\\\"hypothesis_checks\\\":[\\\"R^n has measurable opens.\\\",\\\"R is a normed additive commutative group.\\\",\\\"Lebesgue measure is finite on compact sets.\\\",\\\"The derivative is continuous and compactly supported.\\\",\\\"Its support is contained in C_J.\\\"]},{\\\"input\\\":\\\"M003\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{\\\"α\\\":\\\"R^(n−1)\\\",\\\"β\\\":\\\"R\\\",\\\"μ\\\":\\\"Lebesgue measure\\\",\\\"ν\\\":\\\"Lebesgue measure\\\",\\\"E\\\":\\\"R\\\",\\\"f\\\":\\\"coordinate-permuted function x↦∂_j g_j(x)\\\"},\\\"hypothesis_checks\\\":[\\\"The Euclidean factors carry their Lebesgue measurable spaces.\\\",\\\"Finite-dimensional Lebesgue measures are S-finite.\\\",\\\"R is a real normed space.\\\",\\\"The function is integrable by M001 and the coordinate permutation preserves Lebesgue integrability.\\\"]},{\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{\\\"E\\\":\\\"R\\\",\\\"a\\\":\\\"−L\\\",\\\"b\\\":\\\"L\\\",\\\"f\\\":\\\"s↦g_j(x_1,…,s,…,x_n)\\\",\\\"f′\\\":\\\"s↦∂_j g_j(x_1,…,s,…,x_n)\\\"},\\\"hypothesis_checks\\\":[\\\"R is complete.\\\",\\\"The derivative is ∂_j g_j by smoothness.\\\",\\\"The derivative is continuous and compactly supported on the interval, hence interval-integrable; choose L with the support in the interior.\\\"]}] }]}}\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"