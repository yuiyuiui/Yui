BEGIN_SIGNATURE:M006
@IsCompact.prod.{u_1,
    u_2} : ∀ {X : Type u_1} {Y : Type u_2} [inst : TopologicalSpace.{u_1} X] [inst_1 : TopologicalSpace.{u_2} Y]
  {s : Set.{u_1} X} {t : Set.{u_2} Y},
  @IsCompact.{u_1} X inst s →
    @IsCompact.{u_2} Y inst_1 t →
      @IsCompact.{max u_1 u_2} (Prod.{u_1, u_2} X Y) (@instTopologicalSpaceProd.{u_1, u_2} X Y inst inst_1)
        (@SProd.sprod.{u_1, u_2, max u_1 u_2} (Set.{u_1} X) (Set.{u_2} Y) (Set.{max u_2 u_1} (Prod.{u_1, u_2} X Y))
          (@Set.instSProd.{u_1, u_2} X Y) s t)
BEGIN_AXIOMS:M006
'IsCompact.prod' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
