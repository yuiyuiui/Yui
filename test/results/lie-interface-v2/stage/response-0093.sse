.yM m) = D.y (D.embed m)) ∧\\n  (∀ m, D.embed (D.zM m) = D.z (D.embed m)) ∧\\n  (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.x r (D.embed m)) ∧\\n  (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.y r (D.embed m)) ∧\\n  LieIrreducible ℂ D.V D.x D.y D.z\\n\",\"parameters\":[{\"name\":\"K\",\"type\":\"Type*\"},{\"name\":\"fK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"p\",\"type\":\"ℕ\"},{\"name\":\"hp\",\"type\":\"Nat.Prime p\"},{\"name\":\"lam\",\"type\":\"ℤ\"},{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"aM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"mM\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"},{\"name\":\"D\",\"type\":\"LieLatticeData lam M\"}],\"types\":[\"D.H004\"]}","status":"completed"}}

