data: {"type":"response.function_call_arguments.done","sequence_number":286,"item_id":"fc_02f8293d92061092016adb4db1bd548191acbae513bd5e7a3f","output_index":2,"arguments":"{\"header\":\"import Mathlib\\nopen scoped TensorProduct\\nnoncomputable def tensorActionRight {K : Type*} [Field K] {M : Type*} [AddCommGroup M] [Module ℤ M]\\n (f : M →ₗ[ℤ] M) : M ⊗[ℤ] K →ₗ[K] M ⊗[ℤ] K :=\\n{ toFun := f.rTensor K\\n  map_add' := by intro a b; exact map_add (f.rTensor K) a b\\n  map_smul' := by\\n    intro c z\\n    induction z using TensorProduct.induction_on with\\n    | zero => simp\\n    | tmul m k => simp [TensorProduct.smul_tmul']\\n    | add a b ha hb => simp [ha, hb] }\\n\",\"parameters\":[{\"name\":\"K\",\"type\":\"Type*\"},{\"name\":\"instK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"instM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"instModM\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"},{\"name\":\"f\",\"type\":\"M →ₗ[ℤ] M\"}],\"types\":[\"M ⊗[ℤ] K →ₗ[K] M ⊗[ℤ] K\"]}"}

