embed (basisM i)\\n  embedInjective : Function.Injective embed\\n  bracket_hx : ∀ z, h (x z) - x (h z) = (2:ℂ) • x z\\n  bracket_hy : ∀ z, h (y z) - y (h z) = (-2:ℂ) • y z\\n  bracket_xy : ∀ z, x (y z) - y (x z) = h z\\n  highest_ne : v ≠ 0\\n  highest_x : x v = 0\\n  highest_h : h v = (lam : ℂ) • v\\n  x_compat : ∀ m, embed (xM m) = x (embed m)\\n  y_compat : ∀ m, embed (yM m) = y (embed m)\\n  h_compat : ∀ m, embed (hM m) = h (embed m)\\n  dividedX_stable : ∀ r m, ∃ m', embed m' = dividedPower V x r (embed m)\\n  dividedY_stable : ∀ r m, ∃ m', embed m' = dividedPower V y r (embed m)\\n\",\"parameters\":[{\"name\":\"K\",\"type\":\"Type*\"},{\"name\":\"fK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"p\",\"type\":\"ℕ\"},{\"name\":\"hp\",\"type\":\"Nat.Prime p\"},{\"name\":\"lam\",\"type\":\"ℤ\"},{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"aM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"mM\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"},{\"name\":\"D\",\"type\":\"LieLatticeData lam M\"}],\"types\":[\"D.valid\",\"LieIrreducible K (K ⊗[ℤ] M) (tensorAction D.xM) (tensorAction D.yM) (tensorAction D.hM)\"]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read an explicitly frozen task document by ID; no other local files are accessible.","p