mGroup V] [Module ℂ V] (f : V →ₗ[ℂ] V) (r : ℕ) : V →ₗ[ℂ] V := ((Nat.factorial r : ℂ)⁻¹) • (f ^ r)\\nnoncomputable def tensorAction {K : Type*} [Field K] {M : Type*} [AddCommGroup M] [Module ℤ M] (f : M →ₗ[ℤ] M) : K ⊗[ℤ] M →ₗ[K] K ⊗[ℤ] M := TensorProduct.AlgebraTensorModule.lTensor K K f\\ndef InvariantUnder (K : Type*) [Field K] (E : Type*) [AddCommGroup E] [Module K E] (f : E →ₗ[K] E) (W : Submodule K E) : Prop := ∀ z ∈ W, f z ∈ W\\ndef LieIrreducible (K : Type*) [Field K] (E : Type*) [AddCommGroup E] [Module K E] (x y z : E →ₗ[K] E) : Prop := Nontrivial E ∧ ∀ W : Submodule K E, InvariantUnder K E x W → InvariantUnder K E y W → InvariantUnder K E z W → W = ⊥ ∨ W = ⊤\\nstructure LieLatticeData (lam : ℤ) (M : Type*) [AddCommGroup M] [Module ℤ M] where\\n  V : Type\\n  [vAdd : AddCommGroup V]\\n  [vMod : Module ℂ V]\\n  basisV : Module.Basis (Fin (lam.toNat + 1)) ℂ V\\n  basisM : Module.Basis (Fin (lam.toNat + 1)) ℤ M\\n  embed : M →ₗ[ℤ] V\\n  x : V →ₗ[ℂ] V\\n  y : V →ₗ[ℂ] V\\n  z : V →ₗ[ℂ] V\\n  xM : M →ₗ[ℤ] M\\n  yM : M →ₗ[ℤ] M\\n  zM : M →ₗ[ℤ] M\\n  v : V\\nnoncomputable def LieLatticeData.H004 {lam : ℤ} {M : Type*} [AddCommGroup M] [Module ℤ M] (D : LieLatticeData lam M) : Prop := by\\n  letI := D.vAdd\\n  letI := D.vMod\\n  exact (∀ i, D.basisV i = D.embed (D.basisM i)) ∧ Function.Injective D.embed ∧\\n    (∀ w, D.z (D.x w) - D.x (D.z w) = (2:ℂ) • D.x w) ∧\\n    (∀ w, D.z (D.y w) - D.y (D.z w) = (-2:ℂ) • D.y w) ∧\\n    (∀ w, D.x (D.y w) - D.y (D.x w) = D.z w) ∧ D.v ≠ 0 ∧ D.x D.v = 0 ∧ D.z D.v = (lam:ℂ) • D.v ∧\\n    (∀ m, D.embed (D.xM m) = D.x (D.embed m)) ∧ (∀ m, D.embed (D.yM m) = D.y (D.embed m)) ∧\\n    (∀ m, D.embed (D.zM m) = D.z (D.embed m)) ∧\\n    (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.x r (D.embed m)) ∧\\n    (∀ r m, ∃ m', D.embed m' = dividedPower D.V D.y r (D.embed m)) ∧\\n    LieIrreducible ℂ D.V D.x D.y D.z\",\"parameters\":[{\"name\":\"K\",\"type\":\"Type*\",\"binder_kind\":\"implicit\"},{\"name\":\"instK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"p\",\"type\":\"ℕ\"},{\"name\":\"lam\",\"type\":\"ℤ\"},{\"name\":\"M\",\"type\":\"Type*\"},{\"name\":\"instM\",\"type\":\"AddCommGroup M\",\"binder_kind\":\"instance\"},{\"name\":\"instModM\",\"type\":\"Module ℤ M\",\"binder_kind\":\"instance\"},{\"name\":\"D\",\"type\":\"LieLatticeData lam M\"}],\"types\":[\"LieIrreducible K (K ⊗[ℤ] M) (tensorAction D.xM) (tensorAction D.yM) (tensorAction D.zM)\"]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read an explicitly frozen task document by ID; no other local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["id","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Report exact status, location, explanation, basis, partial_progress. SUBSTANTIVE_GAP or SUSPECTED_GAP stops for an actual unsupported mathematical implication; give its premises, conclusion and mathematical grounds. SOURCE_UNAVAILABLE or INPUT_CONFLICT stops for a real source-access/original-input obstacle. Ordinary unfinished drafting, source registration or format work must use TASK_INCOMPLETE: this records progress without ending the stage; continue the actual work. Difficulty or artifact incompletion alone is not a mathematical gap.","parameters":{"type":"object","properties":{"obstacle_json":{"type":"string"}},"required":["obstacle_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_draft","description":"Preferred structured-object form of check_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_draft","description":"Preferred structured-object form of submit_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifac