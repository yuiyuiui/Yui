\":\"/graph/propositions/-\",\"value\":{\"id\":\"M011\",\"kind\":\"mathlib\",\"statement\":\"Let E be a finite-dimensional real normed additive group with Borel measurable space and an additive Haar measure μ. Let F,G,W be real normed additive groups and B:F→L(G,W) a continuous bilinear map. For f:E→F, f′:E→L(E,F), g:E→G, g′:E→L(E,G) and v∈E, if x↦B(f′(x)v,g(x)), x↦B(f(x),g′(x)v), and x↦B(f(x),g(x)) are μ-integrable; f has Frechet derivative f′ on tsupport(g); and g has Frechet derivative g′ on tsupport(f), then ∫B(f(x),g′(x)v)dμ=−∫B(f′(x)v,g(x))dμ.\",\"definitions\":[],\"binders\":[{\"symbol\":\"E\",\"type\":\"finite-dimensional real normed additive group\"},{\"symbol\":\"F\",\"type\":\"real normed additive group\"},{\"symbol\":\"G\",\"type\":\"real normed additive group\"},{\"symbol\":\"W\",\"type\":\"real normed additive group\"},{\"symbol\":\"μ\",\"type\":\"additive Haar measure on E\"},{\"symbol\":\"B\",\"type\":\"continuous bilinear map F×G→W\"},{\"symbol\":\"f\",\"type\":\"E→F\"},{\"symbol\":\"f′\",\"type\":\"E→(E→L F)\"},{\"symbol\":\"g\",\"type\":\"E→G\"},{\"symbol\":\"g′\",\"type\":\"E→(E→L G)\"},{\"symbol\":\"v\",\"type\":\"E\"}],\"objects\":[\"E\",\"F\",\"G\",\"W\",\"μ\",\"B\",\"f\",\"f′\",\"g\",\"g′\",\"v\"],\"source\":{\"declaration\":\"integral_bilinear_hasFDerivAt_right_eq_neg_left_of_integrable\",\"module\":\"Mathlib.Analysis.Calculus.LineDeriv.IntegrationByParts\",\"hypotheses\":[\"E has a measurable space, Borel space, finite-dimensional real normed additive structure; μ is an additive Haar measure.\",\"F,G,W have real normed additive structures and B is continuous bilinear.\",\"The three displayed scalar/product functions are μ-integrable.\",\"At every x in tsupport(g), f has Frechet derivative f′(x); at every x in tsupport(f), g has Frechet derivative g′(x).\"],\"evidence\":[{\"path\":\"library/M011-0001/library-sources.json\",\"sha256\":\"4c5aeb79a22100a469679c37686c1c4e884a885e902ee8471fafb80ea5907eaf\"}]}}},{\"op\":\"replace\",\"path\":\"/graph/inferences/4/inputs\",\"value\":[\"N001\",\"N002\",\"M001\",\"M011\"]},{\"op\":\"replace\",\"path\":\"/graph/inferences/4/argument/0/uses\",\"value\":[\"N001\",\"N002\",\"M001\",\"M011\"]},{\"op\":\"replace\",\"path\":\"/graph/inferences/4/argument/0/text\",\"value\":\"Fix r>0. N001 supplies a compact C and a closed time window containing r in its interior such that u=q outside C throughout that window, with the first time and spatial derivatives supported in C. For every spatial index j, put f(x)=∂_{x_j}u(x,r), g(x)=u_t(x,r), and v equal to the jth Euclidean coordinate vector. Smoothness and constancy of u off C imply f,g and their first Frechet derivatives are continuous and vanish off C; thus the three scalar products B(f′(x)v,g(x)), B(f(x),g′(x)v), B(f(x),g(x)) are continuous and compactly supported. By the ambient Euclidean finite-on-compacts property and M001 they are integrable. The derivative identities hold everywhere by smoothness, hence in particular on the required topological supports. Apply M011 with B the Euclidean inner product to obtain ∫∂_{x_j}u·∂_{x_j}u_t=−∫∂_{x_jx_j}u·u_t. Summing over j and using the finite-dimensional product rule gives ∫e_t=2∫u_t·(u_{tt}−Δ_xu). N002 identifies E′(r) with ∫e_t, yielding the stated formula for arbitrary r>0.\"},{\"op\":\"replace\",\"path\":\"/graph/inferences/4/applications\",\"value\":[{\"input\":\"M001\",\"at\":\"S001\",\"bindings\":\"X=ℝⁿ with Borel measurable space and Lebesgue measure, V=ℝ, f equal successively to each of the three scalar product functions formed from u_t, ∂_{x_j}u, and their spatial Frechet derivatives.\",\"hypothesis_checks\":[\"The Euclidean measurable and topological structures have measurable opens.\",\"ℝ is a normed additive commutative group.\",\"Lebesgue measure is finite on compact sets, established by R002's ambient argument.\",\"Each product is continuous and supported in the compact set C by smoothness and constancy of u outside C.\"]},{\"input\":\"M011\",\"at\":\"S001\",\"bindings\":\"E=ℝⁿ, μ=Lebesgue/Haar measure, F=G=ℝ^m, W=ℝ, B the Euclidean dot product, f=∂_{x_j}u, g=u_t, v=e_j, f′ and g′ their Frechet derivatives.\",\"hypothesis_checks\":[\"ℝⁿ is finite-dimensional over ℝ, Borel, and carries Lebesgue additive Haar measure.\",\"The finite-dimensional real vector spaces are normed additive groups and the Euclidean inner product is continuous bilinear.\",\"Each of B(f′v,g), B(f,g′v), and B(f,g) is continuous with compact support by N001 and smoothness, hence integrable by M001.\",\"Smoothness gives the required Frechet derivative identities everywhere, hence on tsupport(g) and tsupport(f).\"]}]}]}}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read an explicitly frozen task document by ID; no other local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["id","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Report exact status, location, explanation, basis, partial_progress. SUBSTANTIVE_GAP or SUSPECTED_GAP stops for an actual unsupported mathematical implication; give its premises, conclusion and mathematical grounds. SOURCE_UNAVAILABLE or INPUT_CONFLICT stops for a real source-access/original-input obstacle. Ordinary unfinished drafting, source registration or format work must use TASK_INCOMPLETE: this records progress without ending the stage; continue the actual work. Difficulty or artifact incompletion alone is not a mathematical gap.","parameters":{"type":"object","properties":{"obstacle_json":{"type":"string"}},"required":["obstacle_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_draft","description":"Preferred structured-object form of check_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_draft","description":"Preferred structured-object form of submit_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"probe_library","description":"Query a proved Mathlib theorem and its exact signature/axioms in the offline sandbox. Returns located evidence for an M source; the mathematical statement and applicability still require review.","parameters":{"type":"object","properties":{"id":{"type":"string"},"declaration":{"type":"string"},"module":{"type":"string"}},"required":["id","declaration","module"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_draft","description":"Read a JSON pointer in your own same-stage candidate after an actual structural check. No other file/stage is accessible; choose a narrow pointer for large objects.","parameters":{"type":"object","properties":{"candidate":{"type":"integer"},"pointer":{"type":"string"}},"required":["candidate","pointer"],"additionalProperties":false},"output_schema":null,"strict":false}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"5d6025e1-9ab3-4109-a4ff-8760331390a5","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"high","context":"all_turns","summary":null,"mode":"standard"},"user":null,"usage":{"input_tokens":108787,"input_tokens_details":{"cached_tokens":57728,"cache_write_tokens":0},"output_tokens":2333,"output_tokens_details":{"reasoning_tokens":1017},"total_tokens":111120,"attribution":{"items":{"fc_04de6b92baab60ea016adb41c23d4c8191ad23decc9cc2155e":{"input_tokens":31,"cached_tokens":31,"cache_write_tokens":0,"output_tokens":0},"fc_04de6b92baab60ea016adb41c580d8819183aa0cdc0086b155":{"input_tokens":34,"cached_tokens":34,"cache_write_tokens":0,"