otheses\\\":[\\\"a,b are real numbers.\\\"],\\\"statement\\\":\\\"For real a≤b, one-dimensional Lebesgue volume of [a,b] is ENNReal.ofReal(b−a).\\\",\\\"evidence\\\":[{\\\"path\\\":\\\"library/M014-0005/library-sources.json\\\",\\\"sha256\\\":\\\"f5e5034a7212cbd19c5b6e1df146b3f8a38c3dec436092b2887932e1c6d99230\\\"}]} }},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/propositions/-\\\",\\\"value\\\":{\\\"id\\\":\\\"M016\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"In a pseudometric space, every compact set is bounded.\\\",\\\"definitions\\\":[],\\\"binders\\\":[{\\\"symbol\\\":\\\"X\\\",\\\"type\\\":\\\"pseudometric space\\\"},{\\\"symbol\\\":\\\"K\\\",\\\"type\\\":\\\"subset of X\\\"}],\\\"objects\\\":[\\\"X\\\",\\\"K\\\"],\\\"source\\\":{\\\"declaration\\\":\\\"IsCompact.isBounded\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.Bounded\\\",\\\"hypotheses\\\":[\\\"X is a pseudometric space.\\\",\\\"K is compact.\\\"],\\\"statement\\\":\\\"In a pseudometric space, every compact set is bounded.\\\",\\\"evidence\\\":[{\\\"path\\\":\\\"library/M016-0017/library-sources.json\\\",\\\"sha256\\\":\\\"1a499af6e4ab6066f3a877be2e174822ba2efc05baf47b9650551a2fbfef8c13\\\"}]}}}},{\\\"op\\\":\\\"replace\\\",\\\"path\\\":\\\"/graph/inferences/1/inputs\\\",\\\"value\\\":[\\\"H003\\\",\\\"M001\\\",\\\"M013\\\",\\\"M014\\\",\\\"M016\\\"]},{\\\"op\\\":\\\"replace\\\",\\\"path\\\":\\\"/graph/inferences/1/argument/0/uses\\\",\\\"value\\\":[\\\"H003\\\",\\\"M001\\\",\\\"M013\\\",\\\"M014\\\",\\\"M016\\\"]}]}\"}"}

