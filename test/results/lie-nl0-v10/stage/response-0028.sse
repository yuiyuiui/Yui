\"C\\\",\\\"type\\\":\\\"field\\\",\\\"meaning\\\":\\\"Complex field.\\\"},{\\\"symbol\\\":\\\"Z_(p)\\\",\\\"type\\\":\\\"ring\\\",\\\"meaning\\\":\\\"Localization of Z at p.\\\"},{\\\"symbol\\\":\\\"U_Z\\\",\\\"type\\\":\\\"Z-algebra of operators\\\",\\\"meaning\\\":\\\"Generated by divided powers X_r,Y_r.\\\"},{\\\"symbol\\\":\\\"L(K)\\\",\\\"type\\\":\\\"Lie algebra\\\",\\\"meaning\\\":\\\"Scalar extension of the Chevalley Z-form acting on M tensor K.\\\"},{\\\"symbol\\\":\\\"Z\\\",\\\"type\\\":\\\"ring\\\",\\\"meaning\\\":\\\"Integers.\\\"},{\\\"symbol\\\":\\\"V(lambda)\\\",\\\"type\\\":\\\"complex vector space\\\",\\\"meaning\\\":\\\"Given highest-weight representation.\\\"},{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"linear operator\\\",\\\"meaning\\\":\\\"Raising generator.\\\"},{\\\"symbol\\\":\\\"y\\\",\\\"type\\\":\\\"linear operator\\\",\\\"meaning\\\":\\\"Lowering generator.\\\"},{\\\"symbol\\\":\\\"h\\\",\\\"type\\\":\\\"linear operator\\\",\\\"meaning\\\":\\\"Cartan generator.\\\"},{\\\"symbol\\\":\\\"v\\\",\\\"type\\\":\\\"vector\\\",\\\"meaning\\\":\\\"Given highest-weight vector.\\\"}]},{\\\"op\\\":\\\"replace\\\",\\\"path\\\":\\\"/graph/inferences/0/locals\\\",\\\"value\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"Z_(p)\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define R=Z_(p).\\\",\\\"from_inputs\\\":[\\\"H001\\\",\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"Z\\\",\\\"p\\\"]},{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"lambda+1\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define n=lambda+1.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"lambda\\\"]},{\\\"symbol\\\":\\\"e_i\\\",\\\"type\\\":\\\"y^i v/i! vector\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"defini