 of integers.\\\"}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/spec/logic/primitives/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"V(lambda)\\\",\\\"type\\\":\\\"complex vector space\\\",\\\"meaning\\\":\\\"The given finite-dimensional irreducible highest-weight sl2(C)-module of highest weight lambda.\\\"}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/spec/logic/primitives/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"linear operator on V(lambda)\\\",\\\"meaning\\\":\\\"The raising Chevalley generator acting on V(lambda).\\\"}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/spec/logic/primitives/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"y\\\",\\\"type\\\":\\\"linear operator on V(lambda)\\\",\\\"meaning\\\":\\\"The lowering Chevalley generator acting on V(lambda).\\\"}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/spec/logic/primitives/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"h\\\",\\\"type\\\":\\\"linear operator on V(lambda)\\\",\\\"meaning\\\":\\\"The Cartan Chevalley generator acting on V(lambda).\\\"}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/spec/logic/primitives/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"v\\\",\\\"type\\\":\\\"vector in V(lambda)\\\",\\\"meaning\\\":\\\"The given nonzero highest-weight vector, satisfying xv=0 and hv=lambda v.\\\"}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"localization Z_(p)={a/b in Q : p does not divide b}\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define R=Z_(p).\\\",\\\"from_inputs\\\":[\\\"H001\\\",\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"Z\\\",\\\"p\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"natural number lambda+1\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define n=lambda+1.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"lambda\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"e_i\\\",\\\"type\\\":\\\"V(lambda) vector indexed by 0<=i<=lambda, y^i v/i!\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For each integer i with 0<=i<=lambda define e_i=y^i v/i!.\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"y\\\",\\\"v\\\",\\\"lambda\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"X_r\\\",\\\"type\\\":\\\"operator x^r/r! for integer r>=0\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For every integer r>=0 define X_r=x^r/r!.\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"x\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"Y_r\\\",\\\"type\\\":\\\"operator y^r/r! for integer r>=0\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For every integer r>=0 define Y_r=y^r/r!.\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"y\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"M_R\\\",\\\"type\\\":\\\"R-span of M in V(lambda)\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define M_R=R tensor_Z M embedded in V(lambda).\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"R\\\",\\\"M\\\",\\\"Z\\\",\\\"V(lambda)\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"Q\\\",\\\"type\\\":\\\"fraction field of R\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Let Q=Frac(R).\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"R\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"E_ab\\\",\\\"type\\\":\\\"endomorphism sending e_b to e_a and other basis vectors to zero\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For indices a,b in [0,lambda], define matrix unit E_ab by E_ab(e_b)=e_a and E_ab(e_t)=0 for t≠b.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"e_i\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"J_i\\\",\\\"type\\\":\\\"{c in C | c e_i in M_R}\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For each i define J_i={c in C : c e_i belongs to M_R}.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"C\\\",\\\"e_i\\\",\\\"M_R\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"common R-submodule J_i of C\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Let J be the common value of the equal modules J_i.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"J_i\\\"]}},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/locals/-\\\",\\\"value\\\":{\\\"symbol\\\":\\\"a\\\",\\\"type\\\":\\\"generator of free rank-one R-module J\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S004\\\",\\\"end\\\":