 every integer r>=0 define Y_r=y^r/r!.\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"y\\\"]},{\\\"symbol\\\":\\\"M_R\\\",\\\"type\\\":\\\"R-span of M in V(lambda)\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define M_R=R tensor_Z M embedded in V(lambda).\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"R\\\",\\\"M\\\",\\\"Z\\\",\\\"V(lambda)\\\"]},{\\\"symbol\\\":\\\"E_ab\\\",\\\"type\\\":\\\"endomorphism E_ab(e_b)=e_a and E_ab(e_t)=0 for t!=b\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For indices a,b in [0,lambda], define matrix unit E_ab by E_ab(e_b)=e_a and E_ab(e_t)=0 for t!=b.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"e_i\\\"]},{\\\"symbol\\\":\\\"E_i,j\\\",\\\"type\\\":\\\"endomorphism E_i,j(e_j)=e_i and E_i,j(e_t)=0 for t!=j\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For indices i,j in [0,lambda], define matrix unit E_i,j by E_i,j(e_j)=e_i and E_i,j(e_t)=0 for t!=j.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"e_i\\\"]},{\\\"symbol\\\":\\\"J_i\\\",\\\"type\\\":\\\"{c in C | c e_i in M_R}\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For each i define J_i={c in C:c e_i belongs to M_R}.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"C\\\",\\\"e_i\\\",\\\"M_R\\\"]},{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"common R-submodule J_i of C\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Let J be the common value of the equal modules J_i.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"J_i\\\"]},{\\\"symbol\\\":\\\"Q\\\",\\\"type\\\":\\\"fraction field of R\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Let Q=Frac(R).\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"R\\\"]},{\\\"symbol\\\":\\\"a\\\",\\\"type\\\":\\\"generator of free rank-one R-module J\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S004\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose a generator a of the rank-one free module J, using F001 proved in S003.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[\\\"F001\\\"],\\\"objects\\\":[\\\"J\\\"]},{\\\"symbol\\\":\\\"F_p\\\",\\\"type\\\":\\\"prime subfield of K\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S004\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Let F_p be the prime subfield of K.\\\",\\\"from_inputs\\\":[\\\"H001\\\",\\\"H002\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"p\\\",\\\"K\\\"]},{\\\"symbol\\\":\\\"W\\\",\\\"type\\\":\\\"K-linear subspace invariant under x,y,h\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S005\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Let W be an arbitrary K-linear subspace invariant under x,y,h.\\\",\\\"from_inputs\\\":[\\\"H002\\\",\\\"H003\\\",\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"K\\\",\\\"M\\\",\\\"x\\\",\\\"y\\\",\\\"h\\\"]}]},{\\\"op\\\":\\\"add\\\",\\\"path\\\":\\\"/graph/inferences/0/argument/2/produces/-\\\",\\\"value\\\":{\\\"id\\\":\\\"F001\\\",\\\"statement\\\":\\\"There exists a nonzero a in J such that J=Ra; equivalently J is free of rank one over R.\\\",\\\"binders\\\":[{\\\"symbol\\\":\\\"a\\\",\\\"type\\\":\\\"element of J\\\"}],\\\"objects\\\":[\\\"J\\\",\\\"R\\\"],\\\"assumptions\\\":[]}}]}\"}","status":"completed"}}

