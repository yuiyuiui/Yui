\":\\\"The ring of integers.\\\"},{\\\"symbol\\\":\\\"V(lambda)\\\",\\\"type\\\":\\\"complex vector space\\\",\\\"meaning\\\":\\\"The given finite-dimensional irreducible highest-weight sl2(C)-module of highest weight lambda.\\\"},{\\\"symbol\\\":\\\"x\\\",\\\"type\\\":\\\"linear operator on V(lambda)\\\",\\\"meaning\\\":\\\"The raising Chevalley generator acting on V(lambda).\\\"},{\\\"symbol\\\":\\\"y\\\",\\\"type\\\":\\\"linear operator on V(lambda)\\\",\\\"meaning\\\":\\\"The lowering Chevalley generator acting on V(lambda).\\\"},{\\\"symbol\\\":\\\"h\\\",\\\"type\\\":\\\"linear operator on V(lambda)\\\",\\\"meaning\\\":\\\"The Cartan Chevalley generator acting on V(lambda).\\\"},{\\\"symbol\\\":\\\"v\\\",\\\"type\\\":\\\"vector in V(lambda)\\\",\\\"meaning\\\":\\\"The given nonzero highest-weight vector, satisfying xv=0 and hv=lambda v.\\\"}]},{\\\"op\\\":\\\"replace\\\",\\\"path\\\":\\\"/graph/inferences/0/locals\\\",\\\"value\\\":[{\\\"symbol\\\":\\\"R\\\",\\\"type\\\":\\\"localization Z_(p)={a/b in Q:p does not divide b}\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define R=Z_(p).\\\",\\\"from_inputs\\\":[\\\"H001\\\",\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"Z\\\",\\\"p\\\"]},{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"natural number lambda+1\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define n=lambda+1.\\\",\\\"from_inputs\\\":[\\\"H003\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"lambda\\\"]},{\\\"symbol\\\":\\\"e_i\\\",\\\"type\\\":\\\"V(lambda) vector indexed 0<=i<=lambda, y^i v/i!\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For each integer i with 0<=i<=lambda define e_i=y^i v/i!.\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"y\\\",\\\"v\\\",\\\"lambda\\\"]},{\\\"symbol\\\":\\\"X_r\\\",\\\"type\\\":\\\"operator x^r/r! for integer r>=0\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For every integer r>=0 define X_r=x^r/r!.\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"x\\\"]},{\\\"symbol\\\":\\\"Y_r\\\",\\\"type\\\":\\\"operator y^r/r! for integer r>=0\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For every integer r>=0 define Y_r=y^r/r!.\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"y\\\"]},{\\\"symbol\\\":\\\"M_R\\\",\\\"type\\\":\\\"R-span of M in V(lambda)\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S001\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Define M_R=R tensor_Z M embedded in V(lambda).\\\",\\\"from_inputs\\\":[\\\"H004\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"R\\\",\\\"M\\\",\\\"Z\\\",\\\"V(lambda)\\\"]},{\\\"symbol\\\":\\\"E_ab\\\",\\\"type\\\":\\\"endomorphism E_ab(e_b)=e_a and E_ab(e_t)=0 for t!=b\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For indices a,b in [0,lambda], define matrix unit E_ab by E_ab(e_b)=e_a and E_ab(e_t)=0 for t!=b.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"e_i\\\"]},{\\\"symbol\\\":\\\"E_i,j\\\",\\\"type\\\":\\\"endomorphism E_i,j(e_j)=e_i and E_i,j(e_t)=0 for t!=j\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S002\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For indices i,j in [0,lambda], define matrix unit E_i,j by E_i,j(e_j)=e_i and E_i,j(e_t)=0 for t!=j.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"e_i\\\"]},{\\\"symbol\\\":\\\"J_i\\\",\\\"type\\\":\\\"{c in C | c e_i in M_R}\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"For each i define J_i={c in C:c e_i belongs to M_R}.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"C\\\",\\\"e_i\\\",\\\"M_R\\\"]},{\\\"symbol\\\":\\\"J\\\",\\\"type\\\":\\\"common R-submodule J_i of C\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Let J be the common value of the equal modules J_i.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"J_i\\\"]},{\\\"symbol\\\":\\\"Q\\\",\\\"type\\\":\\\"fraction field of R\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S003\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Let Q=Frac(R).\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[],\\\"objects\\\":[\\\"R\\\"]},{\\\"symbol\\\":\\\"a\\\",\\\"type\\\":\\\"generator of free rank-one R-module J\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S004\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"witness\\\",\\\"declaration\\\":\\\"Choose a generator a of the rank-one free module J, using F001 proved in S003.\\\",\\\"from_inputs\\\":[],\\\"from_local\\\":[\\\"F001\\\"],\\\"objects\\\":[\\\"J\\\"]},{\\\"symbol\\\":\\\"F_p\\\",\\\"type\\\":\\\"prime subfield of K\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S004\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"definition\\\",\\\"declaration\\\":\\\"Let F_p be the prime subfield of K.\\\",\\\"from_inputs\\\":[\\\"H001\\\",\\\"H002\\\"],\\\"from_local\\\":[],\\\"objects\\\":[\\\"p\\\",\\\"K\\\"]},{\\\"symbol\\\":\\\"W\\\",\\\"type\\\":\\\"K-linear subspace invariant under x,y,h\\\",\\\"scope\\\":\\\"R001\\\",\\\"start\\\":\\\"S005\\\",\\\"end\\\":\\\"S005\\\",\\\"kind\\\":\\\"arbitrary\\\",\\\"declaration\\\":\\\"Let W be an arbitrary K-linear subspace invariant under x,y,h.\\\",\\\"from_inputs\\