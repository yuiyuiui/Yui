@LipschitzWith.dimH_image_le.{u_1,
    u_2} : ∀ {X : Type u_1} {Y : Type u_2} [inst : EMetricSpace.{u_1} X] [inst_1 : EMetricSpace.{u_2} Y] {K : NNReal}
  {f : X → Y},
  @LipschitzWith.{u_1, u_2} X Y (@EMetricSpace.toPseudoEMetricSpace.{u_1} X inst)
      (@EMetricSpace.toPseudoEMetricSpace.{u_2} Y inst_1) K f →
    ∀ (s : Set.{u_1} X),
      @LE.le.{0} ENNReal ENNReal.instLE (@dimH.{u_2} Y inst_1 (@Set.image.{u_1, u_2} X Y f s)) (@dimH.{u_1} X inst s)
