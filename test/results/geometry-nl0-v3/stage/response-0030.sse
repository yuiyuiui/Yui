data: {"type":"response.function_call_arguments.done","sequence_number":3421,"item_id":"fc_0ab345649bc6d74b016adb203958488191bec455c8495b4e77","output_index":2,"arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"geometry-product-dimension\\\",\\\"full_target\\\":\\\"For every n∈ℕ and E⊆ℝ^n, if E is nonempty and compact, then for I=[0,1] with the metric induced from concatenated Euclidean coordinates in ℝ^(n+1), dim_H(E×I)=dim_H(E)+1.\\\",\\\"conclusion\\\":\\\"dim_H(E×I)=dim_H(E)+1.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"nonnegative integer\\\"},{\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"subset of Euclidean ℝ^n\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"E is nonempty.\\\",\\\"origin\\\":\\\"frozen-target.md:7-9\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"E is compact.\\\",\\\"origin\\\":\\\"frozen-target.md:7-9\\\"}],\\\"definitions\\\":[],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"case_elimination\\\",\\\"contradiction_classical\\\",\\\"direct\\\",\\\"exists_elimination\\\",\\\"forall_introduction\\\",\\\"implication_introduction\\\",\\\"modus_ponens\\\",\\\"natural_induction\\\",\\\"negation_introduction\\\"],\\\"calculations\\\":[\\\"For concatenated Euclidean coordinates, d((x,t),(y,u))²=|x−y|²+|t−u|²; coordinate projections are 1-Lipschitz. diam(U×J)≤√(diam(U)²+diam(J)²). For 0<r≤1 the unit interval is covered by at most 1/r+1 intervals of length at most r.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"ℝ^n\\\",\\\"type\\\":\\\"Euclidean space of dimension n\\\",\\\"meaning\\\":\\\"The n-dimensional real inner-product space, including ℝ^0 as a singleton.\\\"},{\\\"symbol\\\":\\\"dim_H\\\",\\\"type\\\":\\\"Hausdorff dimension\\\",\\\"meaning\\\":\\\"Critical exponent of Hausdorff measures, with dim_H(∅)=0.\\\"},{\\\"symbol\\\":\\\"I\\\",\\\"type\\\":\\\"subset of ℝ\\\",\\\"meaning\\\":\\\"The closed interval [0,1].\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"geometry-product-dimension\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"E is nonempty.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"E is compact.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"hausdorffMeasure_of_lt_dimH: for a set s in a Borel extended metric space and d:NNReal, if (d:ENNReal)<dimH(s), then μH[d](s)=∞.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"dim_H\\\"],\\\"source\\\":{\\\"statement\\\":\\\"hausdorffMeasure_of_lt_dimH: for a set s in a Borel extended metric space and d:NNReal, if (d:ENNReal)<dimH(s), then μH[d](s)=∞.\\\",\\\"hypotheses\\\":[\\\"X is an extended metric space with measurable space and BorelSpace instances; s:Set X; d:NNReal.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M001-0001/library-sources.json\\\",\\\"sha256\\\":\\\"1e2974873151488a644ca1f93451e98bf2f2e911dba567adf7983fa7abfccdb1\\\"}],\\\"declaration\\\":\\\"hausdorffMeasure_of_lt_dimH\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.HausdorffDimension\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/Topology/MetricSpace/HausdorffDimension.lean\\\",\\\"source_sha256\\\":\\\"fdc61e7f179044cd714058f209b100e51b6f8af69aff295e3ee629ed45dcee31\\\",\\\"signature\\\":\\\"@hausdorffMeasure_of_lt_dimH.{u_1} : ∀ {X : Type u_1} [inst : EMetricSpace.{u_1} X] [inst_1 : MeasurableSpace.{u_1} X] [inst_2 : BorelSpace X] {s : Set X} {d : NNReal}, ↑d < dimH s → μH[d] s = ∞\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"M002\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"LipschitzWith.dimH_image_le: for a Lipschitz map f:X→Y between extended metric spaces, every s:Set X satisfies dimH(f '' s)≤dimH(s).\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"dim_H\\\"],\\\"source\\\":{\\\"statement\\\":\\\"LipschitzWith.dimH_image_le: for a Lipschitz map f:X→Y between extended metric spaces, every s:Set X satisfies dimH(f '' s)≤dimH(s).\\\",\\\"hypotheses\\\":[\\\"X,Y are extended metric spaces; K:NNReal; f:X→Y is LipschitzWith K; s:Set X.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M002-0002/library-sources.json\\\",\\\"sha256\\\":\\\"24901487517562f47ec0d40b0915c250514f02599c40979d318f9d92bc9b804e\\\"}],\\\"declaration\\\":\\\"LipschitzWith.dimH_image_le\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.HausdorffDimension\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/Topology/MetricSpace/HausdorffDimension.lean\\\",\\\"source_sha256\\\":\\\"fdc61e7f179044cd714058f209b100e51b6f8af69aff295e3ee629ed45dcee31\\\",\\\"signature\\\":\\\"@LipschitzWith.dimH_image_le.{u_1,u_2}: ∀ {X Y} [EMetricSpace X] [EMetricSpace Y] {K:NNReal} {f:X→Y}, LipschitzWith K f → ∀ s:Set X, dimH(f '' s)≤dimH(s)\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"M003\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"Real.dimH_of_nonempty_interior: for a finite-dimensional real normed space V and set s with nonempty interior, dimH(s)=finrank(ℝ,V).\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"dim_H\\\"],\\\"source\\\":{\\\"statement\\\":\\\"Real.dimH_of_nonempty_interior: for a finite-dimensional real normed space V and set s with nonempty interior, dimH(s)=finrank(ℝ,V).\\\",\\\"hypotheses\\\":[\\\"V is a finite-dimensional real normed space; s:Set V; interior(s) is nonempty.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M003-0003/library-sources.json\\\",\\\"sha256\\\":\\\"c783a006ff20bfe97d7c98bfd5f18d8784ed298de16966895617ff31b9bef32f\\\"}],\\\"declaration\\\":\\\"Real.dimH_of_nonempty_interior\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.HausdorffDimension\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/Topology/MetricSpace/HausdorffDimension.lean\\\",\\\"source_sha256\\\":\\\"fdc61e7f179044cd714058f209b100e51b6f8af69aff295e3ee629ed45dcee31\\\",\\\"signature\\\":\\\"@Real.dimH_of_nonempty_interior.{u_1} : ∀ {E} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] {s:Set E}, Nonempty (interior s) → dimH s = (finrank ℝ E : ENNReal)\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"M004\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"MeasureTheory.lintegral_tsum: the integral of a countable pointwise sum of nonnegative measurable ENNReal-valued functions equals the sum of their integrals.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[],\\\"source\\\":{\\\"statement\\\":\\\"MeasureTheory.lintegral_tsum: the integral of a countable pointwise sum of nonnegative measurable ENNReal-valued functions equals the sum of their integrals.\\\",\\\"hypotheses\\\":[\\\"A measure space (α,m,μ); countable index β; f:β→α→ENNReal; every f i is AEMeasurable with respect to μ.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M004-0005/library-sources.json\\\",\\\"sha256\\\":\\\"b0fd457ea61a6a025c9884af4cc4afcff3a4bb6a1649fcb7276fb23108a3a8ff\\\"}],\\\"declaration\\\":\\\"MeasureTheory.lintegral_tsum\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.Lebesgue.Add\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/MeasureTheory/Integral/Lebesgue/Add.lean\\\",\\\"source_sha256\\\":\\\"14da3dd3c269221e9ec43e91c6b22bb02d5db7f00e03c789661c72dffecf7b4a\\\",\\\"signature\\\":\\\"@MeasureTheory.lintegral_tsum.{u_1,u_2}: ∀ {α β} {m:MeasurableSpace α} {μ:Measure α} [Countable β] {f:β→α→ENNReal}, (∀i,AEMeasurable (f i) μ) → ∫⁻a, ∑'i,f i a ∂μ=∑'i,∫⁻a,f i a ∂μ\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"statement\\\":\\\"dim_H(E×I)=dim_H(E)+1.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"I\\\",\\\"dim_H\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\",\\\"M004\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[],\\\"rules\\\":[\\\"direct\\\",\\\"case_elimination\\\",\\\"forall_introduction\\\"],\\\"locals\\\":[],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Let D=dim_H(E), F=E×I. Compactness makes E bounded. Euclidean cube covers of a bounded box show H^q(E)=0 for q>n, so D is finite. For q>D, M001 gives H^q(E)=0. At arbitrary small scale δ≤1 cover E by sets of positive diameters r_j≤δ with arbitrarily small Σr_j^q; replace any singleton members by tiny positive-diameter balls with arbitrarily small total added q-cost. Cover I for each j with at most 1/r_j+1 intervals of length at most r_j. The products cover F and have diameter ≤√2 r_j, with total (q+1)-cost ≤2(√2)^(q+1)Σr_j^q. Taking costs to zero and scales to zero proves H^(q+1)(F)=0; hence dim_H(F)≤D+1.\\\",\\\"uses\\\":[\\\"H002\\\",\\\"M001\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"F\\\",\\\"D\\\",\\\"n\\\",\\\"I\\\",\\\"q\\\",\\\"δ\\\",\\\"r_j\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"If D>0, fix 0<s<D. M001 gives H^s(E)=∞; by the Hausdorff-measure definition the scale-s contents c_s(E,δ) tend to infinity as δ↓0. For any cover V_i of F with ρ_i=diam(V_i)≤δ≤1, let A_i,B_i be its coordinate projections, with diameters ≤ρ_i. Enclose B_i in open intervals J_i of length ≤ρ_i+η_i, choosing η_i>0 with Ση_iρ_i^s<ε. For each t∈I, the A_i with t∈J_i cover E, since each (x,t) belongs to a V_i and B_i⊆J_i. Thus c_s(E,δ)≤Σ1_{J_i}(t)ρ_i^s for every t. The indicators are measurable and nonnegative; M004 gives the integral of the sum as the sum of integrals. Integrating on I yields c_s(E,δ)≤Σ|J_i∩I|ρ_i^s≤Σρ_i^(s+1)+ε. Terms with ρ_i=0 vanish because s>0. Let ε↓0 and infimize over product covers to get c_s(E,δ)≤c_(s+1)(F,δ). Therefore H^(s+1)(F)=∞ and dim_H(F)≥s+1. Taking all 0<s<D gives dim_H(F)≥D+1.\\\",\\\"uses\\\":[\\\"M001\\\",\\\"M004\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"F\\\",\\\"D\\\",\\\"I\\\",\\\"s\\\",\\\"δ\\\",\\\"V_i\\\",\\\"ρ_i\\\",\\\"A_i\\\",\\\"B_i\\\",\\\"J_i\\\",\\\"η_i\\\",\\\"ε\\\",\\\"c_s\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S003\\\",\\\"text\\\":\\\"If D=0, choose x₀∈E using H001. The coordinate projection π:F→I is 1-Lipschitz for the stated Euclidean product distance and is onto because (x₀,t)∈F for every t. The interval has nonempty interior, so M003 with V=ℝ gives dim_H(I)=finrank(ℝ,ℝ)=1. Applying M002 to π gives 1=dim_H(I)≤dim_H(F)=D+1. This works also for n=0. Together with the upper bound this proves the equality.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"M002\\\",\\\"M003\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"F\\\",\\\"I\\\",\\\"x₀\\\",\\\"π\\\",\\\"D\\\",\\\"n\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"Use A=E, Euclidean Borel metric, and q>D to obtain zero q-Hausdorff measure.\\\"]},{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"Use A=E and 0<s<D to obtain infinite s-Hausdorff measure.\\\"]},{\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"The coordinate projection has Lipschitz constant 1 for concatenated Euclidean distance.\\\"]},{\\\"input\\\":\\\"M003\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"V=ℝ and I=[0,1], whose interior is nonempty; finrank(ℝ,ℝ)=1.\\\"]},{\\\"input\\\":\\\"M004\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"Use counting measure on I and summands ρ_i^s times indicators of open J_i; all are measurable nonnegative ENNReal functions.\\\"]}]}}\"}"}

event: response.output_item.done
data: {"type":"response.output_item.done","sequence_number":3422,"output_index":2,"item":{"type":"function_call","id":"fc_0ab345649bc6d74b016adb203958488191bec455c8495b4e77","call_id":"call_bcaf1f2fc4d8446a9b45792e2998a1d9","name":"submit_artifact","arguments":"{\"artifact_json\":\"{\\\"spec\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"geometry-product-dimension\\\",\\\"full_target\\\":\\\"For every n∈ℕ and E⊆ℝ^n, if E is nonempty and compact, then for I=[0,1] with the metric induced from concatenated Euclidean coordinates in ℝ^(n+1), dim_H(E×I)=dim_H(E)+1.\\\",\\\"conclusion\\\":\\\"dim_H(E×I)=dim_H(E)+1.\\\",\\\"parameters\\\":[{\\\"symbol\\\":\\\"n\\\",\\\"type\\\":\\\"nonnegative integer\\\"},{\\\"symbol\\\":\\\"E\\\",\\\"type\\\":\\\"subset of Euclidean ℝ^n\\\"}],\\\"hypotheses\\\":[{\\\"id\\\":\\\"H001\\\",\\\"statement\\\":\\\"E is nonempty.\\\",\\\"origin\\\":\\\"frozen-target.md:7-9\\\"},{\\\"id\\\":\\\"H002\\\",\\\"statement\\\":\\\"E is compact.\\\",\\\"origin\\\":\\\"frozen-target.md:7-9\\\"}],\\\"definitions\\\":[],\\\"logic\\\":{\\\"classical\\\":true,\\\"rules\\\":[\\\"case_elimination\\\",\\\"contradiction_classical\\\",\\\"direct\\\",\\\"exists_elimination\\\",\\\"forall_introduction\\\",\\\"implication_introduction\\\",\\\"modus_ponens\\\",\\\"natural_induction\\\",\\\"negation_introduction\\\"],\\\"calculations\\\":[\\\"For concatenated Euclidean coordinates, d((x,t),(y,u))²=|x−y|²+|t−u|²; coordinate projections are 1-Lipschitz. diam(U×J)≤√(diam(U)²+diam(J)²). For 0<r≤1 the unit interval is covered by at most 1/r+1 intervals of length at most r.\\\"],\\\"primitives\\\":[{\\\"symbol\\\":\\\"ℝ^n\\\",\\\"type\\\":\\\"Euclidean space of dimension n\\\",\\\"meaning\\\":\\\"The n-dimensional real inner-product space, including ℝ^0 as a singleton.\\\"},{\\\"symbol\\\":\\\"dim_H\\\",\\\"type\\\":\\\"Hausdorff dimension\\\",\\\"meaning\\\":\\\"Critical exponent of Hausdorff measures, with dim_H(∅)=0.\\\"},{\\\"symbol\\\":\\\"I\\\",\\\"type\\\":\\\"subset of ℝ\\\",\\\"meaning\\\":\\\"The closed interval [0,1].\\\"}]},\\\"pins\\\":{\\\"lean_version\\\":\\\"controller-bound\\\",\\\"mathlib_commit\\\":\\\"controller-bound\\\",\\\"mathlib_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"geometry-product-dimension\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"E is nonempty.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"E is compact.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"hausdorffMeasure_of_lt_dimH: for a set s in a Borel extended metric space and d:NNReal, if (d:ENNReal)<dimH(s), then μH[d](s)=∞.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"dim_H\\\"],\\\"source\\\":{\\\"statement\\\":\\\"hausdorffMeasure_of_lt_dimH: for a set s in a Borel extended metric space and d:NNReal, if (d:ENNReal)<dimH(s), then μH[d](s)=∞.\\\",\\\"hypotheses\\\":[\\\"X is an extended metric space with measurable space and BorelSpace instances; s:Set X; d:NNReal.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M001-0001/library-sources.json\\\",\\\"sha256\\\":\\\"1e2974873151488a644ca1f93451e98bf2f2e911dba567adf7983fa7abfccdb1\\\"}],\\\"declaration\\\":\\\"hausdorffMeasure_of_lt_dimH\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.HausdorffDimension\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/Topology/MetricSpace/HausdorffDimension.lean\\\",\\\"source_sha256\\\":\\\"fdc61e7f179044cd714058f209b100e51b6f8af69aff295e3ee629ed45dcee31\\\",\\\"signature\\\":\\\"@hausdorffMeasure_of_lt_dimH.{u_1} : ∀ {X : Type u_1} [inst : EMetricSpace.{u_1} X] [inst_1 : MeasurableSpace.{u_1} X] [inst_2 : BorelSpace X] {s : Set X} {d : NNReal}, ↑d < dimH s → μH[d] s = ∞\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"M002\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"LipschitzWith.dimH_image_le: for a Lipschitz map f:X→Y between extended metric spaces, every s:Set X satisfies dimH(f '' s)≤dimH(s).\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"dim_H\\\"],\\\"source\\\":{\\\"statement\\\":\\\"LipschitzWith.dimH_image_le: for a Lipschitz map f:X→Y between extended metric spaces, every s:Set X satisfies dimH(f '' s)≤dimH(s).\\\",\\\"hypotheses\\\":[\\\"X,Y are extended metric spaces; K:NNReal; f:X→Y is LipschitzWith K; s:Set X.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M002-0002/library-sources.json\\\",\\\"sha256\\\":\\\"24901487517562f47ec0d40b0915c250514f02599c40979d318f9d92bc9b804e\\\"}],\\\"declaration\\\":\\\"LipschitzWith.dimH_image_le\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.HausdorffDimension\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/Topology/MetricSpace/HausdorffDimension.lean\\\",\\\"source_sha256\\\":\\\"fdc61e7f179044cd714058f209b100e51b6f8af69aff295e3ee629ed45dcee31\\\",\\\"signature\\\":\\\"@LipschitzWith.dimH_image_le.{u_1,u_2}: ∀ {X Y} [EMetricSpace X] [EMetricSpace Y] {K:NNReal} {f:X→Y}, LipschitzWith K f → ∀ s:Set X, dimH(f '' s)≤dimH(s)\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"M003\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"Real.dimH_of_nonempty_interior: for a finite-dimensional real normed space V and set s with nonempty interior, dimH(s)=finrank(ℝ,V).\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"dim_H\\\"],\\\"source\\\":{\\\"statement\\\":\\\"Real.dimH_of_nonempty_interior: for a finite-dimensional real normed space V and set s with nonempty interior, dimH(s)=finrank(ℝ,V).\\\",\\\"hypotheses\\\":[\\\"V is a finite-dimensional real normed space; s:Set V; interior(s) is nonempty.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M003-0003/library-sources.json\\\",\\\"sha256\\\":\\\"c783a006ff20bfe97d7c98bfd5f18d8784ed298de16966895617ff31b9bef32f\\\"}],\\\"declaration\\\":\\\"Real.dimH_of_nonempty_interior\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.HausdorffDimension\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/Topology/MetricSpace/HausdorffDimension.lean\\\",\\\"source_sha256\\\":\\\"fdc61e7f179044cd714058f209b100e51b6f8af69aff295e3ee629ed45dcee31\\\",\\\"signature\\\":\\\"@Real.dimH_of_nonempty_interior.{u_1} : ∀ {E} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] {s:Set E}, Nonempty (interior s) → dimH s = (finrank ℝ E : ENNReal)\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"M004\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"MeasureTheory.lintegral_tsum: the integral of a countable pointwise sum of nonnegative measurable ENNReal-valued functions equals the sum of their integrals.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[],\\\"source\\\":{\\\"statement\\\":\\\"MeasureTheory.lintegral_tsum: the integral of a countable pointwise sum of nonnegative measurable ENNReal-valued functions equals the sum of their integrals.\\\",\\\"hypotheses\\\":[\\\"A measure space (α,m,μ); countable index β; f:β→α→ENNReal; every f i is AEMeasurable with respect to μ.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M004-0005/library-sources.json\\\",\\\"sha256\\\":\\\"b0fd457ea61a6a025c9884af4cc4afcff3a4bb6a1649fcb7276fb23108a3a8ff\\\"}],\\\"declaration\\\":\\\"MeasureTheory.lintegral_tsum\\\",\\\"module\\\":\\\"Mathlib.MeasureTheory.Integral.Lebesgue.Add\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/MeasureTheory/Integral/Lebesgue/Add.lean\\\",\\\"source_sha256\\\":\\\"14da3dd3c269221e9ec43e91c6b22bb02d5db7f00e03c789661c72dffecf7b4a\\\",\\\"signature\\\":\\\"@MeasureTheory.lintegral_tsum.{u_1,u_2}: ∀ {α β} {m:MeasurableSpace α} {μ:Measure α} [Countable β] {f:β→α→ENNReal}, (∀i,AEMeasurable (f i) μ) → ∫⁻a, ∑'i,f i a ∂μ=∑'i,∫⁻a,f i a ∂μ\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"statement\\\":\\\"dim_H(E×I)=dim_H(E)+1.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"I\\\",\\\"dim_H\\\"]}],\\\"inferences\\\":[{\\\"id\\\":\\\"R001\\\",\\\"inputs\\\":[\\\"H001\\\",\\\"H002\\\",\\\"M001\\\",\\\"M002\\\",\\\"M003\\\",\\\"M004\\\"],\\\"output\\\":\\\"P\\\",\\\"definitions\\\":[],\\\"rules\\\":[\\\"direct\\\",\\\"case_elimination\\\",\\\"forall_introduction\\\"],\\\"locals\\\":[],\\\"argument\\\":[{\\\"id\\\":\\\"S001\\\",\\\"text\\\":\\\"Let D=dim_H(E), F=E×I. Compactness makes E bounded. Euclidean cube covers of a bounded box show H^q(E)=0 for q>n, so D is finite. For q>D, M001 gives H^q(E)=0. At arbitrary small scale δ≤1 cover E by sets of positive diameters r_j≤δ with arbitrarily small Σr_j^q; replace any singleton members by tiny positive-diameter balls with arbitrarily small total added q-cost. Cover I for each j with at most 1/r_j+1 intervals of length at most r_j. The products cover F and have diameter ≤√2 r_j, with total (q+1)-cost ≤2(√2)^(q+1)Σr_j^q. Taking costs to zero and scales to zero proves H^(q+1)(F)=0; hence dim_H(F)≤D+1.\\\",\\\"uses\\\":[\\\"H002\\\",\\\"M001\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"F\\\",\\\"D\\\",\\\"n\\\",\\\"I\\\",\\\"q\\\",\\\"δ\\\",\\\"r_j\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S002\\\",\\\"text\\\":\\\"If D>0, fix 0<s<D. M001 gives H^s(E)=∞; by the Hausdorff-measure definition the scale-s contents c_s(E,δ) tend to infinity as δ↓0. For any cover V_i of F with ρ_i=diam(V_i)≤δ≤1, let A_i,B_i be its coordinate projections, with diameters ≤ρ_i. Enclose B_i in open intervals J_i of length ≤ρ_i+η_i, choosing η_i>0 with Ση_iρ_i^s<ε. For each t∈I, the A_i with t∈J_i cover E, since each (x,t) belongs to a V_i and B_i⊆J_i. Thus c_s(E,δ)≤Σ1_{J_i}(t)ρ_i^s for every t. The indicators are measurable and nonnegative; M004 gives the integral of the sum as the sum of integrals. Integrating on I yields c_s(E,δ)≤Σ|J_i∩I|ρ_i^s≤Σρ_i^(s+1)+ε. Terms with ρ_i=0 vanish because s>0. Let ε↓0 and infimize over product covers to get c_s(E,δ)≤c_(s+1)(F,δ). Therefore H^(s+1)(F)=∞ and dim_H(F)≥s+1. Taking all 0<s<D gives dim_H(F)≥D+1.\\\",\\\"uses\\\":[\\\"M001\\\",\\\"M004\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"F\\\",\\\"D\\\",\\\"I\\\",\\\"s\\\",\\\"δ\\\",\\\"V_i\\\",\\\"ρ_i\\\",\\\"A_i\\\",\\\"B_i\\\",\\\"J_i\\\",\\\"η_i\\\",\\\"ε\\\",\\\"c_s\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]},{\\\"id\\\":\\\"S003\\\",\\\"text\\\":\\\"If D=0, choose x₀∈E using H001. The coordinate projection π:F→I is 1-Lipschitz for the stated Euclidean product distance and is onto because (x₀,t)∈F for every t. The interval has nonempty interior, so M003 with V=ℝ gives dim_H(I)=finrank(ℝ,ℝ)=1. Applying M002 to π gives 1=dim_H(I)≤dim_H(F)=D+1. This works also for n=0. Together with the upper bound this proves the equality.\\\",\\\"uses\\\":[\\\"H001\\\",\\\"M002\\\",\\\"M003\\\"],\\\"uses_local\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"F\\\",\\\"I\\\",\\\"x₀\\\",\\\"π\\\",\\\"D\\\",\\\"n\\\"],\\\"produces\\\":[],\\\"introduces\\\":[],\\\"discharges\\\":[]}],\\\"applications\\\":[{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S001\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"Use A=E, Euclidean Borel metric, and q>D to obtain zero q-Hausdorff measure.\\\"]},{\\\"input\\\":\\\"M001\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"Use A=E and 0<s<D to obtain infinite s-Hausdorff measure.\\\"]},{\\\"input\\\":\\\"M002\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"The coordinate projection has Lipschitz constant 1 for concatenated Euclidean distance.\\\"]},{\\\"input\\\":\\\"M003\\\",\\\"at\\\":\\\"S003\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"V=ℝ and I=[0,1], whose interior is nonempty; finrank(ℝ,ℝ)=1.\\\"]},{\\\"input\\\":\\\"M004\\\",\\\"at\\\":\\\"S002\\\",\\\"bindings\\\":{},\\\"hypothesis_checks\\\":[\\\"Use counting measure on I and summands ρ_i^s times indicators of open J_i; all are measurable nonnegative ENNReal functions.\\\"]}]}}\"}","status":"completed"}}

