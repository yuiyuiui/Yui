cts\\\":[\\\"dim_H\\\"],\\\"source\\\":{\\\"statement\\\":\\\"If d<dim_H(A), then H^d(A)=∞.\\\",\\\"hypotheses\\\":[\\\"A lies in a Borel extended metric space; d is NNReal.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M001-0001/library-sources.json\\\",\\\"sha256\\\":\\\"1e2974873151488a644ca1f93451e98bf2f2e911dba567adf7983fa7abfccdb1\\\"}],\\\"declaration\\\":\\\"hausdorffMeasure_of_lt_dimH\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.HausdorffDimension\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/Topology/MetricSpace/HausdorffDimension.lean\\\",\\\"source_sha256\\\":\\\"fdc61e7f179044cd714058f209b100e51b6f8af69aff295e3ee629ed45dcee31\\\",\\\"signature\\\":\\\"@hausdorffMeasure_of_lt_dimH.{u_1} : ∀ {X : Type u_1} [inst : EMetricSpace.{u_1} X] [inst_1 : MeasurableSpace.{u_1} X]\\\\n  [inst_2 :\\\\n    @BorelSpace.{u_1} X\\\\n      (@UniformSpace.toTopologicalSpace.{u_1} X\\\\n        (@PseudoEMetricSpace.toUniformSpace.{u_1} X (@EMetricSpace.toPseudoEMetricSpace.{u_1} X inst)))\\\\n      inst_1]\\\\n  {s : Set.{u_1} X} {d : NNReal},\\\\n  @LT.lt.{0} ENNReal (@Preorder.toLT.{0} ENNReal (@PartialOrder.toPreorder.{0} ENNReal ENNReal.instPartialOrder)) (↑d)\\\\n      (@dimH.{u_1} X inst s) →\\\\n    @Eq.{1} ENNReal\\\\n      (@DFunLike.coe.{u_1 + 1, u_1 + 1, 1} (@MeasureTheory.Measure.{u_1} X inst_1) (Set.{u_1} X) (fun x => ENNReal)\\\\n        (@MeasureTheory.Measure.instFunLike.{u_1} X inst_1)\\\\n        (@MeasureTheory.Measure.hausdorffMeasure.{u_1} X inst inst_2 ↑d) s)\\\\n      (@Top.top.{0} ENNReal ENNReal.instTop)\\\",\\\"declaration_kind\\\":\\\"theorem\\\"}},{\\\"id\\\":\\\"P\\\",\\\"kind\\\":\\\"target\\\",\\\"statement\\\":\\\"dim_H(E×I)=dim_H(E)+1.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\",\\\"dim_H\\\",\\\"I\\\"]}],\\\"inferences\\\":[]}}\"}","status":"completed"}}

