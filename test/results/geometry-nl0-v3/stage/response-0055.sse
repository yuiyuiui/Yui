_root\\\":\\\"controller-bound\\\"},\\\"inputs\\\":[]},\\\"graph\\\":{\\\"format_version\\\":2,\\\"case_id\\\":\\\"geometry-product-dimension\\\",\\\"spec_sha256\\\":\\\"controller-bound\\\",\\\"propositions\\\":[{\\\"id\\\":\\\"H001\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"E is nonempty.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\"]},{\\\"id\\\":\\\"H002\\\",\\\"kind\\\":\\\"hypothesis\\\",\\\"statement\\\":\\\"E is compact.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"E\\\"]},{\\\"id\\\":\\\"M001\\\",\\\"kind\\\":\\\"mathlib\\\",\\\"statement\\\":\\\"If d<dim_H(A), then H^d(A)=∞.\\\",\\\"definitions\\\":[],\\\"binders\\\":[],\\\"objects\\\":[\\\"dim_H\\\"],\\\"source\\\":{\\\"statement\\\":\\\"If d<dim_H(A), then H^d(A)=∞.\\\",\\\"hypotheses\\\":[\\\"A lies in a Borel extended metric space; d is NNReal.\\\"],\\\"evidence\\\":[{\\\"path\\\":\\\"library/M001-0001/library-sources.json\\\",\\\"sha256\\\":\\\"1e2974873151488a644ca1f93451e98bf2f2e911dba567adf7983fa7abfccdb1\\\"}],\\\"declaration\\\":\\\"hausdorffMeasure_of_lt_dimH\\\",\\\"module\\\":\\\"Mathlib.Topology.MetricSpace.HausdorffDimension\\\",\\\"mathlib_commit\\\":\\\"905b95818eb32af7874a58b427f50c1711a5e96c\\\",\\\"source_path\\\":\\\"Mathlib/Topology/MetricSpace/HausdorffDimension.lean\\\",\\\"source_sha256\\\":\\\"fdc61e7f179044cd714058f209b100e51b6f8af69aff295e3ee629ed45dcee31\\\",\\\"signature\\\":\\\"@hausdorffMeasure_of_lt_dimH.{u_1} : ∀ {X : Type u_1} [inst : EMetricSpace.{u_1} X] [inst_1 : MeasurableSpace.{u_1} X]\\\\n  [inst_2 :\\\\n    @BorelSpace.{u_1} X\\\\n      (@UniformSpace.toTopologicalSpace.{u_1} X\\\\n        (@PseudoEMetricSpace.toUniformSpace.{u_1} X (@EMetricSpace.toPseudoEMetricSpace.{u_1} X inst)))\\\\n      inst_1]\\\\n  {s : Set.{u_1} X} {d : NNReal},\\\\n  @LT.lt.{0} ENNReal (@Preorder.toLT.{0} ENNReal (@PartialOrder.toPreorder.{0} ENNReal ENNReal.instPartialOrder)) (↑d)\\\\n      (@dimH.{u_1} X inst s) →\\\\n    