    "format_version": 2,
    "case_id": "geometry-product-dimension",
    "full_target": "For every n∈ℕ and every nonempty compact E⊆ℝ^n, let I=[0,1] and equip E×I with the metric induced by concatenated Euclidean coordinates in ℝ^(n+1). Prove dim_H(E×I)=dim_H(E)+1.",
    "conclusion": "dim_H(E×I)=dim_H(E)+1.",
    "parameters": [
      {
        "symbol": "n",
        "type": "nonnegative integer"
      },
      {
        "symbol": "E",
        "type": "subset of Euclidean space ℝ^n"
      }
    ],
    "hypotheses": [
      {
        "id": "H001",
        "statement": "E is nonempty.",
        "origin": "frozen-target.md:7-9"
      },
      {
        "id": "H002",
        "statement": "E is compact.",
        "origin": "frozen-target.md:7-9"
      }
    ],
