        "negation_introduction"
      ],
      "calculations": [
        "Euclidean coordinate projections are 1-Lipschitz; products of sets have Euclidean diameter bounded by the square root of the sum of squared factor diameters; interval subdivisions and countable-sum inequalities used in the cover argument."
      ],
      "primitives": [
        {
          "symbol": "ℝ^n",
          "type": "Euclidean space of dimension n",
          "meaning": "The n-dimensional real inner-product space with its Euclidean metric; ℝ^0 is a singleton."
        },
        {
          "symbol": "dim_H",
          "type": "Hausdorff dimension of a subset of a metric space",
          "meaning": "Hausdorff dimension defined as the critical exponent of Hausdorff measures, with dim_H(∅)=0."
        },
        {
          "symbol": "I",
          "type": "subset of ℝ",
          "meaning": "The closed unit interval [0,1]."
        }
      ]
