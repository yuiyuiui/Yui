jects/-\",\"value\":\"Φ\"},{\"op\":\"add\",\"path\":\"/graph/inferences/2/argument/4/objects/-\",\"value\":\"μ\"},{\"op\":\"replace\",\"path\":\"/graph/inferences/3/argument/1/produces/0\",\"value\":{\"id\":\"F002\",\"statement\":\"There exist families q0,u0,η0 indexed by the chosen nonempty finite family g, a minimum κ0∈ℤ and an index jmin of g such that every q0_j is a nonzero rational, every u0_j is a unit of R, every η0_j is an integer, g_j=q0_j a=p^{η0_j}u0_j a, κ0≤η0_j for every j, and η0_jmin=κ0.\",\"binders\":[{\"symbol\":\"q0\",\"type\":\"family of nonzero rationals indexed by g\"},{\"symbol\":\"u0\",\"type\":\"family of units of R indexed by g\"},{\"symbol\":\"η0\",\"type\":\"family of integers indexed by g\"},{\"symbol\":\"κ0\",\"type\":\"integer\"},{\"symbol\":\"jmin\",\"type\":\"index of g\"}],\"objects\":[\"g\",\"a\",\"R\",\"p\",\"q0\",\"u0\",\"η0\",\"κ0\",\"jmin\"],\"assumptions\":[]}},{\"op\":\"add\",\"path\":\"/graph/inferences/3/locals/-\",\"value\":{\"symbol\":\"ν\",\"type\":\"integer\",\"scope\":\"minimum exponent\",\"start\":\"S003\",\"end\":\"S003\",\"kind\":\"witness\",\"declaration\":\"Choose the minimum exponent ν=κ0 furnished by F002 together with its families and minimizing index.\",\"from_inputs\":[],\"from_local\":[\"F002\"],\"objects\":[\"g\",\"p\"]}},{\"op\":\"add\",\"path\":\"/graph/inferences/3/locals/-\",\"value\":{\"symbol\":\"νexp\",\"type\":\"family of integers indexed by g\",\"scope\":\"minimum exponent\",\"start\":\"S003\",\"end\":\"S003\",\"kind\":\"witness\",\"declaration\":\"Choose the exponent family νexp from F002, simultaneously with ν,u,j_0; write its j-th entry as ν_j.\",\"from_inputs\":[],\"from_local\":[\"F002\"],\"objects\":[\"g\",\"p\"]}},{\"op\":\"add\",\"path\":\"/graph/inferences/3/locals/-\",\"value\":{\"symbol\":\"u\",\"type\":\"family of units of R indexed by g\",\"scope\":\"minimum exponent\",\"start\":\"S003\",\"end\":\"S003\",\"kind\":\"witness\",\"declaration\":\"Choose the family u of units from F002 simultaneously with ν,νexp,j_0.\",\"from_inputs\":[],\"from_local\":[\"F002\"],\"objects\":[\"g\",\"R\",\"p\"]}},{\"op\":\"add\",\"path\":\"/graph/inferences/3/locals/-\",\"value\":{\"symbol\":\"j_0\",\"type\":\"index of g\",\"scope\":\"minimum exponent\",\"start\":\"S003\",\"end\":\"S003\",\"kind\":\"witness\",\"declaration\":\"Choose the minimizing index j_0 from F002 simultaneously with ν,νexp,u, so ν_{j_0}=ν.\",\"from_inputs\":[],\"from_local\":[\"F002\"],\"objects\":[\"g\",\"p\"]}},{\"op\":\"add\",\"path\":\"/graph/inferences/3/locals/-\",\"value\":{\"symbol\":\"b\",\"type\":\"complex number\",\"scope\":\"principal generator\",\"start\":\"S003\",\"end\":\"S003\",\"kind\":\"definition\",\"declaration\":\"Define b=p^ν a.\",\"from_inputs\":[],\"from_local\":[],\"objects\":[\"p\",\"ν\",\"a\"]}},{\"op\":\"replace_text\",\"path\":\"/graph/inferences/3/argument/2/text\",\"old\":\"Using the notation quantified in F002, put b=p^ν a=u_{j_0}^{-1}g_{j_0}.\",\"new\":\"Choose simultaneously from F002 the exponent family νexp (entries ν_j), the unit family u, the minimum ν and an attaining index j_0. Put b=p^ν a=u_{j_0}^{-1}g_{j_0}.\"},{\"op\":\"replace\",\"path\":\"/graph/inferences/3/argument/2/objects\",\"value\":[\"a\",\"g\",\"J\",\"p\",\"R\",\"M_R\",\"e\",\"I\",\"n\",\"ν\",\"νexp\",\"u\",\"j_0\",\"b\"]},{\"op\":\"add\",\"path\":\"/graph/inferences/4/locals/-\",\"value\":{\"symbol\":\"A\",\"type\":\"K-linear map V(K)→M_R⊗_R K\",\"scope\":\"first tensor identification\",\"start\":\"S001\",\"end\":\"S004\",\"kind\":\"definition\",\"declaration\":\"Define A(m⊗c)=(1⊗m)⊗c by tensor balancing, as checked in S001.\",\"from_inputs\":[],\"from_local\":[],\"objects\":[\"M\",\"M_R\",\"R\",\"K\",\"V(K)\"]}},{\"op\":\"add\",\"path\":\"/graph/inferences/4/locals/-\",\"value\":{\"symbol\":\"B\",\"type\":\"K-linear map M_R⊗_R K→(M_R/pM_R)⊗_{ℱ_p}K\",\"scope\":\"quotient tensor identification\",\"start\":\"S002\",\"end\":\"S004\",\"kind\":\"definition\",\"declaration\":\"Define B(u⊗c)=[u]⊗c by