q := by rw [smul_smul, mul_comm]\\nletI : SMulCommClass (LR.R p) (ZMod p) K := ⟨by intro r z c; simp only [Algebra.smul_def]; ring⟩\\nletI : TensorProduct.CompatibleSMul (ZMod p) (LR.R p) K (LR.QMR p M) := ⟨by\\n  intro r c q\\n  obtain ⟨z,hk,hq⟩ := frac r\\n  rw [hk, hq, TensorProduct.smul_tmul]⟩\\nletI : TensorProduct.CompatibleSMul (LR.R p) (ZMod p) K (LR.QMR p M) := ⟨by\\n  intro z c q\\n  letI : Module (ZMod p) (K ⊗[LR.R p] LR.QMR p M) := Module.compHom _ (algebraMap (ZMod p) K)\\n  exact (ZMod.map_smul ((TensorProduct.mk (LR.R p) K (LR.QMR p M)).flip q).toAddMonoidHom z c).trans\\n    (ZMod.map_smul (TensorProduct.mk (LR.R p) K (LR.QMR p M) c).toAddMonoidHom z q).symm⟩\\nlet D := @TensorProduct.equivOfCompatibleSMul (ZMod p) inferInstance (LR.R p) K K (LR.QMR p M) inferInstance inferInstance (inferInstance : Module (ZMod p) K) mq inferInstance (inferInstance : Module (LR.R p) K) (inferInstance : Module (LR.R p) (LR.QMR p M)) inferInstance inferInstance (inferInstance : Module K K) inferInstance inferInstance inferInstance inferInstance\\nexact ⟨af, mq, D, fun c u => rfl⟩\"}","status":"completed"}}

