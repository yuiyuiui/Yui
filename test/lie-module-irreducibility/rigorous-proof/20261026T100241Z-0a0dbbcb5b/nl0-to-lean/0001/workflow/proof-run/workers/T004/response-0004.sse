48f183d753edb4c6f14e","name":"check_auxiliary","arguments":"{\"statement\":\"LR.e y v 0 = v ∧ (∀ i, y (LR.e y v i) = ((i+1 : ℕ) : ℂ) • LR.e y v (i+1)) ∧ (∀ i, 1 ≤ i → i ≤ lam.toNat → x (LR.e y v i) = ((lam.toNat-i+1 : ℕ):ℂ) • LR.e y v (i-1)) ∧ (∀ i, i ≤ lam.toNat → h (LR.e y v i) = (((lam:ℤ)-2*(i:ℤ):ℤ):ℂ) • LR.e y v i)\",\"proof\":\"have fac (i : ℕ) : (i.factorial : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero i\\nhave e0 : LR.e y v 0 = v := by simp [LR.e, LR.DP]\\nrefine ⟨e0, ?_, ?_, ?_⟩\\n· intro i\\n  simp only [LR.e, LR.DP, LinearMap.smul_apply, map_smul]\\n  rw [pow_succ', Module.End.mul_apply]\\n  rw [Nat.factorial_succ, Nat.cast_mul, smul_smul]\\n  congr 1\\n  have hi : ((i+1:ℕ):ℂ) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero i\\n  field_simp\\n· intro i hi hil\\n  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : i ≠ 0)\\n  simp only [LR.e, LR.DP, LinearMap.smul_apply, map_smul, h_T001.2, Nat.add_sub_cancel]\\n  have hl : (lam : ℂ) = (lam.toNat : ℂ) := by rw [← Int.cast_natCast, Int.toNat_of_nonneg h_H003.1]\\n  have hj : ((j+1:ℕ):ℂ) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero j\\n  have hsub : ((lam.toNat-(j+1)+1 : ℕ):ℂ) = (lam.toNat : ℂ) - j := by\\n    push_cast [Nat.cast_sub (show j+1 ≤ lam.toNat from hil)]\\n    ring\\n  simp only [Int.cast_mul, Int.cast_natCast, Int.cast_sub, Nat.factorial_succ, Nat.cast_mul, smul_smul]\\n  rw [hl, hsub]\\n  congr 1\\n  field_simp\\n  <;> ring\\n· intro i hi\\n  simp only [LR.e, LR.DP, LinearMap.smul_apply, map_smul, h_T001.1, smul_smul]\\n  congr 1\\n  ring\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"Search the pinned mathlib Lean source using a regular expression; at most 100 lines.","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"Read specified lines of a Mathlib/*.lean source file from the pinned checkout.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_transition","description":"Compile a tactic body for the fixed target; no leading by, declarations, or placeholders.","parameters":{"type":"object","properties":{"proof":{"type":"string"}},"required":["proof"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_transition","description":"Submit and check the final tactic body for the same target.","parameters":{"type":"object","properties":{"proof":{"type":"string"}},"required":["proof"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_auxiliary","description":"Compile one helper proposition and tactic body in exactly this local port context. This never accepts the final goal or adds a premise.","parameters":{"type":"object","properties":{"statement":{"type":"string"},"proof":{"type":"string"}},"required":["statement","proof"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_lean_draft","description":"Read only your own same-stage proof/helper attempts. kind=index lists attempts; proof/auxiliary returns the selected body lines and actual check. No other stage or file is accessible.","parameters":{"type":"object","properties":{"kind":{"type":"string","enum":["index","proof","auxiliary"]},"candidate":{"type":"integer"},"start":{"type":"integer"},"end":{"type":"integer"}},"required":["kind","candidate","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_background_note","description":"Read one complete audited background note from this task index by its qualified ID. No other task,