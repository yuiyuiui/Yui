 := (B.coord j).smulRight (B i)\\ndef Actions {F U : Type*} [Field F] [AddCommGroup U] [Module F U] (l : ℕ) (a : ℕ → U) (x y h : Module.End F U) (X Y : ℕ → Module.End F U) : Prop :=\\n x (a 0) = 0 ∧ (∀ i, 1 ≤ i → i ≤ l → x (a i) = ((l-i+1 : ℕ):F) • a (i-1)) ∧ (∀ i, i ≤ l → y (a i) = ((i+1:ℕ):F) • a (i+1)) ∧ (∀ i, i ≤ l → h (a i) = (((l:ℤ)-2*(i:ℤ):ℤ):F) • a i) ∧ (∀ r i, i ≤ l → X r (a i) = if r ≤ i then (((l-i+r).choose r : ℕ):F) • a (i-r) else 0) ∧ (∀ r i, i ≤ l → Y r (a i) = if i+r ≤ l then (((i+r).choose r : ℕ):F) • a (i+r) else 0)\\ndef IsStringBasis {V : Type*} [AddCommGroup V] [Module ℂ V] (l : ℕ) (y : Module.End ℂ V) (v : V) (B : Module.Basis (Idx l) ℂ V) : Prop := ∀ i, B i = e y v i.val\\nstructure IntegralOps {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) (x y h : Module.End ℂ V) where\\n xz : Module.End ℤ M\\n yz : Module.End ℤ M\\n hz : Module.End ℤ M\\n Xz : ℕ → Module.End ℤ M\\n Yz : ℕ → Module.End ℤ M\\n x_agree : ∀ m, (xz m : V) = x m\\n y_agree : ∀ m, (yz m : V) = y m\\n h_agree : ∀ m, (hz m : V) = h m\\n X_agree : ∀ r m, (Xz r m : V) = DP x r m\\n Y_agree : ∀ r m, (Yz r m : V) = DP y r m\\n brackets : Brackets xz yz hz\\nabbrev VK (K : Type*) [Field K] {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) := K ⊗[ℤ] M\\ndef Jc (p : ℕ) {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) (w : V) : Submodule (R p) ℂ := Submodule.span (R p) {c | c • w ∈ MR p M}\\ndef pMR (p : ℕ) {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) : Submodule (R p) (MR p M) := LinearMap.range ((p : R p) • (LinearMap.id : MR p M →ₗ[R p] MR p M))\\nabbrev QMR (p : ℕ) {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) := (MR p M) ⧸ (pMR p M)\\nsection Complex\\nvariable {V : Type*} [AddCommGroup V] [Module ℂ V]\\ndef Strings (lam : ℤ) (x y h : Module.End ℂ V) (v : V) : Prop :=\\n (∀ m : ℕ, h ((y^m) v) = ((lam-2*(m:ℤ):ℤ):ℂ) • ((y^m) v)) ∧ (∀ m : ℕ, x ((y^(m+1)) v) = ((((m+1:ℕ):ℤ)*(lam-(m:ℤ)):ℤ):ℂ) • ((y^m) v))\\ndef StringResult (lam : ℤ) (x y h : Module.End ℂ V) (v : V) : Prop :=\\n 0 < lam.toNat+1 ∧ Fintype.card (Idx lam.toNat) = lam.toNat+1 ∧ Strings lam x y h v ∧ e y v 0 = v ∧ (∃ B : Module.Basis (Idx lam.toNat) ℂ V, IsStringBasis lam.toNat y v B) ∧ (∀ m : ℕ, lam.toNat < m → (y^m) v = 0) ∧ Actions lam.toNat (e y v) x y h (DP x) (DP y)\\nstructure LatticeEmbedding (p l : ℕ) (M : Submodule ℤ V) where\\n basis : Module.Basis (Idx l) (R p) (MR p M)\\n tensorEquiv : (R p ⊗[ℤ] M) ≃ₗ[R p] MR p M\\n tensor_value : ∀ r m, (tensorEquiv (r ⊗ₜ[ℤ] m) : V) = (((r : R p) : ℚ) : ℂ) • (m : V)\\n complex_span : Submodule.span ℂ (MR p M : Set V) = ⊤\\ndef Preserves (p l : ℕ) (M : Submodule ℤ V) (x y h : Module.End ℂ V) : Prop :=\\n Nonempty (IntegralOps M x y h) ∧ (∀ r m, m ∈ MR p M → DP x r m ∈ MR p M) ∧ (∀ r m, m ∈ MR p M → DP y r m ∈ MR p M) ∧ (∀ t, t ≤ l → IsUnit (t.factorial : R p)) ∧ (∀ j, j ≤ l → IsUnit (l.choose j : R p))\\ndef MatrixControl (p l : ℕ) (M : Submodule ℤ V) (x y : Module.End ℂ V) (B : Module.Basis (Idx l) ℂ V) : Prop :=\\n (DP y l * DP x l = MU B ⟨l,Nat.lt_succ_self l⟩ ⟨l,Nat.lt_succ_self l⟩) ∧\\n (∀ i : Idx l, DP x (l-i.val) * MU B ⟨l,Nat.lt_succ_self l⟩ ⟨l,Nat.lt_succ_self l⟩ = MU B i ⟨l,Nat.lt_succ_self l⟩) ∧\\n (∀ j : Idx l, MU B ⟨l,Nat.lt_succ_self l⟩ ⟨l,Nat.lt_succ_self l⟩ * DP y (l-j.val) = ((l.choose j.val : ℕ):ℂ) • MU B ⟨l,Nat.lt_succ_self l⟩ j) ∧\\n (∀ i j : Idx l, MU B i j = (((l.choose j.val : ℕ):ℂ)⁻¹) • (DP x (l-i.val) * DP y l * DP x l * DP y (l-j.val))) ∧\\n (∀ i j : Idx l, ∀ m, m ∈ MR p M → MU B i j m ∈ MR p M)\\ndef LocalResult (p l : ℕ) (M : Submodule ℤ V) (x y h : Module.End ℂ V) (B : Module.Basis (Idx l) ℂ V) : Prop := Nonempty (LatticeEmbedding p l M) ∧ Preserves p l M x y h ∧ MatrixControl p l M x y B\\nstructure Decomposition (p l : ℕ) (M : Submodule ℤ V) (v : V) (B : Module.Basis (Idx l) ℂ V) where\\n exact_J : ∀ c : ℂ, c ∈ Jc p M v ↔ c • v ∈ MR p M\\n exact_coord : ∀ i : Idx l, ∀ c : ℂ, c ∈ Jc p M (B i) ↔ c • B i ∈ MR p M\\n common : ∀ i : Idx l, Jc p M (B i) = Jc p M v\\n fg : (Jc p M v).FG\\n nonzero : Jc p M v ≠ ⊥\\n coordEquiv : (Idx l → Jc p M v) ≃ₗ[R p] MR p M\\n coord_value : ∀ c, (coordEquiv c : V) = ∑ i, (c i : ℂ) • B i\\nabbrev T (p : ℕ) (M : Submodule ℤ V) (v : V) := ℚ ⊗[R p] Jc p M v\\ndef RationalEmbedding (p : ℕ) (M : Submodule ℤ V) (v : V) : Prop :=\\n ∃ mu : T p M v →ₗ[ℚ] ℂ, (∀ q c, mu (q ⊗ₜ[R p] c) = (q : ℂ) * (c : ℂ)) ∧ Function.Injective mu ∧ Module.Finite ℚ (T p M v)\\ndef CoordinateResult (p l : ℕ) (M : Submodule ℤ V) (v : V) (B : Module.Basis (Idx l) ℂ V) : Prop :=\\n 0 < l+1 ∧ Nonempty (Decomposition p l M v B) ∧ RationalEmbedding p M v ∧ Module.finrank ℚ (T p M v) = 1 ∧ (∀ a c : ℂ, a ∈ Jc p M v → a ≠ 0 → c ∈ Jc p M v → ∃ q : ℚ, c = (q : ℂ) * a)\\ndef PrincipalResult (p l : ℕ) (M : Submodule ℤ V) (v : V) (B : Module.Basis (Idx l) ℂ V) : Prop :=\\n (∃ b : ℂ, b ∈ Jc p M v ∧ b ≠ 0 ∧ Jc p M v = Submodule.span (R p) {b}) ∧ (∀ b : ℂ, b ∈ Jc p M v → b ≠ 0 → Jc p M v = Submodule.span (R p) {b} → ∃ f : Module.Basis (Idx l) (R p) (MR p M), ∀ i, (f i : V) = b • B i) ∧ 0 < l+1 ∧ Fintype.card (Idx l) = l+1\\nstructure FirstChange (p : ℕ) (K : Type*) [Field K] (M : Submodule ℤ V) where\\n [ak : Algebra (R p) K]\\n rho_value : ∀ a b : ℤ, ∀ r : R p, (r : ℚ) = (a : ℚ)/(b : ℚ) → ¬ (p : ℤ) ∣ b → algebraMap (R p) K r = (a : K)/(b : K)\\n inc : M →ₗ[ℤ] MR p M\\n inc_value : ∀ m, (inc m : V) = (m : V)\\n A : VK K M ≃ₗ[K] (K ⊗[R p] MR p M)\\n A_value : ∀ c m, A (c ⊗ₜ[ℤ] m) = c ⊗ₜ[R p] inc m\\nstructure ScalarData (p : ℕ) (K : Type*) [Field K] (M : Submodule ℤ V) extends FirstChange p K M where\\n [af : Algebra (ZMod p) K]\\n [mq : Module (ZMod p) (QMR p M)]\\n residue : (R p ⧸ Ideal.span {(p : R p)}) ≃+* ZMod p\\n residue_value : ∀ a b : ℤ, ∀ r : R p, (r : ℚ) = (a : ℚ)/(b : ℚ) → ¬ (p : ℤ) ∣ b → residue (Ideal.Quotient.mk _ r) = (a : ZMod p) * (b : ZMod p)⁻¹\\n C : (K ⊗[R p] MR p M) ≃ₗ[K] (K ⊗[ZMod p] QMR p M)\\n C_value : ∀ c u, C (c ⊗ₜ[R p] u) = c ⊗ₜ[ZMod p] (pMR p M).mkQ u\\nstructure ReducedBasis (p : ℕ) (K : Type*) [Field K] (l : ℕ) (M : Submodule ℤ V) (v : V) (B : Module.Basis (Idx l) ℂ V) where\\n scalars : ScalarData p K M\\n b : ℂ\\n b_mem : b ∈ Jc p M v\\n b_ne : b ≠ 0\\n principal : Jc p M v = Submodule.span (R p) {b}\\n f : Module.Basis (Idx l) (R p) (MR p M)\\n f_value : ∀ i, (f i : V) = b • B i\\n beta : Module.Basis (Idx l) K (VK K M)\\n transported : letI := scalars.ak; ∀ i, scalars.A (beta i) = (1 : K) ⊗ₜ[R p] f i\\n quotient_basis : letI := scalars.mq; ∃ gamma : Module.Basis (Idx l) (ZMod p) (QMR p M), ∀ i, gamma i = (pMR p M).mkQ (f i)\\n dimension : Module.finrank K (VK K M) = l+1\\n positive : 0 < l+1\\n cardinality : Fintype.card (Idx l) = l+1\\ndef ReducedAction (K : Type*) [Field K] (l : ℕ) (M : Submodule ℤ V) (x y h : Module.End ℂ V) (o : IntegralOps M x y h) (beta : Module.Basis (Idx l) K (VK K M)) : Prop :=\\n Brackets (o.xz.baseChange K) (o.yz.baseChange K) (o.hz.baseChange K) ∧ Actions l (ext beta) (o.xz.baseChange K) (o.yz.baseChange K) (o.hz.baseChange K) (fun r => (o.Xz r).baseChange K) (fun r => (o.Yz r).baseChange K) ∧ (∀ r, r ≤ l → (r.factorial : K) ≠ 0 ∧ (o.Xz r).baseChange K = (r.factorial : K)⁻¹ • (o.xz.baseChange K)^r ∧ (o.Yz r).baseChange K = (r.factorial : K)⁻¹ • (o.yz.baseChange K)^r)\\ndef ReducedControl (K : Type*) [Field K] (l : ℕ) (M : Submodule ℤ V) (x y h : Module.End ℂ V) (o : IntegralOps M x y h) (beta : Module.Basis (Idx l) K (VK K M)) : Prop :=\\n (∀ i j : Idx l, MU beta i j = (((l.choose j.val : ℕ):K)⁻¹) • ((o.Xz (l-i.val)).baseChange K * (o.Yz l).baseChange K * (o.Xz l).baseChange K * (o.Yz (l-j.val)).baseChange K)) ∧ (∀ W : Submodule K (VK K M), Inv W (o.xz.baseChange K) → Inv W (o.yz.baseChange K) → ∀ i j, Inv W (MU beta i j))\\ndef ReductionResult (p : ℕ) (K : Type*) [Field K] (l : ℕ) (M : Submodule ℤ V) (x y h : Module.End ℂ V) (v : V) (B : Module.Basis (Idx l) ℂ V) : Prop :=\\n ∃ rb : ReducedBasis p K l M v B, ∃ o : IntegralOps M x y h, ReducedAction K l M x y h o rb.beta ∧ ReducedControl K l M x y h o rb.beta\\nend Complex\\nend LR\"},{\"op\":\"replace\",\"path\":\"/parameters/1/type\",\"value\":\"Type*\"},{\"op\":\"replace\",\"path\":\"/parameters/4/type\",\"value\":\"Type*\"},{\"op\":\"replace\",\"path\":\"/steps/6/explanation\",\"value\":\"Restrict the divided powers to M and extend preservation to its R-span. Restrict h=[x,y]; the three integral brackets follow by inclusion into V, and are recorded in IntegralOps. Prime-to-p factorials and the binomial-factorial identity give all required units in R.\"},{\"op\":\"replace\",\"path\":\"/endpoint_correspondence/P/explanation\",\"value\":\"Parameters range over every prime p, field K of characteristic p, integer lam in [0,p), complex module, highest-weight vector, and arbitrary admissible lattice. The x,y,h endomorphisms are the action of the Chevalley generators: their brackets present sl2(C), so a triple satisfying these relations defines the original action, and conversely any original action gives this triple. Common invariant subspaces express complex irreducibility; H004 retains dimension and H005 the highest weight. A Z-submodule is exactly an additive subgroup. Under H004 its simultaneous integer/complex basis can be reindexed by Fin(l+1), so H006 is equivalent to the original lattice assumption; stability under the divided-power generators is equivalent to U_Z-stability. With 0≤lam, l=lam.toNat equals lam. Tensor flip identifies K tensor_Z M with M tensor_Z K in both directions and intertwines the induced operators. IntegralOps records restrictions agreeing on every lattice element and the inherited brackets: these restrictions are unique, and their existence/brackets follow from admissibility and H004, not extra premises. Thus the existential witness is the actual induced action. Nontrivial means nonzero; bottom/top mean zero/the whole space. Generator invariance is exactly invariance under their K-linear span L(K), also for p=2. The quantifiers include lam=0 and arbitrary, not necessarily algebraically closed, K.\"}]}}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read one declared frozen document. For JSON use pointer (empty string lists the root); large objects return keys, and strings resume with offset=next_offset. For text use inclusive start/end lines and column=next_column when continuing a long line. Every serialized result is at most 32 KiB. Follow has_more and the returned continuation coordinates; no arbitrary local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"},"column":{"type":"integer"},"pointer":{"type":"string"},"offset":{"type":"integer"},"limit":{"type":"integer"}},"required":["id"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"},"column":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Report an actual obstacle using these five direct fields. Countercheck the alleged implication against the complete definitions, quantifiers and inequality directions; a feasible example alone does not determine an extremum. A fact not yet proved or registered in the current draft is an obligation to complete, not by itself a gap. For a mathematical stop, identify the concrete implication and actual mathematical difficulty encountered during normal checking/completion, not merely unfilled inventory or exposition. No fixed time/attempt count or counterexample is required. SUBSTANTIVE_GAP/SUSPECTED_GAP stop for an actual supported mathematical obstruction; SOURCE_UNAVAILABLE/INPUT_CONFLICT stop for an actual access/input obstacle. Ordinary unfinished work is not an obstacle report. No mathematical acceptance is generated.","parameters":{"type":"object","properties":{"status":{"type":"string","enum":["SUBSTANTIVE_GAP","SUSPECTED_GAP","SOURCE_UNAVAILABLE","INPUT_CONFLICT"]},"location":{"type":"string"},"explanation":{"type":"string"},"basis":{"type":"string"},"partial_progress":{"type":"string"}},"required":["status","location","explanation","basis","partial_progress"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_draft","description":"Preferred structured-object form of check_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_draft","description":"Preferred structured-object form of submit_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"save_interface_draft","description":"Save incomplete own-stage interface JSON without accepting it or invoking Lean. Later revise via base_candidate.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_interface_draft","description":"Read only own current-stage typed candidates or partial type probes; index lists them. No other stage files are accessible.","parameters":{"type":"object","properties":{"kind":{"type":"string","enum":["index","candidate","probe"]},"candidate":{"type":"integer"},"pointer":{"type":"string"}},"required":["kind","candidate","pointer"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_lean_types","description":"Compile a partial mathematical definition header and selected Lean type or ordinary API term expressions with explicit parameters. Never accepts a final interface or adds a proved premise.","parameters":{"type":"object","properties":{"header":{"type":"string"},"parameters":{"type":"array","items":{"type":"object"}},"types":{"type":"array","items":{"type":"string"}}},"required":["header","parameters","types"],"additionalProperties":false},"output_schema":null,"strict":false}],"tool_choice":"aut