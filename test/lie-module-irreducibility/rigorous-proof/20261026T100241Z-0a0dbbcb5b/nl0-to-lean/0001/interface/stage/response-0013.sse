F U := (B.coord j).smulRight (B i)\\ndef Actions {F U : Type*} [Field F] [AddCommGroup U] [Module F U] (l : ℕ) (a : ℕ → U) (x y h : Module.End F U) (X Y : ℕ → Module.End F U) : Prop :=\\n x (a 0) = 0 ∧ (∀ i, 1 ≤ i → i ≤ l → x (a i) = ((l-i+1 : ℕ):F) • a (i-1)) ∧ (∀ i, i ≤ l → y (a i) = ((i+1:ℕ):F) • a (i+1)) ∧ (∀ i, i ≤ l → h (a i) = (((l:ℤ)-2*(i:ℤ):ℤ):F) • a i) ∧ (∀ r i, i ≤ l → X r (a i) = if r ≤ i then (((l-i+r).choose r : ℕ):F) • a (i-r) else 0) ∧ (∀ r i, i ≤ l → Y r (a i) = if i+r ≤ l then (((i+r).choose r : ℕ):F) • a (i+r) else 0)\\ndef IsStringBasis {V : Type*} [AddCommGroup V] [Module ℂ V] (l : ℕ) (y : Module.End ℂ V) (v : V) (B : Module.Basis (Idx l) ℂ V) : Prop := ∀ i, B i = e y v i.val\\nstructure IntegralOps {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) (x y h : Module.End ℂ V) where\\n xz : Module.End ℤ M\\n yz : Module.End ℤ M\\n hz : Module.End ℤ M\\n Xz : ℕ → Module.End ℤ M\\n Yz : ℕ → Module.End ℤ M\\n x_agree : ∀ m, (xz m : V) = x m\\n y_agree : ∀ m, (yz m : V) = y m\\n h_agree : ∀ m, (hz m : V) = h m\\n X_agree : ∀ r m, (Xz r m : V) = DP x r m\\n Y_agree : ∀ r m, (Yz r m : V) = DP y r m\\nabbrev VK (K : Type*) [Field K] {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) := K ⊗[ℤ] M\\ndef Jc (p : ℕ) {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) (w : V) : Submodule (R p) ℂ := Submodule.span (R p) {c | c • w ∈ MR p M}\\ndef pMR (p : ℕ) {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) : Submodule (R p) (MR p M) := LinearMap.range ((p : R p) • (LinearMap.id : MR p M →ₗ[R p] MR p M))\\nabbrev QMR (p : ℕ) {V : Type*} [AddCommGroup V] [Module ℂ V] (M : Submodule ℤ V) := (MR p M) ⧸ (pMR p M)\\nend LR\",\"parameters\":[{\"name\":\"p\",\"type\":\"ℕ\"},{\"name\":\"K\",\"type\":\"Type\"},{\"name\":\"instK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"lam\",\"type\":\"ℤ\"},{\"name\":\"V\",\"type\":\"Type\"},{\"name\":\"instV\",\"type\":\"AddCommGroup V\",\"binder_kind\":\"instance\"},{\"name\":\"instCV\",\"type\":\"Module ℂ V\",\"binder_kind\":\"instance\"},{\"name\":\"x\",\"type\":\"Module.End ℂ V\"},{\"name\":\"y\",\"type\":\"Module.End ℂ V\"},{\"name\":\"h\",\"type\":\"Module.End ℂ V\"},{\"name\":\"v\",\"type\":\"V\"},{\"name\":\"M\",\"type\":\"Submodule ℤ V\"}],\"types\":[\"LR.QMR p M\",\"∀ o : LR.IntegralOps M x y h, LR.Brackets (o.xz.baseChange K) (o.yz.baseChange K) (o.hz.baseChange K)\",\"Nontrivial (LR.VK K M) ∧ ∃ o : LR.IntegralOps M x y h, ∀ W : Submodule K (LR.VK K M), LR.Inv W (o.xz.baseChange K) → LR.Inv W (o.yz.baseChange K) → LR.Inv W (o.hz.baseChange K) → W = ⊥ ∨ W = ⊤\"]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read one declared frozen document. For JSON use pointer (empty string lists the root); large objects return keys, and strings resume with offset=next_offset. For text use inclusive start/end lines and column=next_column when continuing a long line. Every serialized result is at most 32 KiB. Follow has_more and the returned continuation coordinates; no arbitrary local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"},"column":{"type":"integer"},"pointer":{"type":"string"},"offset":{"type":"integer"},"limit":{"type":"integer"}},"required":["id"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"},"column":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Report an actual obstacle using these five direct fields. Countercheck the alleged implication against the complete definitions, quantifiers and inequality directions; a feasible example alone does not determine an extremum. A fact not yet proved or registered in the current draft is an obligation to complete, not by itself a gap. For a mathematical stop, identify the concrete implication and actual mathematical difficulty encountered during normal checking/completion, not merely unfilled inventory or exposition. No fixed time/attempt count or counterexample is required. SUBSTANTIVE_GAP/SUSPECTED_GAP stop for an actual supported mathematical obstruction; SOURCE_UNAVAILABLE/INPUT_CONFLICT stop for an actual access/input obstacle. Ordinary unfinished work is not an obstacle report. No mathematical acceptance is generated.","parameters":{"type":"object","properti