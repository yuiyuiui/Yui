operties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_lean_types","description":"Compile a partial mathematical definition header and selected Lean type or ordinary API term expressions with explicit parameters. Never accepts a final interface or adds a proved premise.","parameters":{"type":"object","properties":{"header":{"type":"string"},"parameters":{"type":"array","items":{"type":"object"}},"types":{"type":"array","items":{"type":"string"}}},"required":["header","parameters","types"],"additionalProperties":false},"output_schema":null,"strict":false}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"0594beb8-83f0-4a1b-b896-6e25b76a34a8","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"high","context":"all_turns","summary":null,"mode":"standard"},"user":null,"usage":{"input_tokens":30801,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":4650,"output_tokens_details":{"reasoning_tokens":2984},"total_tokens":35451,"attribution":{"items":{"fc_03d475638b3efdb5016adf25ab69b88191b9f35f1802467bd4":{"input_tokens":27,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_03d475638b3efdb5016adf25aed1748191b978817a3ac81174":{"input_tokens":30,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_03d475638b3efdb5016adf25b24c108191ae77df107ee83217":{"input_tokens":26,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_03d475638b3efdb5016adf25b76840819196ed3ade96645b5d":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_03d475638b3efdb5016adf25bc978c8191a5bbc8b63a90911d":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_03d475638b3efdb5016adf25c0679481919a0a0b1ea8979b25":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_03d475638b3efdb5016adf25c3f9f8819180496d979ca