+
+    def test_a_new_model_event_cannot_reassign_an_already_completed_tool_id(self):
+        t=self.trial();t.tool_names={'neutral'};t.model_history={}
+        t.model_calls={'call':{'name':'neutral','arguments':'{"x":1}'}}
