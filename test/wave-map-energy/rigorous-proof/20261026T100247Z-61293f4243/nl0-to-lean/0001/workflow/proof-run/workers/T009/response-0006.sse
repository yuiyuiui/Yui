ner ℝ (WM.ut u (x,t)) (WM.xu u j (x,t))) x (Pi.single j 1) = _\\nrw [hp]\\nsimp only [WM.bTerm, WM.cTerm, WM.dx]\\nrw [real_inner_comm (fderiv ℝ (fun y => WM.ut u (y,t)) x (Pi.single j 1)), add_comm]\"}","status":"completed"}}

