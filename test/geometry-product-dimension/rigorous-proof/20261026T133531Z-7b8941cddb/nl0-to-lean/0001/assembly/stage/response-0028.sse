ED_GAP","SOURCE_UNAVAILABLE","INPUT_CONFLICT"]},"location":{"type":"string"},"explanation":{"type":"string"},"basis":{"type":"string"},"partial_progress":{"type":"string"}},"required":["status","location","explanation","basis","partial_progress"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_draft","description":"Preferred structured-object form of check_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_draft","description":"Preferred structured-object form of submit_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_assembly_feedback","description":"Read only this author stage's saved candidate, generated proof or full native diagnostics. Positive candidate ID; inclusive line bounds. No other case or arbitrary path is accessible.","parameters":{"type":"object","properties":{"candidate":{"type":"integer"},"kind":{"type":"string","enum":["mapping","feedback","proof_source","audit_source","assembly_inputs","mechanical","assembly","inspection","compiler_stdout","compiler_stderr","assembly_stdout","assembly_stderr"]},"start":{"type":"integer"},"end":{"type":"integer"},"column":{"type":"integer"}},"required":["candidate","kind","start","end"],"additionalProperties":false},"output_schema":null,"strict":false}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"18eb4aa1-cce3-4496-af80-4497fb53550c","promp