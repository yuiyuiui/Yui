@Real.div_rpow : ∀ {x y : ℝ},
  LE.le.{0} 0 x →
    LE.le.{0} 0 y →
      ∀ (z : ℝ),
        Eq.{1} (HPow.hPow.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} x y) z)
          (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} x z) (HPow.hPow.{0, 0, 0} y z))
