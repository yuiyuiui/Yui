RESOLVED_NAME:M111:MeasureTheory.setLIntegral_mono'
RESOLVED_MODULE:M111:Mathlib.MeasureTheory.Integral.Lebesgue.Basic
BEGIN_SIGNATURE:M111
@MeasureTheory.setLIntegral_mono' : ∀ {α : Type u_1} {m : MeasurableSpace.{u_1} α} {μ : MeasureTheory.Measure.{u_1} α} {s : Set.{u_1} α}
  {f g : α → ENNReal},
  MeasurableSet.{u_1} s →
    (∀ (x : α), Membership.mem.{u_1, u_1} s x → LE.le.{0} (f x) (g x)) →
      LE.le.{0} (∫⁻ (x : α) in s, f x ∂μ) (∫⁻ (x : α) in s, g x ∂μ)
BEGIN_AXIOMS:M111
'MeasureTheory.setLIntegral_mono'' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
